---
// File: src/layouts/Site.astro
const {
  title = "Fernie Real Estate",
  seo_title = title,
  seo_description = "",
  summary = "",
  showHeader = true,
  class: bodyClass = "",
  wrapContent = false, // default to no card wrapper
  heroPreload = null as null | {
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
    as?: "image";
    type?: string;
    crossorigin?: "" | "anonymous" | "use-credentials";
  },
  containerMax = 1280, // allows per-page overrides if needed
} = Astro.props;

import { ViewTransitions } from "astro:transitions";
import { getJson } from "../lib/fetchJson";
import Footer from "../components/Footer.astro";
import HomeMatchChatWidget from "../components/HomeMatchChatWidget.astro";

import "../styles/building-detail.css"; // contains both buildings index + building detail shared rules
// import "../styles/realtyvis.css";
// import "../styles/realtyvis.css";

/* helpers */
const RESERVED = new Set(["index", "page", "pages", "all", "view", "list"]);
const getField = (r: any, k: string) =>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "")
    .toString()
    .trim();

const visible = (r: any) => {
  const s = getField(r, "status").toLowerCase();
  const rawSlug = getField(r, "slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
};

type MenuItem = { title: string; slug: string; sort: number };

async function fetchMenuSafe(url?: string): Promise<MenuItem[]> {
  if (!url) return [];
  try {
    new URL(url, "http://x");
  } catch {
    return [];
  }
  try {
    const raw = await getJson<any>(url);
    const rows: any[] =
      Array.isArray(raw) ? raw :
      Array.isArray(raw?.data) ? raw.data :
      Array.isArray(raw?.rows) ? raw.rows : [];

    const out: MenuItem[] = [];
    for (const r of rows) {
      if (!visible(r)) continue;
      const title = getField(r, "title");
      const slug = getField(r, "slug");
      if (!title || !slug) continue;
      const sort = Number.isFinite(+r?.sort) ? +r.sort : Number.MAX_SAFE_INTEGER;
      out.push({ title, slug, sort });
    }
    out.sort((a, b) => (a.sort - b.sort) || a.title.localeCompare(b.title));
    return out;
  } catch {
    return [];
  }
}

/* Clean meta description from Sheets (may contain HTML) */
const stripMeta = (s: string = "") =>
  s.replace(/<[^>]+>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const metaDescription =
  stripMeta((seo_description || summary || "").toString()) ||
  "Fernie real estate, activities, neighbourhoods, and local insights.";

/* active path helper */
const pathname = Astro.url.pathname;
const isActive = (p: string) => pathname === p || pathname.startsWith(p + "/");
---

<html lang="en">
  <head>
    <ViewTransitions />

 <!-- Favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/img/android-chrome-192.png">

<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">


    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FQ1LMJR15W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-FQ1LMJR15W", {
        anonymize_ip: true,
        send_page_view: true
      });
    </script>

    <!-- Astro page-change tracking -->
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        if (typeof gtag === "function") {
          gtag("event", "page_view", {
            page_path: location.pathname,
            page_title: document.title
          });
        }
      });
    </script>

    <!-- CRITICAL PRECONNECTS -->
    <link rel="preconnect" href="https://chriscrump.realtyvis.page" crossorigin />
    <link rel="preconnect" href="https://app.realtyvis.com" crossorigin />
    <link rel="preconnect" href="https://cdn.realtyvis.com" crossorigin />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo_title}</title>
    <meta name="description" content={metaDescription} />

    <!-- dns-prefetch -->
    <link rel="dns-prefetch" href="https://cdn.realtyvis.com" />
    <link rel="dns-prefetch" href="https://api.realtyvis.com" />
    <link rel="dns-prefetch" href="https://app.realtyvis.com" />

    {heroPreload && (
      <link
        rel="preload"
        as={heroPreload.as ?? "image"}
        href={heroPreload.href}
        imagesrcset={heroPreload.imagesrcset}
        imagesizes={heroPreload.imagesizes ?? "100vw"}
        type={heroPreload.type}
        crossorigin={heroPreload.crossorigin ?? "anonymous"}
        fetchpriority="high"
      />
    )}

    <!-- ✅ RealtyVis embed (loads once) -->
    <script src="https://cdn.realtyvis.com/js/embed.js" defer></script>


    <!-- GLOBAL -->
    <style is:global>
      :root {
        --header-h: 52px;
        --edge-pad: 12px;
        --edge-pad-lg: 30px;
        --container-max: 1280px;
        --bg: #ffffff;
        --ink: #271f11;
        --ink-muted: #1f2937;
        --hover-bg: rgba(243, 244, 246, .9);
        --ease-snap: cubic-bezier(0.22, 1, 0.36, 1);

        --h1-size: 1.9rem;
        --h1-line: 1.15;

        --h2-size: 1.45rem;
        --h2-line: 1.25;

        --h3-size: 1.2rem;
        --h3-line: 1.35;

        --body-size: 1rem;
        --body-line: 1.6;

        --small-size: 0.9rem;
        --h1-track: -0.02em;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { height: 100%; overflow-x: clip; margin: 0; }

      body {
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-size: var(--body-size);
        line-height: var(--body-line);
      }

      h1,
      .page-title,
      .hero-bleed__title {
        font-size: var(--h1-size);
        line-height: var(--h1-line);
        letter-spacing: var(--h1-track);
        font-weight: 600;
        margin: 0 0 0.6rem;
      }

      h2 {
        font-size: var(--h2-size);
        line-height: var(--h2-line);
        margin-top: 2.5rem;
        margin-bottom: -0.1rem;
        font-weight: 500;
      }

      body.home .summary-wrap { margin-top: 0.4rem; }
      body.home .summary-wrap h2 {
        margin-top: 0 !important;
        margin-bottom: 0.45rem;
        font-size: calc(var(--h2-size) * 1.22);
        line-height: 1.25;
      }

      h3 {
        font-size: var(--h3-size);
        line-height: var(--h3-line);
        margin-top: 2rem;
        margin-bottom: -0.1rem;
        font-weight: 500;
      }

      h2 + p,
      h3 + p,
      h2 + ul,
      h3 + ul {
        margin-top: 0.25rem !important;
      }

      p { margin: 0 0 1rem; }

      .page-subhead {
        font-size: var(--h3-size);
        line-height: 1.4;
        opacity: 0.8;
        margin: 0 0 0.4rem;
      }

      .summary-text { max-width: 52rem; }

      strong {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.4;
      }

      .page-header {
        max-width: 52rem;
        margin: 1.1rem auto 1.8rem;
      }

      .page-header .page-title { margin-bottom: 0.35rem; }
      .page-header .page-subhead { margin-bottom: 0.3rem; }
      .page-header .summary-text { margin-top: 0.35rem; margin-bottom: 0.9rem; }

      .below-fold > .page-header:first-child,
      .below-fold > section:first-child,
      .below-fold > div:first-child {
        margin-top: 1.1rem;
      }

      .longcopy, .long-copy {
        max-width: 52rem;
        margin: 0 auto 2.6rem;
      }
      .longcopy p, .long-copy p { margin-bottom: 0.95rem; }

      .longcopy ul,
      .long-copy ul,
      .longcopy ol,
      .long-copy ol,
      .long-copy blockquote,
      .longcopy figure,
      .long-copy figure,
      .long-copy .cta-block,
      .long-copy .note {
        margin-top: 1.4rem;
        margin-bottom: 1.4rem;
      }

      main { padding-top: calc(var(--header-h) - 20px); }

      header[role="banner"] {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: var(--header-h);
        background: rgba(255, 255, 255, .96);
        backdrop-filter: blur(10px);
        z-index: 1000;
        border: 0 !important;
        border-bottom: 0 !important;
        box-shadow: none !important;
        transition:
          background-color .35s ease,
          box-shadow .35s ease,
          backdrop-filter .35s ease;
      }

      header[role="banner"].scrolled {
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 2px 12px rgba(0, 0, 0, .07);
        backdrop-filter: blur(10px);
      }

      .nav-inner {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        height: 100%;
        padding-inline: var(--edge-pad);
      }
      @media (min-width: 900px) {
        .nav-inner { padding-inline: var(--edge-pad-lg); }
      }

      .brand {
        justify-self: start;
        font-weight: 700;
        font-size: 1rem;
        color: var(--ink);
        text-decoration: none;
        padding: 4px 6px;
        border-radius: 6px;
        white-space: nowrap;
        transition:
          background-color .2s ease,
          transform .18s ease;
      }
      .brand:hover {
        background: var(--hover-bg);
        transform: translateY(-1px);
      }

      nav {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto;
      }

      .navlink {
        color: var(--ink-muted);
        padding: 6px 8px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        transition:
          color .22s ease,
          opacity .22s ease,
          transform .18s ease,
          background-color .22s ease;
      }
      .navlink:hover,
      .navlink:focus-visible,
      .navlink.active {
        color: var(--ink);
      }

      @media (min-width: 1025px) {
        .navlink {
          position: relative;
          padding: 8px 10px 14px;
          opacity: 0.75;
          white-space: nowrap;
        }
      }

      .navlink::after {
        content: "";
        position: absolute;
        left: 8px;
        right: 8px;
        bottom: 4px;
        height: 2px;
        background: #0f172a;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform .18s ease;
        border-radius: 2px;
        opacity: .95;
      }

      .navlink:hover,
      .navlink:focus-visible {
        opacity: 1;
        transform: translateY(-1px);
        background: var(--hover-bg);
      }

      .navlink.active { opacity: 1; }

      .navlink:hover::after,
      .navlink:focus-visible::after,
      .navlink.active::after {
        transform: scaleX(1);
      }

      body.nav-open { overflow: hidden; padding-right: var(--sbw, 0px); }
      body.nav-open header, body.nav-open .nav-overlay, body.nav-open header nav { right: var(--sbw, 0px); }

      .hamburger { display: none; }
      @media (max-width:1024px) {
        .hamburger {
          display: block;
          margin-left: auto;
          padding: 6px 8px;
          border-radius: 10px;
          border: 1px solid transparent;
          background: transparent;
          color: var(--ink);
          -webkit-tap-highlight-color: transparent;
          transition:
            background-color .2s ease,
            transform .18s ease,
            box-shadow .2s ease;
        }
        .hamburger:active { transform: scale(0.98); }
        .hamburger:hover {
          background: var(--hover-bg);
          box-shadow: 0 2px 6px rgba(0,0,0,.08);
        }
        .hamburger:focus-visible {
          outline: none;
          border-color: #e5e7eb;
          background: var(--hover-bg);
        }

        .navlink::before,
        .navlink::after { content: none !important; }

        header nav {
          position: fixed;
          top: var(--header-h);
          left: 0;
          right: 0;
          background: rgba(255,255,255,.98);
          -webkit-backdrop-filter: blur(10px);
          backdrop-filter: blur(10px);
          flex-direction: column;
          gap: 0;
          padding:
            max(6px, env(safe-area-inset-top))
            max(var(--edge-pad), env(safe-area-inset-right))
            max(10px, env(safe-area-inset-bottom))
            max(var(--edge-pad), env(safe-area-inset-left));
          border-top: 1px solid #e5e7eb;
          box-shadow: 0 6px 18px rgba(0,0,0,.08);
          z-index: 1001;
          transform: translateY(-6px);
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transition:
            transform 180ms var(--ease-snap),
            opacity 180ms var(--ease-snap),
            visibility 0s linear 120ms;
        }
        header nav.open {
          transform: translateY(0);
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
          transition:
            transform 120ms var(--ease-snap),
            opacity 120ms var(--ease-snap),
            visibility 0s;
        }

        header nav a.navlink {
          display:block;
          width:100%;
          text-align:center;
          padding:16px 8px;
          font-size:1.0625rem;
          line-height:1.35;
          font-weight:600;
          letter-spacing:.2px;
          color:var(--ink);
          border-radius:0;
          opacity: 1;
          background: transparent;
        }
        header nav a.navlink + a.navlink { border-top: 1px solid #eef2f7; }
        header nav a.navlink.active { background: #f8fafc; }
        header nav a.navlink:active { background: #f3f4f6; }

        .nav-overlay {
          position: fixed;
          top: var(--header-h);
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0,0,0,.24);
          -webkit-tap-highlight-color: transparent;
          z-index: 1000;
        }
        body:not(.nav-open) .nav-overlay { display: none; }

        .brand { font-size: 1.0625rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        header nav,
        header nav.open {
          transition: none !important;
        }
        .hamburger:active { transform: none; }
      }

      .pad-x { padding-inline: clamp(var(--edge-pad), 4vw, var(--edge-pad-lg)); }
      .wrap-1280 { max-width: var(--container-max); margin-inline: auto; }

      .page-content {
        max-width: var(--container-max);
        margin: 1.25rem auto 0 auto;
        background: #f9fafb;
        border-radius: 16px;
        box-shadow: 0 2px 14px rgba(0, 0, 0, .06);
        border: 1px solid rgba(0, 0, 0, 0.04);
        padding-left: var(--edge-pad);
        padding-right: var(--edge-pad);
        padding-top: 1.6rem;
        padding-bottom: 1.6rem;
      }
      @media (min-width: 900px) {
        .page-content {
          padding-left: var(--edge-pad-lg);
          padding-right: var(--edge-pad-lg);
          padding-top: 2rem;
          padding-bottom: 2rem;
        }
      }
      @media (max-width: 900px) {
        .page-content {
          margin: 0 auto;
          border-radius: 0;
          box-shadow: none;
          border: 0;
          background: #fff;
          padding: 14px var(--edge-pad) 18px;
        }
        .page-content > *:first-child { margin-top: 0 !important; }
        .page-content > *:last-child { margin-bottom: 0 !important; }
        .below-fold { margin-top: 0; }
        footer.site-footer { margin-top: 1.25rem; }
      }

      figure img,
      article img {
        display: block;
        max-width: 100%;
        height: auto;
        object-fit: contain;
        border-radius: 8px;
        margin: 1rem auto;
      }
      figure { margin: 1.5rem 0; text-align: center; overflow: hidden; }
      figcaption {
        font-size: 0.9rem;
        color: var(--text-muted, #666);
        margin-top: 0.5rem;
        line-height: 1.4;
      }

      hr {
        margin: 2.4rem 0;
        border: 0;
        border-top: 1px solid #e5e7eb;
      }

      @media (min-width: 600px) {
        :root { --h1-size: 2.2rem; --h2-size: 1.6rem; --h3-size: 1.25rem; }
      }

      @media (min-width: 900px) {
        :root { --h1-size: 2.6rem; --h2-size: 1.8rem; --h3-size: 1.35rem; --body-size: 1.05rem; }
      }

      @media (max-width: 599px) {
        .page-header { margin-top: 0.9rem; margin-bottom: 1.4rem; }
        .longcopy, .long-copy { margin-bottom: 2.2rem; }
        .below-fold > .page-header:first-child,
        .below-fold > section:first-child,
        .below-fold > div:first-child { margin-top: 0.9rem; }
      }

      main h1 {
        font-size: var(--h1-size) !important;
        line-height: var(--h1-line) !important;
        letter-spacing: var(--h1-track) !important;
        font-weight: 600 !important;
        margin: 0 0 0.6rem !important;
      }

      .skip-link { position: absolute; top: -200px; }

      .map-embed { margin: 1rem 0 1.5rem; }
      .map-embed__frame {
        width: 100%;
        aspect-ratio: 16 / 9;
        height: auto;
        display: block;
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(0,0,0,.10);
        overflow: hidden;
        background: rgba(0,0,0,.04);
      }
      .map-embed--slim .map-embed__frame { aspect-ratio: 21 / 9; border-radius: 16px; }
      @media (max-width: 640px) {
        .map-embed__frame { aspect-ratio: 4 / 5; border-radius: 16px; }
      }
      .map-embed__caption { margin-top: 0.5rem; font-size: 0.95rem; opacity: 0.8; }

      html.is-swapping body { cursor: progress; }
    </style>

    <!-- ✅ ONE Site UI binder (works with ViewTransitions) -->
    <script is:inline>
      (function () {
        function rebindSiteUI() {
          try { window.__siteAbort?.abort?.(); } catch {}
          var ac = new AbortController();
          window.__siteAbort = ac;
          var signal = ac.signal;

          // -------- Nav bind --------
          (function bindNav() {
            var btn = document.querySelector(".hamburger");
            var nav = document.querySelector("header nav");
            var overlay = document.querySelector(".nav-overlay");
            var body = document.body;
            if (!btn || !nav) return;

            var navId = nav.getAttribute("id") || "primary-nav";
            nav.setAttribute("id", navId);
            btn.setAttribute("aria-controls", navId);

            function openNav(open) {
              if (open) {
                nav.classList.add("open");
                body.classList.add("nav-open");
                btn.setAttribute("aria-expanded", "true");
                btn.setAttribute("aria-label", "Close menu");
                if (overlay) overlay.hidden = false;
              } else {
                nav.classList.remove("open");
                body.classList.remove("nav-open");
                btn.setAttribute("aria-expanded", "false");
                btn.setAttribute("aria-label", "Open menu");
                if (overlay) overlay.hidden = true;
              }
            }
            function toggle() { openNav(!nav.classList.contains("open")); }

            btn.addEventListener("click", toggle, { signal });

            nav.addEventListener("click", function (e) {
              var a = e.target && e.target.closest ? e.target.closest("a") : null;
              if (a) openNav(false);
            }, { passive: true, signal });

            if (overlay) overlay.addEventListener("click", function () { openNav(false); }, { passive: true, signal });

            document.addEventListener("keydown", function (e) {
              if (e.key === "Escape") openNav(false);
            }, { signal });

            window.addEventListener("resize", function () {
              if (window.matchMedia("(min-width: 1025px)").matches) openNav(false);
            }, { passive: true, signal });

            openNav(false);
          })();

          // -------- Header scroll "glass" toggle --------
          (function bindHeaderScroll() {
            function updateHeader() {
              var h = document.querySelector("header[role='banner']");
              if (!h) return;
              if (window.scrollY > 10) h.classList.add("scrolled");
              else h.classList.remove("scrolled");
            }
            updateHeader();
            window.addEventListener("scroll", updateHeader, { passive: true, signal });
          })();

          // -------- Scrollbar width measurer --------
          (function bindSBW() {
            var root = document.documentElement;
            function setSBW() {
              var sbw = Math.max(0, window.innerWidth - root.clientWidth);
              root.style.setProperty("--sbw", sbw + "px");
            }
            setSBW();
            window.addEventListener("resize", setSBW, { passive: true, signal });
            document.addEventListener("visibilitychange", setSBW, { signal });
          })();

          // -------- Prefetch on hover/touch for internal links --------
          (function bindPrefetch() {
            var prefetched = new Set();
            function prefetch(href) {
              if (!href || prefetched.has(href)) return;
              prefetched.add(href);
              var l = document.createElement("link");
              l.rel = "prefetch";
              l.as = "document";
              l.href = href;
              document.head.appendChild(l);
            }

            function handle(e) {
              var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
              if (!a) return;
              if (a.target === "_blank" || a.hasAttribute("download")) return;

              var url;
              try { url = new URL(a.href, location.href); } catch { return; }
              if (url.origin !== location.origin) return;
              if (url.pathname === location.pathname && url.hash) return;

              prefetch(url.pathname + url.search);
            }

            document.addEventListener("mouseover", handle, { passive: true, signal });
            document.addEventListener("touchstart", handle, { passive: true, signal });
          })();

          // -------- Hard reload on RV pages (and fix back button blank RV) --------
          (function bindHardNav() {
           var RV_PATH = [
  /^\/$/i,
  /^\/browse\/?$/i,

  // Neighbourhoods
  /^\/neighbourhoods\/[^\/]+(?:\/.*)?$/i,

  // Neighbourhood types
  /^\/neighbourhood_type\/[^\/]+\/?$/i,

  // Types + Areas
  /^\/types\/[^\/]+\/?$/i,
  /^\/areas\/[^\/]+\/?$/i,

  // Living
  /^\/living\/?$/i,
  /^\/living\/[^\/]+(?:\/.*)?$/i,

  // Blog detail ✅ add this
  /^\/blog\/[^\/]+\/?$/i,
 
  // To-do
  /^\/to-do\/?$/i,
  /^\/to-do\/[^\/]+\/?$/i,
  /^\/to_do\/?$/i,
  /^\/to_do\/[^\/]+\/?$/i,
];


            function shouldHardNav(pathname) {
              return RV_PATH.some(function (re) { return re.test(pathname); });
            }

            // If RV embed exists but cards are missing, treat as "blank"
            function rvLooksEmpty() {
              var hasRvMarker =
                !!document.querySelector("[data-rv-insert-root]") ||
                !!document.querySelector(".rv-host") ||
                !!document.querySelector(".rv-block");

              // If there's no RV marker on this page, don't force reload
              if (!hasRvMarker) return false;

              var hasCards =
                !!document.querySelector(".rv-listingCard") ||
                !!document.querySelector(".rv-block .rv-listingCard") ||
                !!document.querySelector(".rv-block a.rv-listingCard");

              return !hasCards;
            }

            // Reload once per URL (prevents loops) - but give RV time to rehydrate
            function reloadOnceIfStillBlank(reason) {
              if (!shouldHardNav(location.pathname)) return;

              var key = "rv-blank-reload:" + location.pathname + location.search;
              var last = +sessionStorage.getItem(key) || 0;
              if (Date.now() - last < 15000) return; // 15s cooldown
              sessionStorage.setItem(key, String(Date.now()));

              var tries = 0;
              var maxTries = 8;   // ~ 8 * 300ms = 2.4s
              var interval = 300;

              var t = setInterval(function () {
                tries++;

                // If RV recovered, stop checking
                if (!rvLooksEmpty()) {
                  clearInterval(t);
                  return;
                }

                // Still blank after several tries -> reload once
                if (tries >= maxTries) {
                  clearInterval(t);
                  console.warn("[RV] Still blank after " + reason + " - reloading");
                  location.reload();
                }
              }, interval);
            }

         

            // Force hard navigation whenever leaving OR entering an RV-ish page
            document.addEventListener("click", function (e) {
              var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
              if (!a) return;

              if (e.defaultPrevented) return;
              if (e.button !== 0) return;
              if (a.target === "_blank") return;
              if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

              var u;
              try { u = new URL(a.href, location.href); } catch { return; }
              if (u.origin !== location.origin) return;

              var fromIsRv = shouldHardNav(location.pathname);
              var toIsRv = shouldHardNav(u.pathname);

              if (fromIsRv || toIsRv) {
                e.preventDefault();
                location.assign(u.href);
              }
            }, { capture: true, signal: signal });
          })();
        }

        // run now + after every ViewTransition swap
        rebindSiteUI();
        document.addEventListener("astro:page-load", rebindSiteUI);
      })();
    </script>

