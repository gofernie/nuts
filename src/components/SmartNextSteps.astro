---
/**
 * File: src/components/SmartNextSteps.astro
 *
 * A "smart advisor" panel that:
 *  - Highlights the best next action (talk to you)
 *  - Surfaces recommended neighbourhoods + property types
 *  - Lets the user restart/refine answers
 *  - (Optionally) gives a "Back to full results" link
 */

interface NextItem {
  href: string;
  label: string;
  meta?: string;
}

const {
  heading = "What to do next",
  intro = "Here’s what most people do after seeing their Fernie home matches.",
  neighbourhoodLinks = [] as NextItem[],
  typeLinks = [] as NextItem[],
  contactHref = "/contact",
  restartHref = "/home-match",
  backHref = "", // e.g. original results page path
} = Astro.props;

const hasNeighbourhoods = neighbourhoodLinks.length > 0;
const hasTypes = typeLinks.length > 0;
---

<section class="next-steps" aria-labelledby="next-steps-heading">
  <div class="next-steps-shell">
    <header class="next-steps-header">
      <h2 id="next-steps-heading">{heading}</h2>
      <p class="next-steps-intro">
        {intro}
      </p>
    </header>

    <div class="next-steps-grid">
      <!-- PRIMARY CARD: Talk to Chris -->
      <article class="next-card next-card--primary">
        <h3>Talk it through with Chris</h3>
        <p>
          You’ve got a rough picture of what might fit. The next step is a quick chat
          so we can sanity-check your matches and talk about timing, budget, and neighbourhoods.
        </p>

        <ul class="next-list">
          <li>Sense-check your recommended areas and property types</li>
          <li>Talk strategy for buying in Fernie’s current market</li>
          <li>Decide what to watch for over the next few months</li>
        </ul>

        <a href={contactHref} class="next-btn">
          Book a quick call →
        </a>

        <p class="next-card-foot">
          No pressure, no spam — just a local Fernie REALTOR® (Chris Crump) to bounce ideas off.
        </p>
      </article>

      <!-- NEIGHBOURHOODS CARD -->
      <article class="next-card">
        <h3>Explore your best-fit neighbourhoods</h3>
        <p>
          Click into the areas that matched your answers to see photos, details, and current listings.
        </p>

        {hasNeighbourhoods ? (
          <div class="pill-row" aria-label="Recommended neighbourhoods">
            {neighbourhoodLinks.map((item) => (
              <a href={item.href} class="pill">
                <span class="pill-label">{item.label}</span>
                {item.meta && <span class="pill-meta">{item.meta}</span>}
              </a>
            ))}
          </div>
        ) : (
          <p class="next-empty">
            Once we have your matches, your top neighbourhoods will show up here.
          </p>
        )}

        <a href="/neighbourhoods" class="next-link-inline">
          Browse all Fernie neighbourhoods →
        </a>
      </article>

      <!-- PROPERTY TYPES CARD -->
      <article class="next-card">
        <h3>Dial in your property type</h3>
        <p>
          From ski hill condos to Montane family homes and acreages, explore what each option
          really looks like on the ground in Fernie.
        </p>

        {hasTypes ? (
          <div class="pill-row" aria-label="Recommended property types">
            {typeLinks.map((item) => (
              <a href={item.href} class="pill">
                <span class="pill-label">{item.label}</span>
                {item.meta && <span class="pill-meta">{item.meta}</span>}
              </a>
            ))}
          </div>
        ) : (
          <p class="next-empty">
            Your recommended property types will appear here after you complete the form.
          </p>
        )}

        <a href="/types" class="next-link-inline">
          Browse all property types →
        </a>
      </article>
    </div>

    <!-- FOOTER ACTION ROW -->
    <footer class="next-steps-footer">
      <div class="next-footer-left">
        <a href={restartHref} class="next-footer-link">
          ← Start over or refine your answers
        </a>
        {backHref && (
          <a href={backHref} class="next-footer-link">
            Back to your full home-match results
          </a>
        )}
      </div>

      <div class="next-footer-right">
        <span class="next-foot-note">
          Ready to move sooner? Jump straight to
          <a href="/neighbourhoods" class="next-foot-inline">neighbourhoods</a> or
          <a href="/types" class="next-foot-inline">property types</a>.
        </span>
      </div>
    </footer>
  </div>
</section>

<style>
  .next-steps {
    margin: 3rem 0 0;
  }

  .next-steps-shell {
    border-radius: 1.25rem;
    padding: 1.75rem 1.5rem 1.75rem;
    background: rgba(248, 249, 250, 0.95);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .next-steps-header {
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }

  .next-steps-header h2 {
    font-size: 1.4rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin: 0 0 0.6rem;
  }

  .next-steps-intro {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .next-steps-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1.4fr) minmax(0, 1.4fr);
    gap: 1.25rem;
  }

  .next-card {
    background: white;
    border-radius: 1rem;
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .next-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .next-card p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .next-card--primary {
    position: relative;
    overflow: hidden;
  }

  .next-card--primary::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 55%);
    opacity: 0.75;
    pointer-events: none;
  }

  .next-card--primary > * {
    position: relative;
    z-index: 1;
  }

  .next-list {
    margin: 0.4rem 0 0.2rem;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .next-list li + li {
    margin-top: 0.25rem;
  }

  .next-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.7rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    font-size: 0.96rem;
    font-weight: 500;
    border: none;
    text-decoration: none;
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 10px 18px rgba(15, 23, 42, 0.35);
    transform: translateY(0);
    transition: transform 120ms ease, box-shadow 120ms ease, opacity 120ms ease;
  }

  .next-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 24px rgba(15, 23, 42, 0.4);
    opacity: 0.98;
  }

  .next-card-foot {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.5rem 0 0.6rem;
  }

  .pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.55);
    font-size: 0.86rem;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.95);
    transition: background 120ms ease, border-color 120ms ease, transform 80ms ease;
  }

  .pill-label {
    font-weight: 500;
  }

  .pill-meta {
    opacity: 0.75;
  }

  .pill:hover {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    transform: translateY(-1px);
  }

  .next-link-inline {
    margin-top: auto;
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.9;
  }

  .next-link-inline:hover {
    opacity: 1;
  }

  .next-empty {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .next-steps-footer {
    margin-top: 1.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(148, 163, 184, 0.35);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: center;
  }

  .next-footer-left {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .next-footer-link {
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.9;
  }

  .next-footer-link:hover {
    opacity: 1;
  }

  .next-foot-note {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .next-foot-inline {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 960px) {
    .next-steps-shell {
      padding: 1.5rem 1rem 1.6rem;
    }

    .next-steps-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
