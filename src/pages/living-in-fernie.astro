---
/**
 * File: src/pages/living-in-fernie.astro
 * Living in Fernie — Hub page
 */
export const prerender = true;

import Site from "../layouts/Site.astro";
import { getJson } from "../lib/fetchJson";
import ListingsAccordion from "../components/ListingsAccordion.astro";
import { DEFAULT_ACCENT } from "../lib/categoryColours";

/* ---------- Load header from Living sheet for hero + summary ---------- */
const LIVING_URL = import.meta.env.PUBLIC_LIVING_JSON;

const get = (r: any, k: string) =>
  (
    r?.[k] ??
    r?.[k?.toLowerCase?.()] ??
    r?.[k?.toUpperCase?.()] ??
    ""
  ).toString().trim();

const stripMeta = (s = "") =>
  s
    .replace(/<[^>]+>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const stripScripts = (html = "") =>
  html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");

let header: any = null;
let error: string | null = null;

if (LIVING_URL) {
  try {
    const raw = await getJson<any>(LIVING_URL);
    const rows: any[] = Array.isArray(raw)
      ? raw
      : Array.isArray(raw?.data)
      ? raw.data
      : Array.isArray(raw?.rows)
      ? raw.rows
      : [];

    const headerCandidates = rows.filter((r: any) => {
      const slug = get(r, "slug").toLowerCase();
      const status = get(r, "status").toLowerCase();
      const has =
        !!get(r, "summary") ||
        !!get(r, "long_copy") ||
        !!get(r, "seo_description") ||
        !!get(r, "description") ||
        !!get(r, "subhead");
      return slug === "index" || status === "header" || has;
    });

    header =
      headerCandidates.find((r: any) => get(r, "slug").toLowerCase() === "index") ??
      headerCandidates.find((r: any) => get(r, "status").toLowerCase() === "header") ??
      headerCandidates[0] ??
      null;
  } catch (e: any) {
    error = e?.message || "Failed to load header.";
  }
} else {
  error = "Missing PUBLIC_LIVING_JSON";
}

/* ---------- Page fields ---------- */
const fallbackTitle = "Living in Fernie";

const pageTitle = get(header, "title") || fallbackTitle;

/** Slug-style subhead (uppercase + accent) */
const pageSubhead =
  get(header, "subhead") ||
  "A locals-level hub for everyday life, things to do, and where to stay in Fernie.";

const pageSummaryRaw =
  get(header, "summary") ||
  get(header, "long_copy") ||
  get(header, "seo_description") ||
  get(header, "description") ||
  "";

const summaryHtml = stripScripts(pageSummaryRaw);

const seoTitle = get(header, "seo_title") || pageTitle;
const rawSeoDesc = get(header, "seo_description") || pageSummaryRaw || "";
const seoDesc =
  stripMeta(rawSeoDesc) ||
  "Living in Fernie: everyday essentials, things to do, and the best places to stay.";

/* header accent - use site brand */
const headerAccent = DEFAULT_ACCENT;

---

<Site
  title={seoTitle}
  seo_title={seoTitle}
  seo_description={seoDesc}
  wrapContent={false}
>
  <div class="page-shell pad-x">
    {/* INTRO HEADER – match Areas slug treatment */}
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="area-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span class="area-breadcrumb-current">{pageTitle}</span>
      </nav>

      <div class="area-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{pageTitle}</h1>
        </div>

        {pageSubhead && <p class="page-subhead">{pageSubhead}</p>}
      </div>
    </section>

    {/* FADED MOUNTAIN STRIP */}
    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeLivingHub" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeLivingHub)"
        />
      </svg>
    </div>

    {summaryHtml && (
      <section class="summary-wrap">
        <div class="lead" set:html={summaryHtml}></div>
      </section>
    )}

    {error && <p class="err">{error}</p>}

    {/* HUB CARDS + ACCORDION */}
    <section class="hub">
      <div class="hub-grid">
        {/* Living Guides */}
        <a href="/living" class="hub-card" data-hub="living-guides">
          <div class="hub-card-inner">
            <div class="hub-icon">🏡</div>
            <h2 class="hub-title">Living guides</h2>
            <p class="hub-text">
              Utilities, schools, healthcare, groceries, cost of living, and everything you need to
              actually live in Fernie.
            </p>
            <span class="hub-cta">Browse living guides</span>
          </div>
        </a>

        {/* Things To Do */}
        <a href="/to_do" class="hub-card" data-hub="to-do">
          <div class="hub-card-inner">
            <div class="hub-icon">🎿</div>
            <h2 class="hub-title">Things to do</h2>
            <p class="hub-text">
              Ski days, bike trails, hiking, family activities, and year-round ideas for making the
              most of Fernie.
            </p>
            <span class="hub-cta">See things to do</span>
          </div>
        </a>

        {/* Places To Stay */}
        <a href="/stay" class="hub-card" data-hub="stay">
          <div class="hub-card-inner">
            <div class="hub-icon">🛏️</div>
            <h2 class="hub-title">Places to stay</h2>
            <p class="hub-text">
              Hotels, cabins, ski-hill stays, and neighbourhoods that work best when you’re visiting
              or hosting.
            </p>
            <span class="hub-cta">Explore places to stay</span>
          </div>
        </a>
      </div>

      <div class="hub-accordion">
        <ListingsAccordion
          container={false}
          label="Explore Fernie real estate listings"
          subline="See the newest listings currently active on the MLS."
          cta1="Learn more"
          block="MQP2VMLT-XHHU2EW2"
        />
      </div>
    </section>
  </div>

  <style>
    .page-shell {
      max-width: 1280px;
      margin-inline: auto;
      margin-top: 14px;
      margin-bottom: 40px;
    }

    .pad-x {
      padding-inline: var(--edge-pad) !important;
    }
    @media (min-width: 900px) {
      .pad-x {
        padding-inline: var(--edge-pad-lg) !important;
      }
    }

    /* INTRO – match Areas slug */
    .page-intro {
      max-width: var(--container-max);
      margin: 0 auto 10px;
      padding-top: 28px;
    }

    .area-breadcrumb {
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .area-breadcrumb a {
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }
    .area-breadcrumb a:hover {
      border-bottom-color: var(--accent);
    }
    .area-breadcrumb-current {
      opacity: 0.7;
    }

    .area-title-block {
      max-width: 48rem;
    }

    .accent-bars {
      display: flex;
      gap: 0.25rem;
      margin-bottom: 0.75rem;
    }
    .accent-bar {
      height: 4px;
      border-radius: 999px;
      background: var(--accent);
    }
    .accent-bar.primary {
      width: 80px;
      opacity: 0.9;
    }
    .accent-bar.secondary {
      width: 40px;
      opacity: 0.45;
    }

    .title-row {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .page-title {
      margin: 0 0 6px;
      font-size: clamp(2.4rem, 3.8vw, 3.05rem);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: #111827;
      line-height: 1.08;
    }

    /* ✅ slug-style kicker/subhead (accent + uppercase) */
    .page-subhead {
      margin: 6px 0 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      max-width: 52rem;
    }

    .mountain-strip {
      margin: 8px auto 24px;
      height: 48px;
      max-height: 60px;
      border-radius: 6px;
      overflow: hidden;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.02), transparent);
    }
    .mountain-strip svg {
      width: 100%;
      height: 100%;
      opacity: 0.9;
      mix-blend-mode: multiply;
    }

    /* ✅ slug-style summary spacing (no huge gap) */
     .summary-wrap{
      padding-top: 12px;
      padding-bottom: 25px;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 50px;
    }

    .lead {
      margin: 0;
      font-size: 1.075rem;
      line-height: 1.6;
      color: #111827;
    }
    .lead :where(p, ul, ol) {
      margin: 0 0 0.8rem;
    }
    .lead :where(a) {
      text-decoration: underline;
    }

    .err {
      color: #b91c1c;
      background: #fee2e2;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      margin-top: 12px;
    }

    /* HUB GRID */
    .hub {
      margin-top: 10px;
    }

    .hub-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    @media (max-width: 900px) {
      .hub-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .hub-grid {
        grid-template-columns: 1fr;
      }
    }

    .hub-accordion {
      margin-top: 24px;
    }

    .hub-card {
      text-decoration: none;
      color: inherit;
      border-radius: 18px;
      border: 1px solid #e2e4e8;
      background: #fff;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
      position: relative;
      overflow: hidden;
      transition: transform 0.14s ease, box-shadow 0.16s ease, border-color 0.16s ease;
    }
    .hub-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.12);
    }

    .hub-card-inner {
      padding: 24px 22px 26px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      z-index: 1;
    }

    .hub-icon {
      font-size: 3.2rem;
      line-height: 1;
      margin-bottom: 6px;
      user-select: none;
      pointer-events: none;
      transform: translateY(0);
      transition: transform 0.16s ease;
    }
    .hub-card:hover .hub-icon {
      transform: translateY(-2px);
    }

    .hub-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin: 0;
      color: #111827;
    }
    .hub-text {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.52;
      color: #4b5563;
      flex-grow: 1;
    }

    .hub-cta {
      font-size: 0.92rem;
      font-weight: 600;
      color: #0f172a;
    }
    .hub-cta::after {
      content: "↗";
      margin-left: 4px;
      font-size: 0.8em;
    }

    
    .hub-card::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background: radial-gradient(
        circle at 0 0,
        color-mix(in srgb, var(--hub-accent) 10%, #fff 90%),
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.16s ease;
    }
    .hub-card:hover::before {
      opacity: 1;
    }

    .hub-card { --hub-accent: var(--accent); }

  </style>
</Site>
