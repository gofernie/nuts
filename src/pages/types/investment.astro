---
// File: src/pages/types/investment.astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";
import { CATEGORY_COLOURS, DEFAULT_ACCENT } from "../../lib/categoryColours";

const PATH_NEIGHBOURHOODS = "/neighbourhoods";

/* ---------------- helpers ---------------- */
const RESERVED = new Set(["index", "page", "pages", "all", "view", "list"]);

function get(r: any, k: string) {
  if (!r) return "";
  if (r[k] != null) return String(r[k]).trim();
  const lk = String(k).toLowerCase();
  if (r[lk] != null) return String(r[lk]).trim();
  const uk = String(k).toUpperCase();
  if (r[uk] != null) return String(r[uk]).trim();
  return "";
}

function slugify(v: any) {
  return String(v ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "-and-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function stripTags(s: string = "") {
  return s
    .replace(/<[^>]*>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function excerpt(s: string, n = 240) {
  const t = stripTags(s);
  return t.length > n ? t.slice(0, n - 1).trimEnd() + "…" : t;
}

function isAbs(s: string = "") {
  return /^https?:\/\//i.test(s);
}

function pick(...vals: string[]) {
  for (const v of vals) if (v && String(v).length > 0) return String(v);
  return "";
}

function normalizeRows(raw: any) {
  if (Array.isArray(raw)) return raw;
  if (raw && Array.isArray(raw.data)) return raw.data;
  if (raw && Array.isArray(raw.rows)) return raw.rows;
  return [];
}

function visible(r: any) {
  const status = String(get(r, "status")).trim().toLowerCase();
  const rawSlug = slugify(get(r, "slug") || get(r, "name") || get(r, "Name"));
  return (
    status !== "hidden" &&
    status !== "inactive" &&
    rawSlug !== "index" &&
    !RESERVED.has(rawSlug)
  );
}

function titleCase(s: string) {
  return (s ?? "").replace(/\w\S*/g, (w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());
}

function clip(s: string, max = 44) {
  const t = String(s ?? "").trim();
  if (!t) return "";
  if (t.length <= max) return t;
  const cut = t.slice(0, max);
  return cut.replace(/\s+\S*$/, "").trimEnd() + "…";
}

function suits3(r: any) {
  return [
    get(r, "suits_1"),
    get(r, "suits_2"),
    get(r, "suits_3"),
    get(r, "suits_4"),
    get(r, "suits_5"),
  ]
    .map((s) => clip(String(s ?? "").trim(), 44))
    .filter(Boolean)
    .slice(0, 3);
}

/* tags includes "investment" (comma / pipe tolerant) */
function tagsIncludeInvestment(r: any) {
  const raw =
    get(r, "tags") ||
    get(r, "tag") ||
    get(r, "Tags") ||
    get(r, "Tag") ||
    "";

  if (!raw) return false;

  const parts = raw
    .split(/[,|]/g)
    .map((x) => x.trim().toLowerCase())
    .filter(Boolean);

  // allow either "investment" or "investments"
  return parts.includes("investment") || parts.includes("investments");
}

/* ✅ parse tags for filtering */
function parseTags(r: any) {
  const raw =
    get(r, "tags") ||
    get(r, "tag") ||
    get(r, "Tags") ||
    get(r, "Tag") ||
    "";

  if (!raw) return [];

  // supports comma or pipe. (space-separated tags are ambiguous so we avoid splitting on space)
  return raw
    .split(/[,|]/g)
    .map((x) => slugify(String(x || "").trim()))
    .filter(Boolean);
}

type Item = {
  parent: string;     // parent_area_slug (eg downtown)
  slug: string;       // building slug
  name: string;
  positioning: string;
  short: string;
  order: number;
  img: string;
  bestFor: string[];
  tags: string[];     // ✅ add tags
};

const buildingsUrl = import.meta.env.PUBLIC_BUILDINGS_JSON || "";

let items: Item[] = [];
let debug = {
  buildingsUrl: buildingsUrl || "(missing)",
  buildingsRows: 0,
  investmentCount: 0,
};

if (buildingsUrl) {
  try {
    const raw = await getJson<any>(buildingsUrl);
    const rows = normalizeRows(raw);
    debug.buildingsRows = rows.length;

    items = rows
      .filter((r: any) => visible(r))
      .filter((r: any) => tagsIncludeInvestment(r))
      .map((r: any) => {
        const parentVal =
          get(r, "parent_area_slug") ||
          get(r, "parent_slug") ||
          get(r, "parent") ||
          get(r, "area_slug") ||
          get(r, "neighbourhood_slug") ||
          get(r, "neighbourhood") ||
          get(r, "Neighborhood") ||
          get(r, "Parent");

        const parentOut = slugify(parentVal);

        const slugVal =
          get(r, "slug") || get(r, "building_slug") || get(r, "name") || get(r, "Name");
        const slugOut = slugify(slugVal);

        const name =
          get(r, "name") ||
          get(r, "Name") ||
          get(r, "building_name") ||
          get(r, "Building Name") ||
          slugOut;

        const positioning =
          get(r, "positioning_line") || get(r, "positioning") || get(r, "Positioning");
        const short = get(r, "short_summary") || get(r, "summary") || get(r, "Short Summary");

        const order =
          Number(get(r, "order") || get(r, "sort") || get(r, "Sort")) || Number.MAX_SAFE_INTEGER;

        const rawImg = pick(get(r, "card_image"), get(r, "hero_image"), get(r, "image"), get(r, "Image"));
        const img = rawImg ? (isAbs(rawImg) ? rawImg : heroPath(rawImg)) : "";

        const bestFor = suits3(r);
        const tags = parseTags(r);

        return { parent: parentOut, slug: slugOut, name, positioning, short, order, img, bestFor, tags };
      })
      .filter((it) => it.parent && it.slug && it.name)
      .sort((a, b) => Number(a.order) - Number(b.order) || a.name.localeCompare(b.name));

    debug.investmentCount = items.length;
  } catch (e) {
    // leave items empty; debug will show counts
    console.log("[types/investment] PUBLIC_BUILDINGS_JSON failed:", e);
  }
}

const pageTitle = "Investment Buildings";
const pageSubhead =
  "Curated building guides - rental fit, ownership notes, and practical considerations for investment buyers in Fernie.";

const seoTitle = pageTitle;
const seoDesc = stripTags(pageSubhead);

/* keep the same vibe as your buildings index */
const headerAccent = (CATEGORY_COLOURS as any).types ?? DEFAULT_ACCENT;
const gradId = "mountainFadeInvestmentTypes";
---

<Site title={seoTitle} seo_title={seoTitle} seo_description={seoDesc} wrapContent={false}>
  <div class="page-shell pad-x">
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="types-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/types">Property Types</a>
        <span>/</span>
        <span class="types-breadcrumb-current">Investment</span>
      </nav>

      <div class="types-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{pageTitle}</h1>
        </div>

        <p class="page-subhead">{pageSubhead}</p>
      </div>
    </section>

    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id={gradId} x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="M0 18 L5 8 L11 14 L18 5 L25 13 L32 4 L40 12 L48 3 L56 11 L64 4 L72 13 L80 6 L90 15 L100 7 L100 20 L0 20 Z"
          fill={`url(#${gradId})`}
        />
      </svg>
    </div>

    <section class="summary-wrap">
      <p class="lead">{pageSubhead}</p>
    </section>

    {/* ✅ FILTERS (progressive enhancement) */}
    <section class="filters" aria-label="Investment filters">
      <div class="filters-row">
        <label class="filters-label" for="invFilter">Filter</label>

        <select id="invFilter" class="filters-select">
          <option value="all">All investment buildings</option>
          <option value="str">STR</option>
          <option value="ski-hill">Ski Hill</option>
          <option value="monthly-rental">Monthly rental</option>
        </select>

        <button id="invClear" class="filters-clear" type="button">Clear</button>
      </div>

      <p class="filters-note">Tip - filter narrows this list without reloading the page.</p>
    </section>

    <section class="posts-grid">
      {items.length ? (
        items.map((it) => {
          // Link to your existing building detail route pattern:
          // /neighbourhoods/[parent]/buildings/[slug]
          const href = `${PATH_NEIGHBOURHOODS}/${it.parent}/buildings/${it.slug}`;

          return (
            <a
              class="post-card"
              href={href}
              data-astro-prefetch="hover"
              aria-label={it.name}
              data-tags={it.tags?.join(" ") ?? ""}   // ✅ for filtering
              style={`--accent:${headerAccent};`}
            >
              {it.img && (
                <div class="pc-media">
                  <img src={it.img} alt={it.name} loading="lazy" decoding="async" />
                </div>
              )}

              <div class="pc-body">
                <h3 class="pc-title">{it.name}</h3>

                {it.bestFor.length > 0 && (
                  <div class="bf">
                    <div class="bf-kicker">Best for</div>
                    <ul class="bf-list">
                      {it.bestFor.map((s) => (
                        <li title={s}>{s}</li>
                      ))}
                    </ul>
                  </div>
                )}

                <p class="pc-excerpt">{excerpt(it.positioning || it.short || "", 240)}</p>

                <span class="pc-cta">
                  Explore {titleCase(it.name || "Building")} <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          );
        })
      ) : (
        <div class="err">
          <p style="margin:0 0 10px;">No investment buildings found.</p>
          <details>
            <summary>Debug details</summary>
            <pre style="white-space:pre-wrap; margin-top:10px;">{JSON.stringify(debug, null, 2)}</pre>
          </details>
        </div>
      )}
    </section>
  </div>

  {/* ✅ filter script */}
  <script is:inline>
    (function () {
      var select = document.getElementById("invFilter");
      var clearBtn = document.getElementById("invClear");
      if (!select) return;

      function applyFilter() {
        var val = (select.value || "all").toLowerCase();
        var cards = document.querySelectorAll(".posts-grid .post-card");

        cards.forEach(function (card) {
          var tags = (card.getAttribute("data-tags") || "")
            .toLowerCase()
            .split(/\s+/)
            .filter(Boolean);

          var ok = (val === "all") ? true : tags.includes(val);
          card.style.display = ok ? "" : "none";
        });
      }

      select.addEventListener("change", applyFilter);

      if (clearBtn) {
        clearBtn.addEventListener("click", function () {
          select.value = "all";
          applyFilter();
        });
      }

      applyFilter();
    })();
  </script>

  {/* copy-paste styling from your ski hill buildings index */}
  <style is:global>
    .page-shell { max-width: 1280px; margin-inline: auto; margin-top: 14px; margin-bottom: 40px; }
    .pad-x { padding-inline: var(--edge-pad) !important; }
    @media (min-width: 900px){ .pad-x { padding-inline: var(--edge-pad-lg) !important; } }

    .page-intro { max-width: var(--container-max); margin: 0 auto 10px; padding-top: 28px; }
    .types-breadcrumb{ font-size: 0.8rem; opacity: 0.8; margin-bottom: 0.75rem; display:flex; flex-wrap:wrap; gap:0.35rem; }
    .types-breadcrumb a{ text-decoration:none; border-bottom:1px solid transparent; color: inherit; }
    .types-breadcrumb a:hover{ border-bottom-color: var(--accent); }
    .types-breadcrumb-current{ opacity: 0.7; }

    .types-title-block{ max-width: 48rem; }
    .accent-bars{ display:flex; gap:0.25rem; margin-bottom:0.75rem; }
    .accent-bar{ height:4px; border-radius:999px; background:var(--accent); }
    .accent-bar.primary{ width:80px; opacity:0.9; }
    .accent-bar.secondary{ width:40px; opacity:0.45; }
    .title-row{ display:flex; align-items:flex-start; gap:0.75rem; }
    .page-title{ margin:0 0 6px; font-size:clamp(2.4rem,3.8vw,3.05rem); line-height:1.08; font-weight:750; letter-spacing:-0.015em; color:#111827; }
    .page-subhead{ margin:6px 0 8px; font-size:0.9rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--accent); }

    .mountain-strip{ margin:8px auto 24px; height:48px; max-height:60px; border-radius:6px; overflow:hidden; background:linear-gradient(to top, rgba(0,0,0,0.02), transparent); }
    .mountain-strip svg{ width:100%; height:100%; opacity:0.9; mix-blend-mode:multiply; }

    .summary-wrap{ padding-top:12px; padding-bottom:25px; border-bottom:1px solid #e5e7eb; margin-bottom:24px; }
    .lead{ margin:0; font-size:1.075rem; line-height:1.6; color:#111827; }

    /* ✅ FILTER UI */
    .filters{ margin: 0 0 16px; }
    .filters-row{ display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
    .filters-label{
      font-size:.8rem;
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
      opacity:.7;
    }
    .filters-select{
      appearance:none;
      border:1px solid #e5e7eb;
      border-radius:999px;
      padding:10px 12px;
      background:#fff;
      font-weight:700;
      color:#111827;
      min-width: 240px;
    }
    .filters-select:focus{ outline:2px solid var(--accent); outline-offset:3px; }
    .filters-clear{
      border:1px solid #e5e7eb;
      border-radius:999px;
      padding:10px 12px;
      background:#fff;
      font-weight:800;
      cursor:pointer;
    }
    .filters-clear:hover{ border-color: var(--accent); }
    .filters-note{ margin: 8px 0 0; font-size:.95rem; color:#4b5563; }

    .err{ color:#111827; background:#fee2e2; border:1px solid #fecaca; padding:1rem; border-radius:1rem; }
    .err summary{ cursor:pointer; font-weight:750; }
    .err pre{ background:#fff; padding:.75rem; border-radius:.75rem; border:1px solid #fecaca; }

    .posts-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:18px;
      margin-top:18px;
      margin-bottom:52px;
      min-height: 420px;
    }
    @media(max-width:900px){ .posts-grid{ grid-template-columns:repeat(2,minmax(0,1fr)); min-height: 620px; } }
    @media(max-width:560px){ .posts-grid{ grid-template-columns:1fr; min-height: 880px; } }

    .posts-grid .post-card,
    .posts-grid .post-card:visited,
    .posts-grid .post-card:hover,
    .posts-grid .post-card:active{
      color: inherit !important;
      text-decoration: none !important;
    }
    .posts-grid .post-card *{ text-decoration: none !important; }

    .post-card{
      --accent:#4b5563;
      position:relative;
      display:flex;
      flex-direction:column;
      background:#fff;
      border:1px solid #e5e7eb;
      border-radius:18px;
      overflow:hidden;
      box-shadow:0 8px 22px rgba(0,0,0,.07);
      transition:transform .14s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .post-card:hover{
      transform:translateY(-3px);
      box-shadow:0 14px 34px rgba(0,0,0,.12);
      border-color:var(--accent);
    }
    .post-card:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }

    .pc-media{ position:relative; width:100%; aspect-ratio:16/9; border-bottom:1px solid #eef0f3; }
    .pc-media > img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }

    .pc-body{ padding:14px 14px 16px; }
    .pc-title{
      margin:2px 0 8px;
      font-size:1.2rem;
      line-height:1.25;
      font-weight:750;
      color:#111827 !important;
    }

    /* ---- BEST FOR (uses suits_1..5) ---- */
    .bf{ margin: 6px 0 10px; }
    .bf-kicker{
      font-size: .72rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      opacity: .65;
      margin-bottom: 8px;
    }
    .bf-list{
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .bf-list li{
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(0,0,0,.10);
      background: rgba(255,255,255,.9);
      color: #374151;
      font-size: .9rem;
      line-height: 1.25;

      max-width: 100%;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .bf-list li::after{
      content:"";
      position:absolute;
      right:0; top:0; bottom:0;
      width: 22px;
      background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,1));
      pointer-events:none;
    }

    .pc-excerpt{
      margin:0 0 12px;
      color:#4b5563 !important;
      line-height:1.45;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
      text-overflow:ellipsis;
      min-height:calc(2 * 1.45em);
    }

    .pc-cta{
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-size:0.95rem;
      font-weight:750;
      color:#111827 !important;
    }
    .pc-cta span[aria-hidden="true"]{ transition:transform .14s ease; }
    .post-card:hover .pc-cta{
      color:var(--accent) !important;
      text-decoration:underline !important;
      text-underline-offset:.18em;
    }
    .post-card:hover .pc-cta span[aria-hidden="true"]{ transform:translateX(2px); }
  </style>
</Site>
