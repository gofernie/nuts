---
/**
 * File: src/pages/dream-search.astro
 * Dream Search - buyer describes their dream home, AI turns it into Fernie search params
 *
 * Strategy:
 * - If neighbourhoods are detected: render neighbourhood PAGE iframes (reliable, because those pages already embed RealtyVis correctly)
 * - Otherwise: fallback to URL-based RealtyVis search iframe
 */
export const prerender = true;

import Site from "../layouts/Site.astro";
import CTAForm from "../components/CTAForm.astro";

const RV_BASE = import.meta.env.PUBLIC_REALTYVIS_SEARCH_BASE || "";
const RV_DEFAULTS = import.meta.env.PUBLIC_REALTYVIS_DEFAULT_PARAMS || "";
const NEIGH_URL = import.meta.env.PUBLIC_SHEET_JSON || "";

const headerAccent = "#0ea5e9";
const NEIGH_PAGE_BASE = "/neighbourhoods"; // ✅ your site uses /neighbourhoods/the-cedars/
---

<Site
  title="Dream Search - Fernie Listings"
  description="Describe your dream home - we'll turn it into a smart Fernie listing search you can browse immediately."
  wrapContent={false}
  hideFooter={true}
>
  <div class="page-shell pad-x">
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="crumb">
        <a href="/">Home</a>
        <span>/</span>
        <span class="crumb-current">Dream Search</span>
      </nav>

      <div class="title-block">
        <div class="accent-bars" aria-hidden="true">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">Dream Search</h1>
        </div>

        <p class="page-subhead">
          Paste a quick description of what you want - we’ll translate it into a listing search you can browse immediately.
        </p>
      </div>
    </section>

    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeDream" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeDream)"
        />
      </svg>
    </div>

    <section class="block">
      <div class="card">
        <h2 class="card-title">Describe what you want</h2>

        <form id="dreamForm" class="form" autocomplete="on">
          <div class="field field-full">
            <div class="label-row">
              <label class="label" for="dreamText">Dream home description</label>
            </div>

            <textarea
              id="dreamText"
              name="dreamText"
              rows="6"
              placeholder="Example: 3 bed family home in Montane or The Cedars, garage, close to trails, under $1.2M, not a condo, sunny yard..."
              required
            ></textarea>

            <p class="hint">
              Tip: Include must haves and no-go’s (e.g., no strata, not downtown, needs garage).
            </p>
          </div>

          <div class="row">
            <div class="field">
              <label class="label" for="maxPrice">Max price (optional)</label>
              <input id="maxPrice" name="maxPrice" inputmode="text" placeholder="2000000 or 2m or 900k" />
              <p class="hint">Examples - 900k, 1.2m, 2000000</p>
            </div>

            <div class="field">
              <label class="label" for="minBeds">Min beds (optional)</label>
              <input id="minBeds" name="minBeds" inputmode="numeric" placeholder="3" />
            </div>

            <div class="field">
              <label class="label" for="minBaths">Min baths (optional)</label>
              <input id="minBaths" name="minBaths" inputmode="numeric" placeholder="2" />
            </div>
          </div>

          <div class="actions">
            <button class="btn" type="submit" id="submitBtn">Find matches</button>
            <button class="btn ghost" type="button" id="resetBtn">Reset</button>
          </div>
        </form>
      </div>
    </section>

    <section class="block">
      <div id="status" class="status" data-mode="idle">
        Describe your dream home to generate a search.
      </div>
    </section>

    <section class="block" id="criteriaWrap" style="display:none;">
      <div class="card">
        <div class="criteria-head">
          <h2 class="card-title" style="margin:0;">Search summary</h2>
          <div class="actions">
            <button class="btn ghost" type="button" id="copySummaryBtn">Copy summary</button>
            <a class="btn ghost" id="openLink" href="#" target="_blank" rel="noopener">Open in new tab</a>
          </div>
        </div>

        <p id="criteriaSummary" class="summary-line"></p>

        <div id="areaWrap" class="pill-wrap" style="display:none;">
          <div class="pill-label">Neighbourhoods</div>
          <div id="areaPills" class="pills"></div>
        </div>

        <details class="details">
          <summary>Details (debug)</summary>
          <pre id="criteriaJson" class="pre"></pre>
          <div class="actions" style="margin-top:12px;">
            <button class="btn ghost" type="button" id="copyJsonBtn">Copy JSON</button>
          </div>
        </details>
      </div>
    </section>

    <section class="block" id="embedWrap" style="display:none;">
      <div class="card">
        <div class="criteria-head">
          <h2 class="card-title" style="margin:0;">Listing matches</h2>
        </div>

        <div id="rvErr" class="rvErr" style="display:none;"></div>
        <div id="embedMount" class="embedMount"></div>
      </div>
    </section>

    <section class="cta">
      <div class="cta-card">
        <h2>Want me to curate these?</h2>
        <p>
          If you want, I’ll shortlist the best matches, explain tradeoffs, and suggest a clean plan for viewings.
        </p>
        <CTAForm />
      </div>
    </section>
  </div>

  <div
    id="dreamEnv"
    data-rv-base={RV_BASE}
    data-rv-defaults={RV_DEFAULTS}
    data-neigh-url={NEIGH_URL}
    data-neigh-page-base={NEIGH_PAGE_BASE}
    style="display:none;"
  ></div>

  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const envEl = document.getElementById("dreamEnv");
      const RV_BASE = envEl?.dataset?.rvBase || "";
      const RV_DEFAULTS = envEl?.dataset?.rvDefaults || "";
      const NEIGH_URL = envEl?.dataset?.neighUrl || "";
      const NEIGH_PAGE_BASE = envEl?.dataset?.neighPageBase || "/neighbourhoods";

      const form = document.getElementById("dreamForm");
      const status = document.getElementById("status");
      const submitBtn = document.getElementById("submitBtn");
      const resetBtn = document.getElementById("resetBtn");

      const criteriaWrap = document.getElementById("criteriaWrap");
      const criteriaSummary = document.getElementById("criteriaSummary");
      const areaWrap = document.getElementById("areaWrap");
      const areaPills = document.getElementById("areaPills");

      const criteriaJson = document.getElementById("criteriaJson");
      const copySummaryBtn = document.getElementById("copySummaryBtn");
      const copyJsonBtn = document.getElementById("copyJsonBtn");
      const openLink = document.getElementById("openLink");

      const embedWrap = document.getElementById("embedWrap");
      const embedMount = document.getElementById("embedMount");
      const rvErr = document.getElementById("rvErr");

      const dreamTextEl = document.getElementById("dreamText");

      if (
        !form || !status || !submitBtn || !resetBtn ||
        !criteriaWrap || !criteriaSummary || !criteriaJson ||
        !copySummaryBtn || !copyJsonBtn || !openLink ||
        !embedWrap || !embedMount || !dreamTextEl || !areaWrap || !areaPills
      ) {
        console.error("Dream Search: missing DOM elements");
        return;
      }

      function cleanNum(v) {
        const n = Number(String(v || "").replace(/[^\d.]/g, ""));
        return Number.isFinite(n) && n > 0 ? n : null;
      }

      function setStatus(msg, mode = "idle") {
        status.textContent = msg;
        status.dataset.mode = mode;
      }

      function showRvError(msg) {
        rvErr.style.display = "block";
        rvErr.textContent = msg;
      }

      function clearRvError() {
        rvErr.style.display = "none";
        rvErr.textContent = "";
      }

      function clearResults() {
        criteriaWrap.style.display = "none";
        embedWrap.style.display = "none";
        criteriaJson.textContent = "";
        criteriaSummary.textContent = "";
        openLink.href = "#";
        embedMount.innerHTML = "";
        clearRvError();
        areaWrap.style.display = "none";
        areaPills.innerHTML = "";
      }

      function buildRealtyVisUrl(params) {
        if (!RV_BASE) return "";
        const u = new URL(RV_BASE, window.location.origin);

        if (RV_DEFAULTS) {
          const defaults = new URLSearchParams(RV_DEFAULTS);
          defaults.forEach((v, k) => u.searchParams.set(k, v));
        }

        Object.entries(params || {}).forEach(([k, v]) => {
          if (v === null || v === undefined || v === "") return;
          if (Array.isArray(v)) u.searchParams.set(k, v.filter(Boolean).join(","));
          else u.searchParams.set(k, String(v));
        });

        return u.toString();
      }

      function mountIframe(url) {
        embedMount.innerHTML = `
          <iframe
            src="${url}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="width:100%; height:760px; border:0; border-radius:14px; overflow:hidden;"
            title="Listing results"
          ></iframe>
        `;
      }

      function mountNeighbourhoodPageIframes(entries) {
        // entries: [{ slug, title }]
        embedMount.innerHTML = entries.map(e => {
          const href = NEIGH_PAGE_BASE.replace(/\/+$/,"") + "/" + String(e.slug).replace(/^\/+/,"") + "/";
          return `
            <div class="rv-block-shell">
              <div class="rv-block-label">${escapeHtml(e.title || e.slug)}</div>
              <div class="rv-block-inner">
                <iframe
                  src="${href}"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  style="width:100%; height:760px; border:0;"
                  title="Listings - ${escapeAttr(e.title || e.slug)}"
                ></iframe>
              </div>
            </div>
          `;
        }).join("");
      }

      function escapeHtml(s) {
        return String(s ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }
      function escapeAttr(s) {
        return escapeHtml(s).replaceAll("`", "");
      }

      function fmtMoney(n) {
        const num = Number(n);
        if (!Number.isFinite(num) || num <= 0) return "";
        if (num >= 1000000) return "$" + (num / 1000000).toFixed(num % 1000000 === 0 ? 0 : 1) + "M";
        if (num >= 1000) return "$" + Math.round(num / 1000) + "K";
        return "$" + Math.round(num);
      }

      function makeSummary(c) {
        const parts = [];
        if (c?.min_beds) parts.push(c.min_beds + "+ beds");
        if (c?.min_baths) parts.push(c.min_baths + "+ baths");
        if (c?.max_price) parts.push("under " + fmtMoney(c.max_price));
        if (Array.isArray(c?.keywords) && c.keywords.length) {
          const kw = c.keywords.filter(Boolean).slice(0, 4);
          if (kw.length) parts.push(kw.join(", "));
        }
        return parts.length
          ? "Searching Fernie listings - " + parts.join(", ") + "."
          : "Searching Fernie listings based on your description.";
      }

      // --- Neighbourhood title lookup (optional, for pretty labels) ---
      let neighIndex = null;
      async function loadNeighbourhoodIndexOnce() {
        if (neighIndex !== null) return neighIndex;
        neighIndex = {};
        if (!NEIGH_URL) return neighIndex;

        try {
          const res = await fetch(NEIGH_URL, { headers: { Accept: "application/json" } });
          const raw = await res.json().catch(() => null);
          const rows =
            Array.isArray(raw) ? raw :
            Array.isArray(raw?.data) ? raw.data :
            Array.isArray(raw?.rows) ? raw.rows : [];

          for (const r of rows) {
            const slug = String(r?.slug ?? r?.Slug ?? "").trim();
            if (!slug) continue;
            const title = String(r?.title ?? r?.Title ?? r?.name ?? r?.Name ?? slug).trim();
            neighIndex[slug] = { title: title || slug };
          }
        } catch {}
        return neighIndex;
      }

      function renderAreaPills(areaSlugs, idx) {
        const list = (areaSlugs || []).map(s => String(s || "").trim()).filter(Boolean);
        if (!list.length) {
          areaWrap.style.display = "none";
          areaPills.innerHTML = "";
          return;
        }
        areaWrap.style.display = "block";
        areaPills.innerHTML = list.map(slug => {
          const label = idx?.[slug]?.title || slug;
          return '<span class="pill" data-slug="' + escapeAttr(slug) + '">' + escapeHtml(label) + "</span>";
        }).join("");
      }

      // --- Deterministic neighbourhood detection ---
      const NEIGH_ALIASES = [
        { slug: "ridgemont", patterns: ["ridgemont"] },
        { slug: "montane", patterns: ["montane"] },
        { slug: "the-airport", patterns: ["the airport", "airport"] },
        { slug: "downtown", patterns: ["downtown"] },
        { slug: "the-cedars", patterns: ["the cedars", "cedars"] },
        { slug: "parkland-terraces", patterns: ["parkland terraces", "parkland"] },
        { slug: "west-fernie", patterns: ["west fernie"] },
        { slug: "riverside", patterns: ["riverside"] },
        { slug: "skihill", patterns: ["fernie alpine ski resort", "ski resort", "ski hill", "skihill"] },
        { slug: "the-annex", patterns: ["the annex", "annex"] },
        { slug: "alpine-trails", patterns: ["alpine trails"] },
      ];

      function extractNeighbourhoodSlugs(text) {
        const t = String(text || "").toLowerCase();
        const hits = [];
        for (const item of NEIGH_ALIASES) {
          for (const p of item.patterns) {
            const pat = p.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            const re = new RegExp("(^|[^a-z0-9])" + pat + "([^a-z0-9]|$)", "i");
            if (re.test(t)) { hits.push(item.slug); break; }
          }
        }
        return Array.from(new Set(hits));
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearResults();

        const dreamText = dreamTextEl.value.trim();
        const maxPriceRaw = String(document.getElementById("maxPrice").value || "").trim() || null;
        const minBeds = cleanNum(document.getElementById("minBeds").value);
        const minBaths = cleanNum(document.getElementById("minBaths").value);

        if (!dreamText) {
          setStatus("Please enter a description.", "error");
          return;
        }

        submitBtn.disabled = true;
        setStatus("Building your search…", "loading");

        try {
          const forcedAreas = extractNeighbourhoodSlugs(dreamText);

          const res = await fetch("/api/dream-search", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ dreamText, maxPrice: maxPriceRaw, minBeds, minBaths, forcedAreas })
          });

          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data?.error || "Request failed");

          const crit = data.criteria || {};
          if (forcedAreas.length) crit.areas = forcedAreas;

          criteriaWrap.style.display = "block";
          embedWrap.style.display = "block";

          const line = makeSummary(crit);
          criteriaSummary.textContent = line;

          const idx = await loadNeighbourhoodIndexOnce();
          renderAreaPills(crit?.areas || [], idx);

          criteriaJson.textContent = JSON.stringify(crit, null, 2);

          copySummaryBtn.onclick = async () => {
            try { await navigator.clipboard.writeText(line); setStatus("Copied summary to clipboard.", "ok"); }
            catch { setStatus("Could not copy - select and copy manually.", "warn"); }
          };

          copyJsonBtn.onclick = async () => {
            try { await navigator.clipboard.writeText(JSON.stringify(crit, null, 2)); setStatus("Copied JSON to clipboard.", "ok"); }
            catch { setStatus("Could not copy - select the JSON and copy manually.", "warn"); }
          };

          const areas = Array.isArray(crit?.areas) ? crit.areas.map(String).filter(Boolean) : [];

          // ✅ MAIN CHANGE: neighbourhood results use neighbourhood pages (reliable)
          if (areas.length) {
            const entries = areas.map(slug => ({
              slug,
              title: idx?.[slug]?.title || slug
            }));
            openLink.href = "#";
            mountNeighbourhoodPageIframes(entries);
            setStatus("Here are your matches - tweak your description and re-run anytime.", "ok");
            return;
          }

          // Fallback: general search URL iframe
          const rvUrl = buildRealtyVisUrl(data.realtyvis_params || {});
          if (rvUrl) {
            openLink.href = rvUrl;
            mountIframe(rvUrl);
            setStatus("Here are your matches - tweak your description and re-run anytime.", "ok");
          } else {
            showRvError("Could not build results - check PUBLIC_REALTYVIS_SEARCH_BASE and API output.");
            setStatus("Could not build results - check settings.", "warn");
          }
        } catch (err) {
          setStatus(String(err?.message || "Couldn’t generate results right now."), "error");
        } finally {
          submitBtn.disabled = false;
        }
      });

      resetBtn.addEventListener("click", () => {
        form.reset();
        clearResults();
        setStatus("Describe your dream home to generate a search.", "idle");
      });
    });
  </script>

  <style>
    .page-shell{ max-width:1280px; margin-inline:auto; margin-top:14px; margin-bottom:40px; }
    .pad-x{ padding-inline:var(--edge-pad) !important; }
    @media(min-width:900px){ .pad-x{ padding-inline:var(--edge-pad-lg) !important; } }

    .page-intro{ max-width: var(--container-max); margin: 0 auto 10px; padding-top: 28px; }
    .crumb{ font-size: 0.8rem; opacity: 0.8; margin-bottom: 0.75rem; display:flex; flex-wrap:wrap; gap:0.35rem; justify-content:flex-end; }
    .crumb a{ text-decoration:none; border-bottom:1px solid transparent; }
    .crumb a:hover{ border-bottom-color: var(--accent); }
    .crumb-current{ opacity:0.7; }

    .title-block{ max-width: 52rem; }
    .accent-bars{ display:flex; gap:0.25rem; margin-bottom:0.75rem; }
    .accent-bar{ height:4px; border-radius:999px; background: var(--accent); }
    .accent-bar.primary{ width:80px; opacity:0.9; }
    .accent-bar.secondary{ width:40px; opacity:0.45; }

    .title-row{ display:flex; align-items:flex-start; gap:0.75rem; }
    .page-title{ margin: 0 0 6px; font-size: clamp(2.4rem, 3.8vw, 3.05rem); line-height: 1.08; font-weight: 700; letter-spacing: -0.015em; color: #111827; }
    .page-subhead{ margin: 0 0 18px; font-size: 1.06rem; line-height: 1.4; font-weight: 600; color: #6b7280; max-width: 52rem; }

    .mountain-strip{ margin: 8px auto 24px; height: 48px; max-height: 60px; border-radius: 6px; overflow: hidden; background: linear-gradient(to top, rgba(0, 0, 0, 0.02), transparent); }
    .mountain-strip svg{ width:100%; height:100%; opacity:0.9; mix-blend-mode:multiply; }

    .block{ margin-top: 14px; }
    .card{ border: 1px solid #e5e7eb; border-radius: 14px; padding: 18px 16px 16px; background: #ffffff; box-shadow: 0 4px 12px rgba(0,0,0,.04); }
    .card-title{ margin: 0 0 10px; font-size: 1.25rem; line-height: 1.25; font-weight: 700; color: #111827; }

    .form{ display:grid; gap: 12px; }
    .field{ display:grid; gap: 6px; }
    .field-full{ grid-column: 1 / -1; }

    textarea, input{ width: 100%; border-radius: 10px; border: 1px solid #d1d5db; padding: 10px 12px; font: inherit; outline: none; background: #fff; }
    textarea{ resize: vertical; min-height: 140px; }
    textarea:focus, input:focus{ border-color: rgba(79,70,229,.6); box-shadow: 0 0 0 1px rgba(79,70,229,.25); }

    .label{ font-weight: 650; font-size: 13px; color: #374151; }
    .hint{ margin: 0; font-size: 12px; color: #6b7280; }

    .row{ display:grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 12px; align-items:start; }
    @media (max-width: 900px){ .row{ grid-template-columns: 1fr; } }

    .actions{ display:flex; gap: 10px; align-items:center; flex-wrap:wrap; margin-top: 2px; }
    .btn{ border-radius: 999px; border: 1px solid rgba(0,0,0,.14); padding: 10px 14px; font-weight: 650; cursor: pointer; background: #111827; color: white; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: transform .08s ease, box-shadow .12s ease, background-color .12s ease; }
    .btn:hover{ transform: translateY(-1px); box-shadow: 0 10px 20px rgba(15,23,42,.12); background: #020617; }
    .btn.ghost{ background: rgba(255,255,255,.92); color: rgba(0,0,0,.88); }
    .btn.ghost:hover{ background: #fff; transform: translateY(-1px); box-shadow: 0 10px 20px rgba(15,23,42,.08); }
    .btn:disabled{ opacity: .6; cursor: not-allowed; transform:none; box-shadow:none; }

    .status{ padding: 10px 12px; border-radius: 12px; border: 1px solid #e5e7eb; background: #f9fafb; color: #374151; font-weight: 600; }
    .status[data-mode="loading"]{ opacity: .75; }
    .status[data-mode="error"]{ background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .status[data-mode="ok"]{ background: #ecfdf3; border-color: #bbf7d0; color: #166534; }
    .status[data-mode="warn"]{ background: #fffbeb; border-color: #fde68a; color: #92400e; }

    .criteria-head{ display:flex; align-items:center; justify-content:space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
    .summary-line{ margin: 0 0 10px; font-size: 1.02rem; line-height: 1.5; font-weight: 650; color: #111827; }

    .pill-wrap{ margin-top: 10px; padding-top: 12px; border-top: 1px solid #e5e7eb; }
    .pill-label{ font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 8px; }
    .pills{ display:flex; flex-wrap:wrap; gap:8px; }
    .pill{ display:inline-flex; align-items:center; border-radius:999px; border:1px solid color-mix(in srgb, #e5e7eb 70%, var(--accent) 30%); padding:6px 10px; font-size: 13px; font-weight: 650; background: color-mix(in srgb, #ffffff 92%, var(--accent) 8%); color: #111827; }

    .details{ margin-top: 12px; border-top: 1px solid #e5e7eb; padding-top: 12px; }
    .details summary{ cursor: pointer; font-weight: 700; color: #374151; font-size: 0.95rem; }
    .pre{ margin: 10px 0 0; padding: 12px; border-radius: 12px; background: rgba(0,0,0,.04); overflow: auto; font-size: .9rem; line-height: 1.45; }

    .embedMount{ margin-top: 10px; }

    .rvErr{
      border: 1px solid #fde68a;
      background: #fffbeb;
      color: #92400e;
      border-radius: 12px;
      padding: 10px 12px;
      font-weight: 650;
      margin-top: 10px;
    }

    .rv-block-shell{
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      overflow: hidden;
      margin-top: 12px;
      background: #fff;
    }
    .rv-block-label{
      padding: 10px 12px;
      font-weight: 750;
      border-bottom: 1px solid #e5e7eb;
      background: rgba(0,0,0,0.02);
    }
    .rv-block-inner{ padding: 0; }
    .rv-block-inner iframe{ border-radius: 0; }

    .cta{ margin-top: 18px; }
    .cta-card{ border-radius: 16px; padding: 18px; border: 1px solid #e5e7eb; background: #f9fafb; }
    .cta-card h2{ margin: 0 0 8px; }
    .cta-card p{ margin: 0 0 12px; opacity: .85; }
  </style>
</Site>
