---
// File: src/pages/areas/[slug].astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import RVEmbed from "../../components/RVEmbed.astro";
import CTAForm from "../../components/CTAForm.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";

/* ✅ use the shared strip */
import MountainStrip from "../../components/MountainStrip.astro";

/* ✅ use your central colour system (same approach as Browse/Index) */
import { CATEGORY_COLOURS, DEFAULT_ACCENT } from "../../lib/categoryColours";

/* ---------- static paths ---------- */
export async function getStaticPaths() {
  const url = import.meta.env.PUBLIC_AREAS_JSON;
  if (!url) return [];

  let rows: any[] = [];
  try {
    const raw = await getJson<any>(url);
    rows = Array.isArray(raw)
      ? raw
      : Array.isArray(raw?.data)
      ? raw.data
      : Array.isArray(raw?.rows)
      ? raw.rows
      : [];
  } catch {
    return [];
  }

  const items = rows
    .map((r: any) => {
      const status = String(r?.status ?? r?.Status ?? r?.STATUS ?? "")
        .trim()
        .toLowerCase();
      const rawSlug = String(r?.slug ?? r?.Slug ?? r?.SLUG ?? "")
        .trim()
        .toLowerCase();
      const hidden =
        status === "hidden" || status === "inactive" || rawSlug === "index";
      if (hidden) return null;

      const title = String(r?.title ?? r?.Title ?? r?.TITLE ?? "").trim();

      // inline slug logic
      const safeSlug =
        rawSlug ||
        title
          .toLowerCase()
          .trim()
          .replace(/&/g, "-and-")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");

      return safeSlug
        ? { params: { slug: safeSlug }, props: { row: r } }
        : null;
    })
    .filter(Boolean) as any[];

  return items;
}

/* ---------- helpers (match Living slug pattern) ---------- */
const get = (r: any, ...keys: string[]) => {
  for (const k of keys) {
    const v =
      r?.[k] ??
      r?.[k?.toLowerCase?.()] ??
      r?.[k?.toUpperCase?.()];
    if (v !== undefined && v !== null && String(v).trim() !== "") {
      return String(v).trim();
    }
  }
  return "";
};

function resolveImgFromCell(v: string): string {
  const s = (v ?? "").trim();
  if (!s) return "";
  if (/^https?:\/\//i.test(s)) return s;
  if (s.startsWith("/")) return s;
  return heroPath(s);
}

/* ---------- page data ---------- */
type Row = {
  title?: string; Title?: string; TITLE?: string;
  summary?: string; Summary?: string; SUMMARY?: string;
  long_copy?: string; longcopy?: string; LongCopy?: string;
  hero_img?: string; heroImg?: string; HeroImg?: string;
  seo_title?: string; seoTitle?: string;
  seo_description?: string; seoDescription?: string;
  kicker?: string; subhead?: string;
  cta1?: string; rv_block?: string; slug?: string; status?: string;
  spare_1?: string; Spare_1?: string; SPARE_1?: string;
  spare_2?: string; Spare_2?: string; SPARE_2?: string;
  spare_3?: string; Spare_3?: string; SPARE_3?: string;
};

const { row: rowIn } = Astro.props as { row?: Row };
const row = rowIn ?? ({} as Row);

const rawTitle =
  row?.title ?? row?.Title ?? row?.TITLE ?? "Area";

const title = String(rawTitle).trim();

const summary = get(row, "summary", "Summary", "SUMMARY");
const body    = get(row, "long_copy", "longcopy", "LongCopy");
const heroImg = get(row, "hero_img", "heroImg", "HeroImg");
const seoTitle =
  get(row, "seo_title", "seoTitle") || title;



/* SEO text cleaner (no truncation) */
const stripMeta = (s:string = "") =>
  s.replace(/<[^>]+>/g," ")
   .replace(/&[^;\s]+;/g," ")
   .replace(/\s+/g," ")
   .trim();

const seoDesc = stripMeta(
  get(row, "seo_description", "seoDescription") || summary || ""
);

/* ---------- kicker/subhead + intro text ---------- */
const rawKicker =
  get(row, "kicker", "Kicker", "KICKER") ||
  get(row, "subhead", "Subhead", "SUBHEAD");

const kicker = rawKicker || "Around Fernie";

const pageTitle   = title || "Area near Fernie";
const pageSubhead = kicker;

/* ---------- strip scripts from HTML content ---------- */
function stripScripts(html: string) {
  return html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");
}

const SUMMARY_IS_HTML = true;
const BODY_IS_HTML = true;

const summaryHtml = SUMMARY_IS_HTML ? stripScripts(summary) : "";
const bodyHtml    = BODY_IS_HTML    ? stripScripts(body)    : "";

/* ---------- RealtyVis listings ---------- */
const rawCta =
  get(row, "cta1", "rv_block") ||
  String(import.meta.env.PUBLIC_DEFAULT_RV_BLOCK ?? "").trim();

const ID_RE = /^[A-Z0-9]{8}-[A-Z0-9]{8}$/i;

function extractRvId(html: string) {
  const clean = stripScripts(html);
  const m = clean.match(/data-rv-block=["']?([A-Z0-9]{8}-[A-Z0-9]{8})["']?/i);
  return m?.[1] || "";
}

const rvBlockId = ID_RE.test(rawCta) ? rawCta : extractRvId(rawCta);
const hasValidBlock = ID_RE.test(rvBlockId);

/* ---------- hero resolve + preload ---------- */
/* ✅ match Browse behaviour: always have a hero (fallback if empty) */
const heroResolved = heroImg ? heroPath(heroImg) : heroPath("fallback-hero.jpg");

const heroPreload = heroResolved
  ? { href: heroResolved, imagesizes: "100vw" }
  : null;

/* ---------- accent colour for header ---------- */
/* ✅ unify with site/category system instead of per-page rainbow hash */
const headerAccent = CATEGORY_COLOURS.areas ?? DEFAULT_ACCENT;

/* ---------- Formspree ---------- */
const formspreeId = String(
  import.meta.env.PUBLIC_FORMSPREE_ID ?? "f/yourFormIdHere"
);
---

<Site
  title={seoTitle}
  seo_title={seoTitle}
  seo_description={seoDesc}
  wrapContent={false}
  heroPreload={heroPreload}
>
  {/* ACCENT HEADER – match Browse / slug treatment */}
  <div class="page-shell pad-x areas-slug">
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="area-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/areas">Areas</a>
        <span>/</span>
        <span class="area-breadcrumb-current">{pageTitle}</span>
      </nav>

      <div class="area-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{pageTitle}</h1>
        </div>

        {pageSubhead && <p class="page-subhead">{pageSubhead}</p>}
      </div>
    </section>

    {/* ✅ default mountain strip component */}
    <MountainStrip preset="default" opacity={0.11} />

    {/* ✅ default hero image block (same pattern as Browse) */}
    <div class="areas-photo">
      <img
        src={heroResolved}
        alt={`${title} near Fernie`}
        loading="eager"
        decoding="async"
      />
    </div>

    {summary && (
      <section class="summary-wrap">
        {SUMMARY_IS_HTML
          ? <div class="lead" set:html={summaryHtml}></div>
          : <p class="lead">{summary}</p>}
      </section>
    )}

   

    {/* Listings */}
    <section class="listings-wrap">
      <h2 class="h2">Current {title} Listings</h2>

      {hasValidBlock ? (
        <div class="rv-host">
          <RVEmbed block={rvBlockId} minHeight="1000px" showSkeleton={false} />
        </div>
      ) : (
        <div class="rv-fallback">
          <p><strong>Heads-up:</strong> Listings are unavailable for this page right now.</p>
          <p><a href="/search">Browse all Fernie listings</a></p>
        </div>
      )}

      {/* hover-to-warm for RV */}
      {hasValidBlock && (
        <script is:inline>
{`(function(){
  let warmed=false;
  function warm(){
    if(warmed) return; warmed=true;
    var i1=new Image(); i1.src="https://app.realtyvis.com/favicon.ico";
    var i2=new Image(); i2.src="https://cdn.realtyvis.com/favicon.ico";
    try{
      fetch("https://app.realtyvis.com/css/site.min.css",{mode:"no-cors"}).catch(()=>{});
      fetch("https://app.realtyvis.com/js/site.min.js",{mode:"no-cors"}).catch(()=>{});
    }catch(e){}
  }
  const host=document.querySelector(".rv-host")||document.querySelector(".listings-wrap");
  if(!host) return;
  ["pointerover","touchstart","focusin"].forEach(ev=>{
    host.addEventListener(ev,warm,{once:true,passive:true});
  });
})();`}
        </script>
      )}
    </section>

    {body && (
      <section class="body-wrap">
        {BODY_IS_HTML
          ? <div class="lead" set:html={bodyHtml}></div>
          : <p class="lead">{body}</p>}
      </section>
    )}

    <section class="cta-bottom-wrap">
      <CTAForm
        formId={formspreeId}
        pageSlug={Astro.params.slug}
        pageTitle={title}
      />
    </section>
  </div>

  <style>
    /* containment like Living / Blog / To-Do / Stay detail */
    .areas-slug.page-shell{
      max-width: 1280px;
      margin-inline: auto;
      margin-top: 14px;
      margin-bottom: 40px;
    }
    .areas-slug.pad-x{
      padding-inline: var(--edge-pad) !important;
    }
    @media (min-width: 900px){
      .areas-slug.pad-x{
        padding-inline: var(--edge-pad-lg) !important;
      }
    }

    /* INTRO */
    .areas-slug .page-intro{
      max-width: var(--container-max);
      margin: 0 auto 10px;
      padding-top: 28px;
    }

    .areas-slug .area-breadcrumb{
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .areas-slug .area-breadcrumb a{
      text-decoration: none;
      border-bottom: 1px solid transparent;
      color: inherit;
    }
    .areas-slug .area-breadcrumb a:hover{
      border-bottom-color: var(--accent);
    }
    .areas-slug .area-breadcrumb-current{ opacity: 0.7; }

    .areas-slug .area-title-block{ max-width: 48rem; }

    .areas-slug .accent-bars{
      display: flex;
      gap: 0.25rem;
      margin-bottom: 0.75rem;
    }
    .areas-slug .accent-bar{
      height: 4px;
      border-radius: 999px;
      background: var(--accent);
    }
    .areas-slug .accent-bar.primary{ width: 80px; opacity: 0.9; }
    .areas-slug .accent-bar.secondary{ width: 40px; opacity: 0.45; }

    .areas-slug .title-row{
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .areas-slug .page-title{
      margin: 0 0 6px;
      font-size: clamp(2.4rem, 3.8vw, 3.05rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: #111827;
    }

    /* SUBHEAD */
    .areas-slug .page-subhead{
      margin: 6px 0 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      max-width: 52rem;
    }

    /* ✅ MAIN HERO IMAGE (21:9) – match Browse */
    .areas-slug .areas-photo{
      margin: 12px 0 28px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(0,0,0,0.06);
      box-shadow: 0 18px 46px rgba(0,0,0,0.14);
    }
    .areas-slug .areas-photo img{
      width: 100%;
      aspect-ratio: 21 / 9;
      object-fit: cover;
      display: block;
    }

    .areas-slug .summary-wrap{
      padding-top: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 8px;
    }
    .areas-slug .lead{
      margin: 0;
      font-size: 1.075rem;
      line-height: 1.6;
      color: #111827;
    }
    .areas-slug .lead :where(p, ul, ol){ margin: 0 0 0.8rem; }
    .areas-slug .lead :where(a){ text-decoration: underline; }

    

    .areas-slug .listings-wrap{
      padding-top: 16px;
      padding-bottom: 8px;
    }
    .areas-slug .h2{
      font-size: clamp(20px, 2.6vw, 28px);
      margin: 0 0 10px;
      color: #111827;
    }

    .areas-slug .rv-fallback{
      margin-top: 12px;
      padding: 12px 16px;
      background: #fff3cd;
      border: 1px solid #ffe69c;
      border-radius: 10px;
      color: #5c3c00;
    }

    .areas-slug .body-wrap{
      margin-top: 20px;
    }

    .areas-slug .cta-bottom-wrap{
      padding: 18px 0 28px;
      clear: both;
    }

    .areas-slug .rv-host{ min-height: 1000px; }

    /* soften RV skeletons */
    .areas-slug .rv-host [data-skeleton],
    .areas-slug .rv-host .rv-skeleton{
      animation: none !important;
      background: none !important;
      background-image: none !important;
      box-shadow: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
    .areas-slug .rv-host .rv-root,
    .areas-slug .rv-host .rv-container,
    .areas-slug .rv-host .rv-shell{
      max-width: 1200px;
      margin-inline: auto;
    }
  </style>
</Site>
