---
export const prerender = true;

import Site from "../../layouts/Site.astro";
import HeroBleed from "../../components/HeroBleed.astro";
import RVEmbed from "../../components/RVEmbed.astro";

const seo_title = "Search Fernie Real Estate Listings";
const seo_description =
  "Live Fernie MLS® search: homes, condos, townhomes, investment properties.";

const rvBlockId = "MQP2VMLT-HDQLLMRY";
const hasValidBlock = /^[A-Z0-9]{8}-[A-Z0-9]{8}$/i.test(rvBlockId);

const heroImg = "/hero/search-hero.webp"; // you pick
---

<Site
  title="Search"
  seo_title={seo_title}
  seo_description={seo_description}
>
 

  <section class="intro-copy">
 
  </section>

  <div class="search-wrap">
    {hasValidBlock ? (
      <div class="rv-host">
        <RVEmbed block={rvBlockId} minHeight="1200px" showSkeleton={false} />
      </div>
    ) : (
      <div class="rv-fallback">
        <p>Search embed unavailable right now.</p>
        <p><a href="/neighbourhoods">Browse by neighbourhood</a></p>
      </div>
    )}
  </div>

  <style>
    .intro-copy {
      max-width: var(--container-max);
      margin-inline:auto;
      padding: 1rem var(--edge-pad) 0;
      font-size:1.1rem;
      line-height:1.5;
    }

    @media(min-width:900px){
      .intro-copy{
        padding:1rem var(--edge-pad-lg) 0;
      }
    }
  </style>
</Site>
