---
export const prerender = true;

import Site from "../layouts/Site.astro";
import { getJson } from "../lib/fetchJson";
import { heroPath } from "../lib/paths";

const PATH_BASE = "/contact";

/* helpers */
const RESERVED = new Set(["index","page","pages","all","view","list"]);
const get = (r:any,k:string)=>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "").toString().trim();

const slugify = (v:string) =>
  (v ?? "").toLowerCase().trim()
    .replace(/&/g,"-and-")
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"");

const visible = (r:any) => {
  const s = get(r,"status").toLowerCase();
  const rawSlug = get(r,"slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
};

const stripMeta = (s:string = "") =>
  s
    .replace(new RegExp("<[^>]*>", "g"), " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

/* html safe + excerpt */
const stripScripts = (html:string = "") =>
  html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");

const stripTags = (s:string = "") =>
  s
    .replace(new RegExp("<[^>]*>", "g"), " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const excerpt = (s:string,n=140)=>{
  const t = stripTags(s);
  return t.length>n ? t.slice(0,n-1).trimEnd()+"…" : t;
};

const pickCardImg = (r:any) =>
  get(r,"card_img") || get(r,"card") || get(r,"card_src") || get(r,"cardimg") || "";

const resolveCard = (v:string) => {
  const s = (v ?? "").trim();
  if (!s) return "";
  if (/^https?:\/\//i.test(s)) return s;
  if (s.startsWith("/")) return s;
  return heroPath(s);
};

const accentPalette = [
  "#0ea5e9",
  "#22c55e",
  "#6366f1",
  "#f97316",
  "#eab308",
  "#0f766e",
  "#14b8a6"
];

const accentForStay = (key:string = "") => {
  const s = (key || "contact").toLowerCase();
  let hash = 0;
  for (let i = 0; i < s.length; i++) {
    hash = (hash + s.charCodeAt(i)) % accentPalette.length;
  }
  return accentPalette[hash];
};

/* Types */
type Row={
  slug?:string;
  title?:string;
  summary?:string;
  long_copy?:string;
  hero_img?:string;
  card_img?:string;
  status?:string;
  seo_title?:string;
  seo_description?:string;
  sort?:number|string;
};

let items:Row[] = [];
let header:Row|null = null;
let error:string|null = null;

try {
  const url = import.meta.env.PUBLIC_CONTACTCRUMP_JSON;
  if (!url) throw new Error("Missing PUBLIC_CONTACTCRUMP_JSON");

  const raw = await getJson<any>(url);
  const rows:any[] =
    Array.isArray(raw) ? raw :
    Array.isArray(raw?.data) ? raw.data :
    Array.isArray(raw?.rows) ? raw.rows : [];

  const headerCandidates = rows.filter(r => {
    const slug = get(r,"slug").toLowerCase();
    const status = get(r,"status").toLowerCase();
    const has =
      !!get(r,"summary") ||
      !!get(r,"long_copy") ||
      !!get(r,"seo_description") ||
      !!get(r,"description") ||
      !!get(r,"subhead");
    return slug==="index" || status==="header" || has;
  });

  header =
    headerCandidates.find(r => get(r,"slug").toLowerCase()==="index") ??
    headerCandidates.find(r => get(r,"status").toLowerCase()==="header") ??
    headerCandidates[0] ?? null;

  items = rows
    .filter(r => visible(r))
    .map(r => ({
      slug: get(r,"slug") || slugify(get(r,"title")),
      title: get(r,"title"),
      summary: get(r,"summary"),
      hero_img: get(r,"hero_img"),
      card_img: pickCardImg(r),
      sort: +get(r,"sort") || Number.MAX_SAFE_INTEGER,
      seo_title: get(r,"seo_title"),
      seo_description: get(r,"seo_description"),
    }))
    .filter(r => r.slug && r.title)
    .sort((a,b) => (Number(a.sort) - Number(b.sort)) || a.title!.localeCompare(b.title!));

} catch (e:any) {
  error = e?.message || "Failed to load data.";
}

const pageTitle   = get(header,"title") || "Contact Chris Crump";
const pageSubhead =
  get(header,"subhead") ||
  "Real answers. Quick replies. Local Fernie real estate guidance whenever you need it.";

const pageSummary =
  get(header,"summary") ||
  get(header,"seo_description") ||
  get(header,"description") ||
  "";

const seoTitle    = get(header,"seo_title") || pageTitle;
const rawSeoDesc  = get(header,"seo_description") || pageSummary || "";
const seoDesc     = stripMeta(rawSeoDesc);

const summaryHtml = stripScripts(pageSummary);

/* header accent (blog/to_do index style) */
const headerAccent = "#0ea5e9";
---

<Site
  title={seoTitle}
  seo_title={seoTitle}
  seo_description={seoDesc}
  wrapContent={false}
>
  <div class="page-shell pad-x">
    {/* INTRO HEADER - blog index style (accent bars, no hero image) */}
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="crumb">
        <a href="/">Home</a>
        <span>/</span>
        <span class="crumb-current">Contact</span>
      </nav>

      <div class="title-block">
        <div class="accent-bars" aria-hidden="true">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{pageTitle}</h1>
        </div>

        <p class="page-subhead">{pageSubhead}</p>
      </div>
    </section>

    {/* FADED MOUNTAIN STRIP */}
    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeContact" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeContact)"
        />
      </svg>
    </div>

    {pageSummary && (
      <div class="summary-wrap">
        <div class="lead" set:html={summaryHtml}></div>
      </div>
    )}

   


    {error && <p class="err">{error}</p>}

    {!error && (
      <>
        <div class="longcopy-wrap">
          {/* CONTACT FORM */}
          <div class="contact-form-wrap">
            <h2>Send a message</h2>
            <p class="contact-form-intro">
              Prefer not to call or text right away? Use this quick form and I’ll get back to you as soon as I can.
            </p>

            <form id="contact-form" action="https://formspree.io/f/xqajpnvo" method="POST">
              <input type="hidden" name="_subject" value="New message from fernie.homes contact form" />
              <input type="hidden" name="_redirect" value="https://fernie.homes/contact/thanks" />

              <div class="contact-form-grid">
                <div class="field">
                  <label for="name">Name</label>
                  <input id="name" name="name" type="text" autocomplete="name" required />
                </div>

                <div class="field">
                  <label for="email">Email</label>
                  <input id="email" name="email" type="email" autocomplete="email" required />
                </div>

                <div class="field">
                  <label for="phone">Phone (optional)</label>
                  <input id="phone" name="phone" type="tel" autocomplete="tel" />
                </div>

                <div class="field">
                  <label for="reason">What are you curious about?</label>
                  <select id="reason" name="reason">
                    <option value="">Choose one…</option>
                    <option value="buying">Buying in Fernie</option>
                    <option value="selling">Selling in Fernie</option>
                    <option value="investing">Investment / revenue property</option>
                    <option value="relocating">Relocating to Fernie</option>
                    <option value="general">Just starting research</option>
                    <option value="other">Something else</option>
                  </select>
                </div>

                

                <div class="field field-full">
                  <label for="message">Tell me a bit about your plans</label>
                  <textarea id="message" name="message" rows="5" required></textarea>
                </div>

                <div class="field field-full field-inline">
                  <label class="checkbox-label">
                    <input type="checkbox" name="ok_to_text" value="yes" checked />
                    <span>It’s OK to text me about Fernie real estate.</span>
                  </label>
                </div>
              </div>

              <button type="submit" class="contact-submit">Send message to Chris</button>

              <div id="contact-status" class="contact-status" aria-live="polite" hidden></div>
            </form>
             
          </div>
          <div class="summary-image">
  <img
    src="https://imagedelivery.net/Az3x6Ld2gouPPtikaqezkQ/982ef91a-a646-416f-1b95-c3455eb3f000/card"
    alt="Contact Chris Crump – Fernie real estate"
    loading="eager"
    decoding="async"
  />
</div>

          {/* INFO GRID BELOW FORM */}
          <div class="contact-info-grid">
            <div class="info-col longcopy">
              <h2>Looking for Something Specific?</h2>
              <p>I can help with:</p>
              <ul>
                <li>Buying your next home in Fernie</li>
                <li>Investment and revenue property strategy</li>
                <li>Neighbourhood insights and lifestyle fit</li>
                <li>Market evaluations for your property</li>
                <li>Short-term and long-term rental guidance</li>
                <li>New construction and building considerations</li>
              </ul>
              <p>
                <em>
                  Talk soon - and if you’re already in Fernie, I’m happy to meet for a coffee and
                  chat through your plans.
                </em>
              </p>
            </div>

            <div class="info-col longcopy">
              <h2>Ways to Reach Me</h2>
              <ul>
                <li>Call or Text: <a href="tel:2506190390">250 619 0390</a></li>
                <li>Email: <a href="mailto:chris@crump.ca">chris@crump.ca</a></li>
              </ul>

              <h2>Office Details</h2>
              <p>
                Chris Crump Personal Real Estate Corporation<br />
                Licensed Realtor® with <strong>460 Realty</strong>
              </p>
            </div>
          </div>
        </div>

        {/* OPTIONAL cards below (kept from your original page) */}
        <div class="grid">
          {items.map(it => {
            const cardSrc =
              resolveCard(it.card_img || "") ||
              (it.hero_img ? heroPath(it.hero_img) : "");

            const key = it.slug || it.title || "";
            const accent = accentForStay(key);

            return (
              <a
                class="card"
                href={`${PATH_BASE}/${it.slug}`}
                data-astro-prefetch="hover"
                aria-label={it.title}
                style={`--accent:${accent};`}
              >
                {cardSrc && (
                  <img src={cardSrc} alt={it.title} loading="lazy" decoding="async" />
                )}
                <div class="body">
                  <h2>{it.title}</h2>
                  {it.summary && <p>{excerpt(it.summary,140)}</p>}
                </div>
              </a>
            );
          })}
        </div>
      </>
    )}
  </div>

  <style>
    .page-shell{
      max-width:1280px;
      margin-inline:auto;
      margin-top:14px;
      margin-bottom:40px;
    }
    .pad-x{
      padding-inline:var(--edge-pad) !important;
    }
    @media(min-width:900px){
      .pad-x{ padding-inline:var(--edge-pad-lg) !important; }
    }

    /* INTRO - blog/to_do style */
    .page-intro{
      max-width: var(--container-max);
      margin: 0 auto 10px;
      padding-top: 28px;
    }

    .crumb{
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 0.75rem;
      display:flex;
      flex-wrap:wrap;
      gap:0.35rem;
    }
    .crumb a{
      text-decoration:none;
      border-bottom:1px solid transparent;
    }
    .crumb a:hover{
      border-bottom-color: var(--accent);
    }
    .crumb-current{ opacity:0.7; }

    .title-block{ max-width: 48rem; }

    .accent-bars{
      display:flex;
      gap:0.25rem;
      margin-bottom:0.75rem;
    }
    .accent-bar{
      height:4px;
      border-radius:999px;
      background: var(--accent);
    }
    .accent-bar.primary{ width:80px; opacity:0.9; }
    .accent-bar.secondary{ width:40px; opacity:0.45; }

    .title-row{
      display:flex;
      align-items:flex-start;
      gap:0.75rem;
    }

    .page-title{
      margin: 0 0 6px;
      font-size: clamp(2.4rem, 3.8vw, 3.05rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: #111827;
    }
    .page-subhead{
      margin: 0 0 18px;
      font-size: 1.06rem;
      line-height: 1.4;
      font-weight: 600;
      color: var(--ink-muted, #6b7280);
      max-width: 52rem;
      text-transform: none;
    }

    .mountain-strip{
      margin: 8px auto 24px;
      height: 48px;
      max-height: 60px;
      border-radius: 6px;
      overflow: hidden;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.02), transparent);
    }
    .mountain-strip svg{
      width:100%;
      height:100%;
      opacity:0.9;
      mix-blend-mode:multiply;
    }

    /* SUMMARY */
    .summary-wrap{
      padding-top:12px;
      padding-bottom:25px;
      border-bottom:1px solid #e5e7eb;
      margin-bottom:10px;
    }
    .lead{
      margin:0;
      font-size:1.075rem;
      line-height:1.6;
      color:#111827;
    }

    .longcopy-wrap{
      padding-top: 10px;
      padding-bottom: 24px;
      margin-bottom: 24px;
    }

    .longcopy{
      font-size: 1.075rem;
      line-height: 1.6;
      color: #111827;
    }
    .longcopy p{ margin: 0 0 0.8em; }
    .longcopy ul,
    .longcopy ol{
      margin: 0 0 1em 1.25em;
      padding: 0;
    }

    .contact-form-wrap{
      margin-top: 20px;
      padding: 18px 16px 16px;
      border-radius: 14px;
      border: 1px solid #e5e7eb;
      background: #f9fafb;
    }
    .contact-form-wrap h2{
      margin: 0 0 4px;
      font-size: 1.25rem;
      line-height: 1.3;
      font-weight: 600;
      color: #111827;
    }
    .contact-form-intro{
      margin: 0 0 14px;
      font-size: .98rem;
      line-height: 1.5;
      color: #4b5563;
    }

    .contact-form-grid{
      display:grid;
      grid-template-columns: 1fr;
      gap: 12px 16px;
      margin-bottom: 16px;
    }
    @media (min-width: 800px){
      .contact-form-grid{
        grid-template-columns: repeat(2, minmax(0,1fr));
      }
      .field-full{ grid-column: 1 / -1; }
    }

    .field{
      display:flex;
      flex-direction:column;
      gap:4px;
    }
    .field label{
      font-size:.9rem;
      font-weight:500;
      color:#374151;
    }
    .field input,
    .field select,
    .field textarea{
      border-radius:10px;
      border:1px solid #d1d5db;
      padding:8px 10px;
      font-size:.98rem;
      line-height:1.4;
      color:#111827;
      background-color:#ffffff;
    }
    .field input:focus,
    .field select:focus,
    .field textarea:focus{
      outline:none;
      border-color:#4f46e5;
      box-shadow:0 0 0 1px rgba(79,70,229,.3);
    }

    .field-inline{
      flex-direction:row;
      align-items:center;
      gap:8px;
    }
    .checkbox-label{
      display:flex;
      align-items:center;
      gap:8px;
      font-size:.9rem;
      color:#4b5563;
    }
    .checkbox-label input{
      width:16px;
      height:16px;
    }

    .contact-submit{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius:999px;
      border:none;
      padding:9px 18px;
      font-size:.98rem;
      font-weight:600;
      cursor:pointer;
      background:#111827;
      color:#f9fafb;
      transition:
        background-color .12s ease,
        transform .08s ease,
        box-shadow .12s ease;
    }
    .contact-submit:hover{
      background:#020617;
      transform:translateY(-1px);
      box-shadow:0 8px 18px rgba(15,23,42,.18);
    }

    .contact-status{
      margin-top: 10px;
      font-size: 0.95rem;
      line-height: 1.4;
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid transparent;
      background: #f9fafb;
      color: #4b5563;
    }
    .contact-status.is-success{
      border-color:#22c55e;
      background:#ecfdf3;
      color:#166534;
    }
    .contact-status.is-error{
      border-color:#ef4444;
      background:#fef2f2;
      color:#b91c1c;
    }

    #contact-form.is-submitted{
      opacity:1;
      pointer-events:none;
    }

    .contact-info-grid{
      display:grid;
      grid-template-columns:minmax(0, 1.1fr) minmax(0, 1.4fr);
      gap:40px;
      margin-top:48px;
      align-items:flex-start;
    }
    @media (max-width:900px){
      .contact-info-grid{
        grid-template-columns:1fr;
        gap:24px;
      }
    }
    .info-col h2{
      margin-top:0;
      margin-bottom:0.5em;
      font-size:1.25rem;
      line-height:1.3;
      font-weight:600;
      color:#111827;
    }

    .err{
      color:#b91c1c;
      background:#fee2e2;
      padding:.75rem 1rem;
      border-radius:.5rem;
      margin-top:12px;
    }

    /* cards grid (same as before) */
    .grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:16px;
      margin-top:18px;
      margin-bottom:52px;
    }
    @media(max-width:1200px){ .grid{grid-template-columns:repeat(3,minmax(0,1fr));} }
    @media(max-width:900px){ .grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
    @media(max-width:560px){ .grid{grid-template-columns:1fr;} }

    .card{
      --accent:#4b5563;
      display:flex;
      flex-direction:column;
      background:#fff;
      border:1px solid #e5e7eb;
      border-radius:14px;
      overflow:hidden;
      text-decoration:none;
      color:inherit;
      transition:
        transform .08s ease,
        box-shadow .12s ease,
        border-color .12s ease,
        background-color .12s ease;
      box-shadow:0 4px 12px rgba(0,0,0,.04);
    }
    .card:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 18px rgba(0,0,0,.10);
      border-color:var(--accent);
      background:color-mix(in srgb, #ffffff 96%, var(--accent) 4%);
    }
    .card img{
      width:100%;
      aspect-ratio:16/9;
      object-fit:cover;
      display:block;
      border-bottom:1px solid color-mix(in srgb, #e5e7eb 70%, var(--accent) 30%);
    }
    .card .body{ padding:12px; }
    .card .body h2{
      margin:0 0 6px;
      font-size:1.05rem;
      line-height:1.3;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
      text-overflow:ellipsis;
      min-height:calc(2 * 1.3em);
    }
    .card .body p{
      margin:0;
      color:#374151;
      line-height:1.35;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
      text-overflow:ellipsis;
      min-height:calc(2 * 1.35em);
    }

  .summary-image{
  width: 100%;
  margin: 22px 0 32px;
  border-radius: 6px;
  overflow: hidden;
}

.summary-image img{
  width: 100%;
  height: auto;
  display: block;
  border-radius: 6px;
}


  </style>

  <script>
    if (typeof window !== "undefined") {
      window.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("contact-form");
        const statusEl = document.getElementById("contact-status");

        if (!form || !statusEl) return;

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          statusEl.hidden = false;
          statusEl.textContent = "Sending your message…";
          statusEl.classList.remove("is-error", "is-success");

          const formData = new FormData(form);

          try {
            const res = await fetch(form.action, {
              method: form.method,
              body: formData,
              headers: { Accept: "application/json" },
            });

            if (res.ok) {
              form.reset();
              form.classList.add("is-submitted");
              statusEl.textContent =
                "Thanks for reaching out - I’ve got your message and I’ll get back to you as soon as I can.";
              statusEl.classList.add("is-success");
            } else {
              statusEl.textContent =
                "Hmm, something went wrong. Please try again or email me at chris@crump.ca.";
              statusEl.classList.add("is-error");
            }
          } catch (err) {
            statusEl.textContent =
              "Network hiccup. Please try again in a moment or email me directly at chris@crump.ca.";
            statusEl.classList.add("is-error");
          }
        });
      });
    }
  </script>
</Site>
