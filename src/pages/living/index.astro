---
// File: src/pages/living/index.astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";
import ListingsAccordion from "../../components/ListingsAccordion.astro";
import { DEFAULT_ACCENT } from "../../lib/categoryColours";

const PATH_BASE = "/living";

/* helpers */
const RESERVED = new Set(["index","page","pages","all","view","list"]);
const get = (r:any,k:string)=>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "").toString().trim();
const slugify = (v:string) =>
  (v ?? "").toLowerCase().trim()
    .replace(/&/g,"-and-")
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"");

const visible = (r:any) => {
  const s = get(r,"status").toLowerCase();
  const rawSlug = get(r,"slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
};

const stripMeta = (s:string="") =>
  s.replace(/<[^>]*>/g," ")
   .replace(/&[^;\s]+;/g," ")
   .replace(/\s+/g," ")
   .trim();

/* html safe + excerpt */
const stripScripts=(html:string)=>html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,"");
const stripTags=(s:string="")=>
  s.replace(/<[^>]*>/g," ")
   .replace(/&[^;\s]+;/g," ")
   .replace(/\s+/g," ")
   .trim();
const excerpt=(s:string,n=240)=>{
  const t=stripTags(s);
  return t.length>n ? t.slice(0,n-1).trimEnd()+"…" : t;
};

/** Accept any of these sheet keys for the card image */
const pickCardImg = (r:any) =>
  get(r,"card_img") || get(r,"card") || get(r,"card_src") || get(r,"cardimg") || "";

/** If absolute URL keep; else resolve via heroPath */
const resolveCard = (v:string) => {
  const s = (v ?? "").trim();
  if (!s) return "";
  if (/^https?:\/\//i.test(s)) return s;
  if (s.startsWith("/")) return s;
  return heroPath(s);
};

/** Types */
type Row={
  slug?:string; title?:string; summary?:string; long_copy?:string; subhead?:string;
  hero_img?:string; card_img?:string; status?:string; seo_title?:string; seo_description?:string;
  category?:string; sort?:number|string;
};

let items:Row[]=[]; let header:Row|null=null; let error:string|null=null;

try{
  const url=import.meta.env.PUBLIC_LIVING_JSON;
  if(!url) throw new Error("Missing PUBLIC_LIVING_JSON");
  const raw=await getJson<any>(url);
  const rows:any[] =
    Array.isArray(raw) ? raw :
    Array.isArray(raw?.data) ? raw.data :
    Array.isArray(raw?.rows) ? raw.rows : [];

  const headerCandidates=rows.filter(r=>{
    const slug=get(r,"slug").toLowerCase();
    const status=get(r,"status").toLowerCase();
    const has=!!get(r,"summary")
      || !!get(r,"long_copy")
      || !!get(r,"seo_description")
      || !!get(r,"description")
      || !!get(r,"subhead");
    return slug==="index" || status==="header" || has;
  });

  header=headerCandidates.find(r=>get(r,"slug").toLowerCase()==="index")
    ?? headerCandidates.find(r=>get(r,"status").toLowerCase()==="header")
    ?? headerCandidates[0] ?? null;

  items=rows
    .filter(r=>visible(r))
    .map(r=>({
      slug: get(r,"slug") || slugify(get(r,"title")),
      title: get(r,"title"),
      summary: get(r,"summary"),
      hero_img: get(r,"hero_img"),
      card_img: pickCardImg(r),
      sort: +get(r,"sort") || Number.MAX_SAFE_INTEGER,
      seo_title: get(r,"seo_title"),
      seo_description: get(r,"seo_description"),
      category: (get(r,"category") || get(r,"cat") || get(r,"type")).toLowerCase() || "other",
    }))
    .filter(r=>r.slug && r.title)
    .sort((a, b) => Number(b.sort) - Number(a.sort));

  // Shuffle the items array
  for (let i = items.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [items[i], items[j]] = [items[j], items[i]];
  }

}catch(e:any){
  error=e?.message||"Failed to load data.";
}

/* Page-level fields from header row */
const pageTitle   = get(header,"title") || "Living in Fernie";
const pageSubhead = get(header,"subhead") || "";
const pageSummary = get(header,"summary")
  || get(header,"long_copy")
  || get(header,"seo_description")
  || get(header,"description")
  || "";

const seoTitle   = get(header,"seo_title") || pageTitle;
const rawSeoDesc = get(header,"seo_description") || pageSummary || "";
const seoDesc    = stripMeta(rawSeoDesc);

/* summary rendering */
const summaryHtml = stripScripts(pageSummary);

/* listings accordion copy + block sources (from header row) */
const listingsLabel = "Explore NEW Fernie Real Estate Listings";
const listingsSub   = "See the newest listings currently active on the MLS.";
const headerCTA1    = get(header,"cta1") || get(header,"CTA1");
const headerBlock   = get(header,"rv_block_id") || get(header,"rv_block");

/* Build category list for pills */
const categories = Array.from(new Set(items.map(i=>i.category || "other")))
  .filter(Boolean)
  .sort((a,b)=>a.localeCompare(b));
const initialCat = new URL(Astro.request.url).searchParams.get("cat")?.toLowerCase() || "all";

/* Accent colour per category (stable hash -> palette) */
const accentPalette = ["#0ea5e9","#22c55e","#6366f1","#f97316","#eab308","#0f766e","#14b8a6"];
const accentForCategory = (cat:string="other") => {
  const s = (cat || "other").toLowerCase();
  let hash = 0;
  for (let i = 0; i < s.length; i++) {
    hash = (hash + s.charCodeAt(i)) % accentPalette.length;
  }
  return accentPalette[hash];
};

/* ✅ Page header accent should be site accent (not green / random) */
const headerAccent = DEFAULT_ACCENT;

/* show more */
const SHOW_STEP = 12;
---

<Site
  title={seoTitle}
  seo_title={seoTitle}
  seo_description={seoDesc}
  wrapContent={false}
>
  <div class="page-shell pad-x">
    {/* INTRO HEADER – BLOG-STYLE */}
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="blog-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span class="blog-breadcrumb-current">Living in Fernie</span>
      </nav>

      <div class="blog-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          {pageTitle && <h1 class="page-title">{pageTitle}</h1>}
        </div>

        {pageSubhead && <p class="page-subhead">{pageSubhead}</p>}
      </div>
    </section>

    {/* FADED MOUNTAIN STRIP – jaggy version */}
    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeLiving" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
           ublin
            L0 20
            Z
          "
          fill="url(#mountainFadeLiving)"
        />
      </svg>
    </div>

    {pageSummary && (
      <section class="summary-wrap">
        <div class="lead" set:html={summaryHtml}></div>
      </section>
    )}

    {error && <p class="err">{error}</p>}

    {!error && (
      <>
        {/* SEARCH (blog-style) */}
        <div class="searchbar" aria-label="Search living guides">
          <div class="searchrow">
            <label class="sr-only" for="livingSearch">Search guides</label>
            <input
              id="livingSearch"
              class="search-input"
              type="search"
              inputmode="search"
              autocomplete="off"
              placeholder="Search guides…"
            />
            <button class="search-clear" type="button" aria-label="Clear search" hidden>
              ✕
            </button>
          </div>
          <div class="search-meta" aria-live="polite"></div>
        </div>

        {/* Filter pills – match Blog index structure */}
        <div class="filters">
          <div class="chips" role="tablist" aria-label="Filter Living guides by category">
            <button
              class={`chip ${initialCat === "all" ? "chip-active" : ""}`}
              data-cat="all"
              role="tab"
              aria-selected={initialCat === "all"}
            >
              All
            </button>

            {categories.map((cat) => {
              const accent = accentForCategory(cat);
              return (
                <button
                  class={`chip ${initialCat === cat ? "chip-active" : ""}`}
                  data-cat={cat}
                  role="tab"
                  aria-selected={initialCat === cat}
                  style={`--accent:${accent};`}
                >
                  {cat}
                </button>
              );
            })}
          </div>
        </div>

        {/* Cards */}
        <div class="posts-grid" id="livingGrid">
          {items.map(it=>{
            const cardSrc = resolveCard(it.card_img || "") || (it.hero_img ? heroPath(it.hero_img) : "");
            const cat = it.category || "other";
            const hidden = initialCat!=="all" && initialCat!==cat;
            const accent = accentForCategory(cat);
            const styleStr = hidden
              ? `display:none;--accent:${accent};`
              : `--accent:${accent};`;

            return (
              <a
                class="post-card"
                href={`${PATH_BASE}/${it.slug}`}
                data-astro-prefetch="hover"
                aria-label={it.title}
                data-cat={cat}
                style={styleStr}
              >
                {cardSrc && (
                  <div class="pc-media">
                    <img src={cardSrc} alt={it.title} loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="pc-body">
                  <div class="pc-meta">
                    <span class="pc-date">Living guide</span>
                    <span class="pc-pill">{cat}</span>
                  </div>
                  <h3 class="pc-title">{it.title}</h3>
                  {it.summary && <p class="pc-excerpt">{excerpt(it.summary,240)}</p>}
                </div>
              </a>
            );
          })}
        </div>

        {/* SHOW MORE */}
        {items.length > SHOW_STEP && (
          <div class="showmore-wrap">
            <button id="livingShowMore" class="showmore-btn" type="button">
              Show more
            </button>
            <div class="showmore-meta" aria-live="polite"></div>
          </div>
        )}

        <div class="living-accordion">
          <ListingsAccordion
            container={false}
            label={listingsLabel}
            subline={listingsSub}
            cta1={headerCTA1}
            block={headerBlock}
          />
        </div>
      </>
    )}
  </div>

  <style>
    .living-accordion { margin-top: 8px; }

    .page-shell{
      max-width: 1280px;
      margin-inline: auto;
      margin-top: 14px;
      margin-bottom: 40px;
    }

    .pad-x{ padding-inline: var(--edge-pad) !important; }
    @media (min-width: 900px){ .pad-x{ padding-inline: var(--edge-pad-lg) !important; } }

    /* INTRO HEADER – BLOG STYLE */
    .page-intro{
      max-width: var(--container-max);
      margin: 0 auto 10px;
      padding-top: 28px;
    }

    .blog-breadcrumb{
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .blog-breadcrumb a{
      text-decoration: none;
      border-bottom: 1px solid transparent;
      color: inherit; /* prevent purple visited links */
    }
    .blog-breadcrumb a:visited{ color: inherit; }
    .blog-breadcrumb a:hover{ border-bottom-color: var(--accent); }
    .blog-breadcrumb-current{ opacity: 0.7; }

    .blog-title-block{ max-width: 48rem; }

    .accent-bars{ display: flex; gap: 0.25rem; margin-bottom: 0.75rem; }
    .accent-bar{ height: 4px; border-radius: 999px; background: var(--accent); }
    .accent-bar.primary{ width: 80px; opacity: 0.9; }
    .accent-bar.secondary{ width: 40px; opacity: 0.45; }

    .title-row{ display: flex; align-items: flex-start; gap: 0.75rem; }

    .page-title{
      margin: 0 0 6px;
      font-size: clamp(2.4rem, 3.8vw, 3.05rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: #111827;
    }

    /* BLOG-STYLE SUBHEAD (uppercase accent) */
    .page-subhead{
      margin: 6px 0 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
    }

    .mountain-strip{
      margin: 8px auto 24px;
      height: 48px;
      max-height: 60px;
      border-radius: 6px;
      overflow: hidden;
      background: linear-gradient(to top, rgba(0,0,0,0.02), transparent);
    }
    .mountain-strip svg{ width: 100%; height: 100%; opacity: 0.9; mix-blend-mode: multiply; }

    .summary-wrap{
      padding-top: 12px;
      padding-bottom: 25px;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 20px;
    }

    .lead{
      margin: 0;
      font-size: 1.075rem;
      line-height: 1.6;
      color: #111827;
    }

    .err{
      color: #b91c1c;
      background: #fee2e2;
      padding: .75rem 1rem;
      border-radius: .5rem;
      margin-top: 12px;
    }

    /* SEARCH (match blog index) */
    .searchbar{
      max-width: 54rem;
      margin: 6px 0 18px;
    }

    .searchrow{
      position: relative;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .search-input{
      width: 100%;
      padding: 10px 42px 10px 14px;
      border-radius: 999px;
      border: 1px solid #e2e4e8;
      background: #fff;
      font-size: 0.95rem;
      line-height: 1.2;
      outline: none;
      transition: border-color .15s ease, box-shadow .15s ease;
    }

    .search-input:focus{
      border-color: color-mix(in srgb, var(--accent) 45%, #e2e4e8);
      box-shadow: 0 10px 24px rgba(0,0,0,0.06);
    }

    .search-clear{
      position: absolute;
      right: 10px;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border: 1px solid #e2e4e8;
      background: #fff;
      color: #374151;
      cursor: pointer;
      display: grid;
      place-items: center;
    }

    .search-clear:hover{
      background: #f6f8fb;
    }

    .search-meta{
      margin-top: 8px;
      font-size: 0.82rem;
      color: #6b7280;
    }

    /* screen-reader utility */
    .sr-only{
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      white-space:nowrap;
      border:0;
    }

    /* FILTER CHIPS */
    .filters{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin: 0 0 18px;
    }
    .chips{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    .chip{
      --accent:#4b5563;
      border:1px solid #e2e4e8;
      background:#fff;
      border-radius:999px;
      padding:6px 10px;
      font-size:.85rem;
      color:#374151;
      cursor:pointer;
      appearance:none;
      transition:
        background .15s ease,
        border-color .15s ease,
        color .15s ease,
        transform .08s ease;
    }
    .chip:hover{
      background:#f5f7fa;
      transform: translateY(-1px);
    }
    .chip-active{
      background:#eef2f7;
      color:#1f2d3d;
      border-color:#dde2e8;
    }

    .chip[data-cat]:not([data-cat="all"]){
      border-color: var(--accent, #e2e4e8);
    }
    .chip-active[data-cat]:not([data-cat="all"]){
      background: color-mix(in srgb,#ffffff 70%,var(--accent, #e5e7eb) 30%);
      border-color: var(--accent, #e5e7eb);
      color:#111827;
    }

    .posts-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:18px;
      margin-top:12px;
      margin-bottom:52px;
    }
    @media(max-width:900px){
      .posts-grid{ grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media(max-width:560px){
      .posts-grid{ grid-template-columns:1fr; }
    }

    .post-card{
      --accent:#4b5563;
      display:flex;
      flex-direction:column;
      background:#fff;
      border:1px solid #e2e4e8;
      border-radius:16px;
      overflow:hidden;
      text-decoration:none;
      color:inherit;
      box-shadow:0 6px 18px rgba(0,0,0,.08);
      transition:
        transform .12s ease,
        box-shadow .15s ease,
        border-color .15s ease,
        background-color .15s ease;
      position: relative;
    }

    /* always-on thin accent line (BOTTOM so it doesn't fight the image) */
    .post-card::after{
      content:"";
      position:absolute;
      left:0;
      right:0;
      bottom:0;
      height:4px;
      background: linear-gradient(
        90deg,
        var(--accent),
        color-mix(in srgb, var(--accent) 40%, #ffffff)
      );
      opacity:.85;
      z-index: 3;
      pointer-events: none;
    }
    .post-card:hover::after{
      height: 6px;
      opacity: 1;
    }

    .post-card:hover{
      transform:translateY(-2px);
      box-shadow:0 10px 24px rgba(0,0,0,.12);
      border-color:var(--accent);
      background:color-mix(in srgb, #ffffff 94%, var(--accent) 6%);
    }

    .post-card .pc-media{
      position:relative;
      width:100%;
      aspect-ratio: 5 / 2;
      z-index: 0;
    }
    .post-card .pc-media > img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .pc-body{ padding:12px 14px 14px; position: relative; z-index: 2; }

    .pc-meta{
      display:flex;
      align-items:center;
      gap:8px;
      margin-bottom:6px;
      font-size:.82rem;
      color:#6b7280;
    }

    .pc-pill{
      display:inline-flex;
      align-items:center;
      padding:3px 8px;
      border-radius:999px;
      font-size:.75rem;
      text-transform:lowercase;
      background:color-mix(in srgb, #ffffff 86%, var(--accent) 14%);
      color:var(--accent);
    }

    .pc-title{
      margin:2px 0 6px;
      font-size:1.05rem;
      line-height:1.3;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
      text-overflow:ellipsis;
      min-height:calc(2 * 1.3em);
    }

    .pc-excerpt{
      margin:0;
      color:#4b5563;
      line-height:1.45;
      display:-webkit-box;
      -webkit-line-clamp:4;
      -webkit-box-orient:vertical;
      overflow:hidden;
      text-overflow:ellipsis;
      min-height:calc(4 * 1.45em);
    }

    /* SHOW MORE */
    .showmore-wrap{
      display: grid;
      place-items: center;
      gap: 10px;
      margin-top: -22px;
      margin-bottom: 34px;
    }

    .showmore-btn{
      border: 1px solid #e2e4e8;
      background: #fff;
      border-radius: 999px;
      padding: 10px 16px;
      font-size: 0.92rem;
      font-weight: 650;
      cursor: pointer;
      transition: transform .08s ease, box-shadow .15s ease, background .15s ease;
      box-shadow: 0 10px 24px rgba(0,0,0,0.06);
    }
    .showmore-btn:hover{
      transform: translateY(-1px);
      background: #f6f8fb;
      box-shadow: 0 12px 28px rgba(0,0,0,0.10);
    }

    .showmore-meta{
      font-size: 0.85rem;
      color: #6b7280;
    }
  </style>

  <script type="module">
  function initLivingPills() {
    // Avoid double-binding across ViewTransitions swaps
    try { window.__livingPillsAbort?.abort?.(); } catch {}
    const ac = new AbortController();
    window.__livingPillsAbort = ac;
    const { signal } = ac;

    const qs  = (sel, root = document) => root.querySelector(sel);
    const qsa = (sel, root = document) => Array.from(root.querySelectorAll(sel));

    const SHOW_STEP = 12;
    let shownLimit = SHOW_STEP;

    const grid  = qs("#livingGrid");
    if (!grid) return; // not on this page

    const chipsWrap = qs(".chips");
    const cards = qsa(".post-card", grid);

    const qInput = qs("#livingSearch");
    const qClear = qs(".search-clear");
    const qMeta  = qs(".search-meta");

    const showMoreBtn  = qs("#livingShowMore");
    const showMoreMeta = qs(".showmore-meta");

    if (!chipsWrap || !cards.length) return;

    // Build searchable text once
    cards.forEach((card) => {
      card.dataset.search = (card.innerText || "").toLowerCase();
    });

    function getAllPills() {
      return qsa(".chip", chipsWrap);
    }

    function getActiveCat() {
      const active = qs(".chip.chip-active", chipsWrap);
      return (active?.getAttribute("data-cat") || "all").toLowerCase();
    }

    function getQuery() {
      return (qInput?.value || "").trim().toLowerCase();
    }

    function setActivePill(key) {
      const k = (key || "all").toLowerCase();
      getAllPills().forEach((pill) => {
        const pillKey = (pill.getAttribute("data-cat") || "all").toLowerCase();
        const isActive = k === "all" ? pillKey === "all" : pillKey === k;
        pill.classList.toggle("chip-active", isActive);
        pill.setAttribute("aria-selected", String(isActive));
      });
    }

    function syncUrl(cat, q) {
      const url = new URL(window.location.href);
      const c = (cat || "all").toLowerCase();
      const query = (q || "").trim();

      if (c === "all") url.searchParams.delete("cat");
      else url.searchParams.set("cat", c);

      if (!query) url.searchParams.delete("q");
      else url.searchParams.set("q", query);

      history.replaceState({}, "", url);
    }

    function applyAll({ resetLimit = false } = {}) {
      const cat = getActiveCat();
      const q = getQuery();

      if (resetLimit) shownLimit = SHOW_STEP;

      let shown = 0;
      let matches = 0;

      cards.forEach((card) => {
        const c = (card.getAttribute("data-cat") || "other").toLowerCase();
        const okCat = cat === "all" || c === cat;

        const hay = card.dataset.search || "";
        const okQ = !q || hay.includes(q);

        const ok = okCat && okQ;
        if (ok) matches++;

        const show = ok && shown < shownLimit;
        card.style.display = show ? "" : "none";
        if (show) shown++;
      });

      if (qClear) qClear.hidden = !q;
      if (qMeta) qMeta.textContent = q ? `${shown} result${shown === 1 ? "" : "s"} for “${q}”` : "";

      if (showMoreBtn) {
        const remaining = Math.max(0, matches - shown);
        showMoreBtn.hidden = remaining <= 0;
        if (showMoreMeta) {
          showMoreMeta.textContent = remaining > 0 ? `${remaining} more guide${remaining === 1 ? "" : "s"}` : "";
        }
      }

      syncUrl(cat, q);
    }

    // Init from URL (?cat=, ?q=)
    const params = new URLSearchParams(window.location.search);
    const initialCat = (params.get("cat") || "all").toLowerCase();
    const initialQ = (params.get("q") || "").trim();

    if (qInput) qInput.value = initialQ;
    setActivePill(initialCat);
    applyAll({ resetLimit: true });

    // Event delegation for pills
    chipsWrap.addEventListener("click", (e) => {
      const pill = e.target?.closest?.(".chip");
      if (!pill) return;
      e.preventDefault();
      const key = (pill.getAttribute("data-cat") || "all").toLowerCase();
      setActivePill(key);
      applyAll({ resetLimit: true });
    }, { signal });

    chipsWrap.addEventListener("keydown", (e) => {
      const pill = e.target?.closest?.(".chip");
      if (!pill) return;
      if (e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      const key = (pill.getAttribute("data-cat") || "all").toLowerCase();
      setActivePill(key);
      applyAll({ resetLimit: true });
    }, { signal });

    if (qInput) qInput.addEventListener("input", () => applyAll({ resetLimit: true }), { signal });

    if (qClear && qInput) {
      qClear.addEventListener("click", () => {
        qInput.value = "";
        applyAll({ resetLimit: true });
        qInput.focus();
      }, { signal });
    }

    if (showMoreBtn) {
      showMoreBtn.addEventListener("click", () => {
        shownLimit += SHOW_STEP;
        applyAll({ resetLimit: false });
      }, { signal });
    }
  }

  // First load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLivingPills, { once: true });
  } else {
    initLivingPills();
  }

  // After Astro swaps in new page HTML
  document.addEventListener("astro:page-load", initLivingPills);
</script>
</Site>
