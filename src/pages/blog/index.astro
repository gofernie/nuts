---
// File: src/pages/blog/index.astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";

const PATH_BASE = "/blog";

/* ---------- helpers ---------- */
const RESERVED = new Set(["index", "page", "pages", "all", "view", "list"]);

const get = (r: any, ...keys: string[]) => {
  if (!r) return "";
  for (const k of keys) {
    const key = String(k);
    const direct = r[key];
    if (direct !== undefined && direct !== null && String(direct).trim() !== "") {
      return String(direct).trim();
    }
    const lower = r[key.toLowerCase()];
    if (lower !== undefined && lower !== null && String(lower).trim() !== "") {
      return String(lower).trim();
    }
    const upper = r[key.toUpperCase()];
    if (upper !== undefined && upper !== null && String(upper).trim() !== "") {
      return String(upper).trim();
    }
  }
  return "";
};

const slugify = (v: string) =>
  (v ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "-and-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

// canonical slug for any row
const rowSlug = (r: any) =>
  (get(r, "slug") || slugify(get(r, "title"))).toLowerCase();

const visible = (r: any) => {
  const s = get(r, "status").toLowerCase();
  const rs = rowSlug(r);
  return s !== "hidden" && s !== "inactive" && !RESERVED.has(rs);
};

const stripMeta = (s: string = "") =>
  s
    .replace(/<[^>]*>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const stripScripts = (html: string = "") =>
  html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");

const stripTags = (s: string = "") =>
  s
    .replace(/<[^>]*>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const excerpt = (s: string, n = 240) => {
  const t = stripTags(s);
  return t.length > n ? t.slice(0, n - 1).trimEnd() + "…" : t;
};

const isAbs = (s: string = "") => /^https?:\/\//i.test(s);
const pick = (...vals: string[]) => vals.find((v) => v && v.length > 0) || "";

const fmtDate = (ms: number) =>
  ms
    ? new Date(ms).toLocaleDateString("en-CA", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })
    : "";

// normalised category key (used for data-cat and ?cat=)
const catKey = (cat: string = "other") =>
  (cat || "other")
    .toLowerCase()
    .replace(/[–—]/g, "-")
    .replace(/&/g, "-and-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

/* ---------- accent + labels per category ---------- */
const accentPalette = [
  "#0ea5e9", // sky blue
  "#22c55e", // green
  "#6366f1", // indigo
  "#f97316", // orange
  "#eab308", // amber
  "#0f766e", // teal
  "#14b8a6", // aqua
];

const accentForCategory = (key: string = "other") => {
  const s = (key || "other").toLowerCase();
  let hash = 0;
  for (let i = 0; i < s.length; i++) {
    hash = (hash + s.charCodeAt(i)) % accentPalette.length;
  }
  return accentPalette[hash];
};

const labelForCategory = (cat: string = "other") => {
  const norm = (cat || "").trim();
  if (!norm) return "Other";

  const cleaned = norm
    .replace(/[_-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  return cleaned
    .split(" ")
    .map((word) =>
      word.length === 0
        ? ""
        : word[0].toUpperCase() + word.slice(1).toLowerCase(),
    )
    .join(" ");
};

/* ---------- types ---------- */
type Row = Record<string, any>;
type Item = {
  slug: string;
  title: string;
  summary: string;
  hero_img?: string;
  card_img?: string;
  sort: number;
  categories: string[];
  primaryCat: string; // catKey form
  dateMs: number;
  dateISO: string;
};

/* ---------- fetch ---------- */
let items: Item[] = [];
let header: Row | null = null;
let error: string | null = null;

try {
  const url = import.meta.env.PUBLIC_BLOG_JSON;
  if (!url) throw new Error("Missing PUBLIC_BLOG_JSON in .env (restart dev).");

  const raw = await getJson<any>(url);
  const rows: any[] = Array.isArray(raw)
    ? raw
    : Array.isArray(raw?.data)
    ? raw.data
    : Array.isArray(raw?.rows)
    ? raw.rows
    : [];

  // header row is where slug OR title resolves to "index"
  header =
    rows.find((r) => {
      const id = rowSlug(r);
      return id === "index";
    }) ?? null;

  items = rows
    .filter((r: any) => {
      if (!visible(r)) return false;
      return rowSlug(r) !== "index";
    })
    .map((r: any): Item => {
      const catRaw = get(r, "category");
      const categories = catRaw
        ? catRaw
            .split(/[,/|]+/g)
            .map((c: string) => c.trim())
            .filter(Boolean)
            .map((c: string) =>
              c.replace(/\s+/g, " ").replace(/[–—]/g, "-").trim(),
            )
        : [];

      // accept "date" or "publish_date"
      const pd = get(r, "date") || get(r, "publish_date");
      const parsed = pd ? Date.parse(pd) : NaN;
      const dateMs = Number.isFinite(parsed) ? parsed : 0;
      const dateISO = dateMs ? new Date(dateMs).toISOString() : "";

      const primaryCat = catKey(categories[0] || "other");
      const slug = rowSlug(r); // already lowercased

      return {
        slug,
        title: get(r, "title"),
        summary: get(r, "summary"),
        hero_img: get(r, "hero_img"),
        card_img: get(r, "card_img"),
        sort: +get(r, "sort") || Number.MAX_SAFE_INTEGER,
        categories,
        primaryCat,
        dateMs,
        dateISO,
      };
    })
    .filter((r) => r.slug && r.title)
    .sort((a, b) => {
      // primary sort: newest date first
      if (b.dateMs !== a.dateMs) return b.dateMs - a.dateMs;
      // tie-breaker: sort column (higher first)
      return Number(b.sort) - Number(a.sort);
    });
} catch (e: any) {
  error = e?.message || "Failed to load data.";
}

/* ---------- header fields (sheet-driven) ---------- */
const pageTitle = header
  ? get(header, "page_title", "seo_title", "title") || "Fernie Blog"
  : "Fernie Blog";

const h1 = header
  ? get(header, "h1", "title") || "Fernie Blog"
  : "Fernie Blog";

const subhead = header ? get(header, "subhead", "kicker") : "";
const headerSummary = header ? get(header, "summary") : "";
const heroImgRaw = header ? get(header, "hero_img") : "";
const rawSeoDesc =
  header ? get(header, "seo_description") || headerSummary : "";
const seoDesc = stripMeta(rawSeoDesc);

const SUMMARY_IS_HTML = true;
const summaryHtml = SUMMARY_IS_HTML ? stripScripts(headerSummary) : "";

/* keep around */
const DEFAULT_BLOG_HERO = "";

let heroImg: string = "";
if (heroImgRaw) {
  heroImg = isAbs(heroImgRaw) ? heroImgRaw : heroPath(heroImgRaw);
} else if (DEFAULT_BLOG_HERO) {
  heroImg = DEFAULT_BLOG_HERO;
}

/* ---------- categories for filter UI ---------- */
const primaryCatLabels = new Map<string, string>();

items.forEach((it) => {
  const cat0 = (it.categories[0] || "other").trim();
  if (!cat0) return;

  const norm = catKey(cat0);
  if (!primaryCatLabels.has(norm)) {
    primaryCatLabels.set(norm, cat0);
  }
});

const allCats = Array.from(primaryCatLabels.values()).sort((a, b) =>
  a.localeCompare(b),
);

const hasCategories = allCats.length > 0;

// accent for the blog index header
const headerAccent = accentForCategory("blog-index");

/* ---------- featured ---------- */
const featured = items.length ? items[0] : null;
const rest = items.length > 1 ? items.slice(1) : [];

/* ---------- show-more config ---------- */
const SHOW_STEP = 10;
---

<Site
  title={pageTitle}
  seo_title={pageTitle}
  seo_description={seoDesc}
  wrapContent={false}
  heroPreload={heroImg ? { href: heroImg, imagesizes: "100vw" } : undefined}
>
  <div class="page-shell pad-x">
    {/* INTRO HEADER - Living index clone */}
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="blog-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span class="blog-breadcrumb-current">Blog</span>
      </nav>

      <div class="blog-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{h1}</h1>
        </div>

        {subhead && <p class="page-subhead">{subhead}</p>}
      </div>
    </section>

    {/* FADED MOUNTAIN STRIP */}
    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeIndex" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeIndex)"
        />
      </svg>
    </div>

    {/* SUMMARY - keep exactly as-is */}
    {headerSummary && (
      <section class="summary-wrap">
        <div class="lead" set:html={summaryHtml}></div>
      </section>
    )}

    {/* FEATURED - text-first */}
    {!error && featured && (
      <section class="featured-wrap">
        <div class="featured-label">Featured analysis</div>

        <a
          class="post-card featured"
          href={`${PATH_BASE}/${featured.slug}`}
          data-astro-prefetch="hover"
          aria-label={featured.title}
          data-cat={featured.primaryCat || "other"}
          style={`--accent:${accentForCategory(featured.primaryCat || "other")};`}
        >
          <div class="pc-body">
            <div class="pc-meta">
              {featured.dateMs > 0 && (
                <time class="pc-date" datetime={featured.dateISO}>
                  {fmtDate(featured.dateMs)}
                </time>
              )}
              <span class="pc-pill">
                {labelForCategory(
                  (featured.categories?.[0] ||
                    featured.primaryCat ||
                    "Other").toString(),
                )}
              </span>
            </div>

            <h2 class="pc-title featured-title">{featured.title}</h2>

            {featured.summary && (
              <p class="pc-excerpt featured-excerpt">
                {excerpt(featured.summary, 320)}
              </p>
            )}

            <div class="featured-cta">
              <span class="cta-dot" aria-hidden="true"></span>
              <span>Read the breakdown</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      </section>
    )}

    {/* SEARCH */}
    <div class="searchbar" aria-label="Search blog posts">
      <div class="searchrow">
        <label class="sr-only" for="blogSearch">Search articles</label>
        <input
          id="blogSearch"
          class="search-input"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="Search articles…"
        />
        <button class="search-clear" type="button" aria-label="Clear search" hidden>
          ✕
        </button>
      </div>
      <div class="search-meta" aria-live="polite"></div>
    </div>

    {/* CATEGORY FILTERS */}
    {hasCategories && (
      <div class="filters" aria-label="Blog filters">
        <div class="chips" role="tablist" aria-label="Filter by category">
          <button
            class="chip chip-active"
            data-cat="__all"
            role="tab"
            aria-selected="true"
          >
            All
          </button>
          {allCats.map((c) => {
            const norm = catKey(c);
            const accent = accentForCategory(norm);
            return (
              <button
                class="chip"
                data-cat={norm}
                role="tab"
                aria-selected="false"
                style={`--accent:${accent};`}
              >
                {labelForCategory(c)}
              </button>
            );
          })}
        </div>
      </div>
    )}

    {/* GRID */}
    <div class="posts-grid" id="blogGrid">
      {error && <p class="err">{error}</p>}

      {!error &&
        rest.map((it) => {
          const raw = pick(it.card_img || "", it.hero_img || "");
          const img = raw ? (isAbs(raw) ? raw : heroPath(raw)) : "";
          const cat = it.primaryCat || "other";
          const accent = accentForCategory(cat);
          const labelSource = it.categories[0] || cat;
          const label = labelForCategory(labelSource);

          return (
            <a
              class="post-card"
              href={`${PATH_BASE}/${it.slug}`}
              data-astro-prefetch="hover"
              aria-label={it.title}
              data-cat={cat}
              style={`--accent:${accent};`}
            >
              {img && (
                <div class="pc-media">
                  <img
                    src={img}
                    alt={it.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="pc-body">
                <div class="pc-meta">
                  {it.dateMs > 0 && (
                    <time class="pc-date" datetime={it.dateISO}>
                      {fmtDate(it.dateMs)}
                    </time>
                  )}
                  <span class="pc-pill">{label}</span>
                </div>
                <h3 class="pc-title">{it.title}</h3>
                {it.summary && <p class="pc-excerpt">{excerpt(it.summary, 240)}</p>}
              </div>
            </a>
          );
        })}
    </div>

    {/* SHOW MORE */}
    {!error && rest.length > SHOW_STEP && (
      <div class="showmore-wrap">
        <button id="blogShowMore" class="showmore-btn" type="button">
          Show more
        </button>
        <div class="showmore-meta" aria-live="polite"></div>
      </div>
    )}
  </div>

  <script>
    // Filtering + Search + URL sync + Show more (plain JS)
    (function () {
      const SHOW_STEP = 12;
      let shownLimit = SHOW_STEP;

      const grid = document.getElementById("blogGrid");
      const chips = Array.from(document.querySelectorAll(".chip"));
      const featured = document.querySelector(".post-card.featured");

      const qInput = document.getElementById("blogSearch");
      const qClear = document.querySelector(".search-clear");
      const qMeta = document.querySelector(".search-meta");

      const showMoreBtn = document.getElementById("blogShowMore");
      const showMoreMeta = document.querySelector(".showmore-meta");

      if (!chips.length && !qInput) return;

      const gridCards = grid ? Array.from(grid.querySelectorAll(".post-card")) : [];
      const allCards = [...(featured ? [featured] : []), ...gridCards];

      // build searchable text once (title + excerpt + meta)
      allCards.forEach((card) => {
        const t = (card.innerText || "").toLowerCase();
        card.dataset.search = t;
      });

      function setActive(btn) {
        chips.forEach((b) => {
          const on = b === btn;
          b.classList.toggle("chip-active", on);
          b.setAttribute("aria-selected", on ? "true" : "false");
        });
      }

      function getActiveCat() {
        const active = document.querySelector(".chip.chip-active");
        return (active?.getAttribute("data-cat") || "__all").toLowerCase();
      }

      function getQuery() {
        return (qInput?.value || "").trim().toLowerCase();
      }

      function syncUrl(cat, q) {
        const url = new URL(window.location.href);

        const c = (cat || "__all").toLowerCase();
        const query = (q || "").trim();

        if (c === "__all") url.searchParams.delete("cat");
        else url.searchParams.set("cat", c);

        if (!query) url.searchParams.delete("q");
        else url.searchParams.set("q", query);

        window.history.replaceState({}, "", url.toString());
      }

      function matchesCat(card, catKey) {
        const c = (card.getAttribute("data-cat") || "other").toLowerCase();
        return catKey === "__all" || c === catKey;
      }

      function matchesQuery(card, q) {
        if (!q) return true;
        const hay = (card.dataset.search || "").toLowerCase();
        return hay.includes(q);
      }

      function applyAll() {
        const cat = getActiveCat();
        const q = getQuery();

        let shown = 0;

        // Featured (not limited)
        if (featured) {
          const show = matchesCat(featured, cat) && matchesQuery(featured, q);
          featured.style.display = show ? "" : "none";
          if (show) shown++;
        }

        // Grid (limited)
        let gridShown = 0;
        let gridMatches = 0;

        gridCards.forEach((card) => {
          const match = matchesCat(card, cat) && matchesQuery(card, q);
          if (match) gridMatches++;

          const show = match && gridShown < shownLimit;
          card.style.display = show ? "" : "none";

          if (show) {
            gridShown++;
            shown++;
          }
        });

        // UI bits
        if (qClear) qClear.hidden = !q;

        if (qMeta) {
          qMeta.textContent = q
            ? `${shown} result${shown === 1 ? "" : "s"} for “${q}”`
            : "";
        }

        // Show more UI
        if (showMoreBtn) {
          const remaining = Math.max(0, gridMatches - gridShown);
          showMoreBtn.hidden = remaining <= 0;

          if (showMoreMeta) {
            showMoreMeta.textContent =
              remaining > 0
                ? `${remaining} more article${remaining === 1 ? "" : "s"}`
                : "";
          }
        }

        syncUrl(cat, q);
      }

      // Initialise from URL (?cat=, ?q=)
      const params = new URLSearchParams(window.location.search);
      const initialCat = (params.get("cat") || "").toLowerCase();
      const initialQ = (params.get("q") || "").trim();

      if (qInput && initialQ) qInput.value = initialQ;

      if (initialCat) {
        const target = chips.find((btn) => {
          const dc = (btn.getAttribute("data-cat") || "").toLowerCase();
          return dc === initialCat;
        });
        if (target) setActive(target);
      }

      // Events: chips
      chips.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          setActive(btn);
          shownLimit = SHOW_STEP;
          applyAll();
        });

        btn.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            setActive(btn);
            shownLimit = SHOW_STEP;
            applyAll();
          }
        });
      });

      // Events: search
      if (qInput) {
        qInput.addEventListener("input", () => {
          shownLimit = SHOW_STEP;
          applyAll();
        });
      }

      if (qClear && qInput) {
        qClear.addEventListener("click", () => {
          qInput.value = "";
          shownLimit = SHOW_STEP;
          applyAll();
          qInput.focus();
        });
      }

      // Events: show more
      if (showMoreBtn) {
        showMoreBtn.addEventListener("click", () => {
          shownLimit += SHOW_STEP;
          applyAll();
        });
      }

      // first run
      applyAll();
    })();
  </script>

  <style>
    .page-shell {
      max-width: 1280px;
      margin-inline: auto;
      margin-top: 14px;
      margin-bottom: 40px;
    }

    .pad-x {
      padding-inline: var(--edge-pad) !important;
    }

    @media (min-width: 900px) {
      .pad-x {
        padding-inline: var(--edge-pad-lg) !important;
      }
    }

    /* INTRO HEADER - Living index clone */
    .page-intro{
      max-width: var(--container-max);
      margin: 0 auto 10px;
      padding-top: 28px;
    }

    .blog-breadcrumb{
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .blog-breadcrumb a{
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }
    .blog-breadcrumb a:hover{ border-bottom-color: var(--accent); }
    .blog-breadcrumb-current{ opacity: 0.7; }

    .blog-title-block{ max-width: 48rem; }

    .accent-bars{ display: flex; gap: 0.25rem; margin-bottom: 0.75rem; }
    .accent-bar{ height: 4px; border-radius: 999px; background: var(--accent); }
    .accent-bar.primary{ width: 80px; opacity: 0.9; }
    .accent-bar.secondary{ width: 40px; opacity: 0.45; }

    .title-row{ display: flex; align-items: flex-start; gap: 0.75rem; }

    .page-title{
      margin: 0 0 6px;
      font-size: clamp(2.4rem, 3.8vw, 3.05rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: #111827;
    }

    .page-subhead{
      margin: 6px 0 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
    }

    .mountain-strip {
      margin: 10px auto 22px;
      height: 48px;
      max-height: 60px;
      border-radius: 10px;
      overflow: hidden;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.02), transparent);
    }

    .mountain-strip svg {
      width: 100%;
      height: 100%;
      opacity: 0.95;
      mix-blend-mode: multiply;
    }

    /* SUMMARY - upgraded lead block (unchanged) */
    .summary-wrap {
      padding-top: 10px;
      padding-bottom: 24px;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 22px;
    }

    .lead {
      max-width: 54rem;
      margin: 0;
      padding: 14px 16px;
      border-radius: 14px;
      background: color-mix(in srgb, #ffffff 92%, var(--accent) 8%);
      border: 1px solid color-mix(in srgb, #e5e7eb 78%, var(--accent) 22%);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      font-size: 1.05rem;
      line-height: 1.62;
      color: #111827;
      position: relative;
    }

    .lead :global(p) {
      margin: 0.75rem 0;
    }
    .lead :global(p:first-child) {
      margin-top: 0;
    }
    .lead :global(p:last-child) {
      margin-bottom: 0;
    }

    .lead::before {
      content: "";
      position: absolute;
      left: 12px;
      top: 12px;
      bottom: 12px;
      width: 3px;
      border-radius: 999px;
      background: var(--accent);
      opacity: 0.9;
    }

    .err {
      color: #b91c1c;
      background: #fee2e2;
      padding: 0.75rem 1rem;
      border-radius: 0.75rem;
      margin-top: 12px;
    }

    /* Featured */
    .featured-wrap {
      margin: 22px 0 22px; /* crowding fix */
    }

    .featured-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
      color: #111827;
      opacity: 0.7;
      margin: 0 0 10px;
    }

    /* SEARCH */
    .searchbar{
      max-width: 54rem;
      margin: 6px 0 18px;
    }

    .searchrow{
