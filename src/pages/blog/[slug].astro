---
// File: src/pages/blog/[slug].astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import HeroBleed from "../../components/HeroBleed.astro";
// ⛔️ Removed RVEmbed
import CTAForm2 from "../../components/CTAForm2.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";

/* ---------- static paths (NO helpers referenced) ---------- */
export async function getStaticPaths() {
  const url = import.meta.env.PUBLIC_BLOG_JSON; // blog JSON
  if (!url) return [];

  let rows: any[] = [];
  try {
    const raw = await getJson<any>(url);
    rows = Array.isArray(raw)
      ? raw
      : Array.isArray(raw?.data) ? raw.data
      : Array.isArray(raw?.rows) ? raw.rows
      : [];
  } catch {
    return [];
  }

  const items = rows
    .map((r: any) => {
      const status = String(r?.status ?? r?.Status ?? r?.STATUS ?? "").trim().toLowerCase();
      const rawSlug = String(r?.slug ?? r?.Slug ?? r?.SLUG ?? "").trim().toLowerCase();
      const hidden = status === "hidden" || status === "inactive" || rawSlug === "index";
      if (hidden) return null;

      const title = String(r?.title ?? r?.Title ?? r?.TITLE ?? "").trim();
      // inline slugify
      const computed = String(title ?? "")
        .toLowerCase()
        .trim()
        .replace(/&/g, "-and-")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
      const slug = (rawSlug || computed).toLowerCase();

      return slug ? { params: { slug }, props: { row: r } } : null;
    })
    .filter(Boolean) as any[];

  return items;
}

/* ---------- page data ---------- */
type Row = {
  title?: string; Title?: string; TITLE?: string;
  summary?: string; Summary?: string; SUMMARY?: string;
  long_copy?: string; longcopy?: string; LongCopy?: string;
  hero_img?: string; heroImg?: string; HeroImg?: string;
  seo_title?: string; seoTitle?: string;
  seo_description?: string; seoDescription?: string;
  kicker?: string; subhead?: string;
  cta1?: string; rv_block?: string; slug?: string; status?: string;
  spare_1?: string; Spare_1?: string; SPARE_1?: string;
  spare_2?: string; Spare_2?: string; SPARE_2?: string;

  /* NEW: accept either `date` or `publish_date` */
  date?: string; Date?: string; publish_date?: string; Publish_Date?: string;
};

const { row: rowIn } = Astro.props as { row?: Row };
const row = rowIn ?? ({} as Row);

const title    = String(row?.title ?? row?.Title ?? row?.TITLE ?? "Fernie Blog").trim();
const summary  = String(row?.summary ?? row?.Summary ?? row?.SUMMARY ?? "").trim();
const body     = String(row?.long_copy ?? row?.longcopy ?? row?.LongCopy ?? "").trim();
const heroImg  = String(row?.hero_img ?? row?.heroImg ?? row?.HeroImg ?? "").trim();
const seoTitle = String(row?.seo_title ?? row?.seoTitle ?? title).trim();

/* ✅ Clean meta */
const stripMeta = (s:string="") =>
  s.replace(/<[^>]*>/g, " ")
   .replace(/&[^;\s]+;/g, " ")
   .replace(/\s+/g, " ")
   .trim();

const rawSeoDesc = String(row?.seo_description ?? (row as any)?.seoDescription ?? summary ?? "");
const seoDesc    = stripMeta(rawSeoDesc);

/* ---------- kicker/subhead ---------- */
const kicker = String(
  (row as any)?.kicker ?? (row as any)?.Kicker ?? (row as any)?.KICKER ??
  (row as any)?.subhead ?? (row as any)?.Subhead ?? (row as any)?.SUBHEAD ?? ""
).trim() || "Fernie, BC";

/* ---------- PUBLISHED DATE (A-style: Nov 06, 2025) ---------- */
const rawDate = String(
  row?.date ?? (row as any)?.Date ?? row?.publish_date ?? (row as any)?.Publish_Date ?? ""
).trim();
const dateMs = rawDate ? Date.parse(rawDate) : NaN;
const hasDate = Number.isFinite(dateMs);
const dateISO = hasDate ? new Date(dateMs).toISOString() : "";
const datePretty = hasDate
  ? new Date(dateMs).toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric" })
  : "";

/* ---------- parse BUTTONS (label|href, separated by commas or new lines) ---------- */
type Btn = { label: string; href: string };
function parseButtons(s: string): Btn[] {
  if (!s) return [];
  return s
    .split(/\s*,\s*|\n+/)
    .map(part => {
      const [label, href] = part.split("|").map(x => (x ?? "").trim());
      if (!label || !href) return null;
      return { label, href };
    })
    .filter(Boolean) as Btn[];
}

const rawButtons =
  String(row?.spare_2 ?? row?.Spare_2 ?? row?.SPARE_2 ?? "").trim() ||
  String(row?.spare_1 ?? row?.Spare_1 ?? row?.SPARE_1 ?? "").trim();

const buttons: Btn[] = parseButtons(rawButtons);

/* helpers for active state */
const here = Astro.url.pathname.replace(/\/+$/,"");
function isActiveHref(href: string, label: string) {
  const clean = href.replace(/\/+$/,"");
  if (/^all$/i.test(label)) return here === clean || here.startsWith(clean + "/");
  return here === clean;
}

/* ---------- content HTML guards ---------- */
function stripScripts(html:string) { return html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, ""); }
const SUMMARY_IS_HTML = true;
const BODY_IS_HTML    = true;
const summaryHtml = SUMMARY_IS_HTML ? stripScripts(summary) : "";
const bodyHtml    = BODY_IS_HTML    ? stripScripts(body)    : "";

/* ---------- hero preload hint ---------- */
const heroPreload = heroImg ? { href: heroPath(heroImg) } : null;

/* ---------- Formspree ---------- */
const formspreeId = String(import.meta.env.PUBLIC_FORMSPREE_ID ?? "f/yourFormIdHere");

/* ---------- CTA copy ---------- */
const ctaHeadline = `Want the right homes in ${title} sent to you early?`;
const ctaSubline  = "Tell me what fits your criteria — I’ll only send the ones that actually matter.";
---

<Site title={seoTitle} seo_title={seoTitle} seo_description={seoDesc} heroPreload={heroPreload}>
  <HeroBleed
    src={heroImg ? heroPath(heroImg) : ""}
    title={title}
    kicker={kicker}
    containerMax={1280}
    containerPad={0}
    flush={false}
    preload={false}
    position="top-left"
    titleInset={15}
  />

  {/* Published date (under hero, above summary) */}
  {hasDate && (
    <div class="container">
      <time class="post-date" datetime={dateISO}>Published: {datePretty}</time>
    </div>
  )}

  {/* Summary (underline treatment, no card) */}
  {summary && (
    <section class="summary-wrap">
      <div class="container">
        {SUMMARY_IS_HTML
          ? <div class="lead" set:html={summaryHtml}></div>
          : <p class="lead">{summary}</p>}

        {buttons.length > 0 && (
          <nav class="btnset-wrap" aria-label="Blog quick links">
            <ul class="btnset">
              {buttons.map(b => {
                const active = isActiveHref(b.href, b.label);
                return (
                  <li>
                    <a
                      class={`btnpill${active ? " is-active" : ""}`}
                      href={b.href}
                      data-astro-prefetch="hover"
                    >
                      {b.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        )}
      </div>
    </section>
  )}

  {body && (
    <div class="container body-wrap">
      {BODY_IS_HTML
        ? <div class="lead" set:html={bodyHtml}></div>
        : <p class="lead">{body}</p>}
    </div>
  )}

  {/* CTA ABOVE LONG COPY (leave as-is) */}
  <div class="container cta-inline" id="cta">
    <CTAForm2
      formId={formspreeId}
      pageSlug={Astro.params.slug}
      pageTitle={title}
      headline={ctaHeadline}
      subline={ctaSubline}
    />
  </div>

  <style>
    .container { max-width: 1200px; margin-inline: auto; padding-inline: 12px; }

    .post-date{
      display:block;
      font-size:.9rem;
      color:#6b7280;  /* slate-500 */
      margin: 10px 0 0;   /* tuck just under hero */
    }

    /* unified summary treatment (same as other pages) */
    .summary-wrap{
      padding-top:10px;
      padding-bottom:10px;
      border-bottom:1px solid #e5e7eb;
      margin-bottom:35px;
    }
    .lead{ margin:0; font-size:1.075rem; line-height:1.6; color:#111827; }
   
    .btnset-wrap { margin-top: 10px; }
    .btnset {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: 10px;
    }
    .btnpill {
      display: inline-block;
      border: 1px solid #e5e7eb;
      background: #fff;
      color: #111827;
      font-weight: 700;
      text-decoration: none;
      padding: 10px 16px;
      border-radius: 9999px;
      line-height: 1;
      box-shadow: 0 1px 0 rgba(0,0,0,.02);
      transition: background .15s ease, color .15s ease, border-color .15s ease, transform .05s ease-in-out;
    }
    .btnpill:hover { background: #f3f4f6; transform: translateY(-1px); }
    .btnpill.is-active {
      background: #0f172a; color: #fff; border-color: transparent; box-shadow: 0 1px 0 rgba(0,0,0,.05);
    }

    .summary-wrap::after, .body-wrap::after { content: ""; display: block; clear: both; }

    .cta-inline { padding: 18px 0 10px; clear: both; }
    .body-wrap { padding-top: -12px; }
  </style>
</Site>
