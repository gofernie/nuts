---
// File: src/pages/neighbourhoods/index.astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";
import { CATEGORY_COLOURS, DEFAULT_ACCENT } from "../../lib/categoryColours";

const PATH_BASE = "/neighbourhoods";

/* helpers */
const RESERVED = new Set(["index", "page", "pages", "all", "view", "list"]);
const get = (r: any, k: string) =>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "")
    .toString()
    .trim();

const slugify = (v: string) =>
  (v ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "-and-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const visible = (r: any) => {
  const s = get(r, "status").toLowerCase();
  const rawSlug = get(r, "slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
};

/* =========================
   Buildings (used to decide if a neighbourhood has buildings)
   Key = parent_area_slug (from Buildings JSON)
========================= */
const BUILDINGS_URL = import.meta.env.PUBLIC_BUILDINGS_JSON || "";
const buildingsByParent = new Set<string>();

if (BUILDINGS_URL) {
  try {
    const rawB = await getJson<any>(BUILDINGS_URL);
    const rowsB: any[] = Array.isArray(rawB)
      ? rawB
      : Array.isArray(rawB?.data)
        ? rawB.data
        : Array.isArray(rawB?.rows)
          ? rawB.rows
          : [];

    rowsB.forEach((r) => {
      const parent = slugify(get(r, "parent_area_slug"));
      const status = get(r, "status").toLowerCase();

      if (parent && status !== "hidden" && status !== "inactive") {
        buildingsByParent.add(parent);
      }
    });
  } catch (e) {
    console.warn("Buildings JSON failed", e);
  }
}

/* meta + HTML helpers */
const stripMeta = (s: string = "") =>
  s
    .replace(/<[^>]*>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const stripScripts = (html: string = "") =>
  html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");

const stripTags = (s: string = "") =>
  s
    .replace(/<[^>]*>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const excerpt = (s: string, n = 240) => {
  const t = stripTags(s);
  return t.length > n ? t.slice(0, n - 1).trimEnd() + "…" : t;
};

const titleCase = (s: string) =>
  (s ?? "").replace(/\w\S*/g, (w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());

/* Best-for helper (pipe-delimited) */
const bestForList = (s: string = "") =>
  s
    .split("|")
    .map((x) => x.trim())
    .filter(Boolean)
    .slice(0, 3);

/* url helpers */
const isAbs = (s: string = "") => /^https?:\/\//i.test(s);
const pick = (...vals: string[]) => vals.find((v) => v && v.length > 0) || "";

/* Prefer card_1 / card_2 / card_3 when present */
const bulletsFromCards = (it: any) =>
  [it.card_1, it.card_2, it.card_3].map((x) => (x ?? "").trim()).filter(Boolean).slice(0, 3);

/* Match icons to the actual Best-for bullet text */
function iconForBestFor(text: string) {
  const t = (text || "").toLowerCase();

  if (t.includes("afford") || t.includes("value") || t.includes("budget") || t.includes("entry")) return "💲";
  if (t.includes("ski") || t.includes("hill") || t.includes("lifts") || t.includes("snow")) return "⛷️";
  if (t.includes("short-term") || t.includes("short term") || t.includes("str") || t.includes("airbnb") || t.includes("rental"))
    return "🗝️";
  if (t.includes("lock-and-leave") || t.includes("lock and leave") || t.includes("low-maintenance") || t.includes("low maintenance"))
    return "🧳";
  if (t.includes("trail") || t.includes("hike") || t.includes("hiking") || t.includes("bike") || t.includes("biking")) return "🥾";
  if (t.includes("walk") || t.includes("walkable") || t.includes("cafes") || t.includes("downtown")) return "🚶";
  if (t.includes("family") || t.includes("kids") || t.includes("school") || t.includes("parks")) return "👪";
  if (t.includes("quiet") || t.includes("privacy")) return "🤫";
  if (t.includes("new") || t.includes("newer") || t.includes("modern")) return "🏡";
  if (t.includes("river") || t.includes("water")) return "🌊";
  if (t.includes("view") || t.includes("views") || t.includes("scenic") || t.includes("mountain")) return "🏔️";
  if (t.includes("access") || t.includes("commute") || t.includes("highway")) return "🚗";
  return "⭐";
}

/** Rows */
type Row = {
  slug?: string;
  title?: string;
  Title?: string;
  TITLE?: string;

  summary?: string;
  Summary?: string;
  SUMMARY?: string;

  best_for?: string;
  BestFor?: string;
  BEST_FOR?: string;

  card_1?: string;
  card_2?: string;
  card_3?: string;

  long_copy?: string;
  longcopy?: string;
  LongCopy?: string;

  hero_img?: string;
  heroImg?: string;
  HeroImg?: string;

  card_img?: string;
  cardImg?: string;
  CardImg?: string;

  // ✅ needed to decide buildings
  parent_area_slug?: string;
  parentAreaSlug?: string;

  status?: string;

  seo_title?: string;
  seoTitle?: string;
  seo_description?: string;
  seoDescription?: string;

  subhead?: string;
  Subhead?: string;
  SUBHEAD?: string;

  sort?: number | string;
};

let items: Row[] = [];
let header: Row | null = null;
let error: string | null = null;

try {
  const url = import.meta.env.PUBLIC_SHEET_JSON;
  if (!url) throw new Error("Missing PUBLIC_SHEET_JSON in .env (restart dev).");

  const raw = await getJson<any>(url);
  const rows: any[] = Array.isArray(raw)
    ? raw
    : Array.isArray(raw?.data)
      ? raw.data
      : Array.isArray(raw?.rows)
        ? raw.rows
        : [];

  const pickHeader = (rs: any[]) => {
    const bySlug = rs.find((r) => get(r, "slug").toLowerCase() === "index");
    if (bySlug) return bySlug;
    const byStatus = rs.find((r) => get(r, "status").toLowerCase() === "header");
    if (byStatus) return byStatus;
    const byTitle = rs.find((r) =>
      (get(r, "title") || get(r, "Title") || get(r, "TITLE")).toLowerCase().includes("neighbourhoods")
    );
    return byTitle ?? null;
  };

  header = pickHeader(rows);
  const headerTitle = header ? (get(header, "title") || get(header, "Title") || get(header, "TITLE")) : "";

  items = rows
    .filter((r: any) => {
      if (!visible(r)) return false;
      const slug = get(r, "slug").toLowerCase();
      const title = get(r, "title") || get(r, "Title") || get(r, "TITLE");
      if (slug === "index") return false;
      if (header && title && title === headerTitle) return false;
      return true;
    })
    .map(
      (r: any) =>
        ({
          slug: get(r, "slug") || slugify(get(r, "title") || get(r, "Title") || get(r, "TITLE")),
          title: get(r, "title") || get(r, "Title") || get(r, "TITLE"),
          summary: get(r, "summary") || get(r, "Summary") || get(r, "SUMMARY"),
          best_for: get(r, "best_for") || get(r, "BestFor") || get(r, "BEST_FOR"),

          card_1: get(r, "card_1"),
          card_2: get(r, "card_2"),
          card_3: get(r, "card_3"),

          hero_img: get(r, "hero_img") || get(r, "heroImg") || get(r, "HeroImg"),
          card_img: get(r, "card_img") || get(r, "cardImg") || get(r, "CardImg"),

          // ✅ pull parent_area_slug from neighbourhood rows
          parent_area_slug: get(r, "parent_area_slug") || get(r, "parentAreaSlug"),

          sort: +get(r, "sort") || Number.MAX_SAFE_INTEGER,
        } as Row)
    )
    .filter((r: Row) => r.slug && r.title)
    .sort((a: Row, b: Row) => Number(a.sort) - Number(b.sort) || a.title!.localeCompare(b.title!));
} catch (e: any) {
  error = e?.message || "Failed to load data.";
}

/* header / SEO */
const headerTitle =
  header ? (get(header, "title") || get(header, "Title") || get(header, "TITLE")) : "";

const headerSummary =
  header
    ? get(header, "summary") ||
      get(header, "Summary") ||
      get(header, "SUMMARY") ||
      get(header, "long_copy") ||
      get(header, "longcopy") ||
      get(header, "LongCopy") ||
      get(header, "seo_description") ||
      get(header, "seoDescription") ||
      ""
    : "";

const pageTitle = headerTitle || "Fernie Neighbourhoods";
const pageSubhead =
  (header && (get(header, "subhead") || get(header, "Subhead") || get(header, "SUBHEAD"))) ||
  "Compare Fernie’s neighbourhoods by lifestyle, layout, and access.";

const seoTitle = (header ? get(header, "seo_title") || get(header, "seoTitle") : "") || pageTitle;
const rawSeoDesc =
  (header ? get(header, "seo_description") || get(header, "seoDescription") : "") || headerSummary || "";
const seoDesc = stripMeta(rawSeoDesc);

/* summary rendering */
const SUMMARY_IS_HTML = true;
const summaryHtml = SUMMARY_IS_HTML ? stripScripts(headerSummary) : "";

/* accents */
const headerAccent = CATEGORY_COLOURS.neighbourhoods ?? DEFAULT_ACCENT;
---

<Site title={seoTitle} seo_title={seoTitle} seo_description={seoDesc} wrapContent={false}>
  <div class="page-shell pad-x">
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <nav class="types-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span class="types-breadcrumb-current">Neighbourhoods</span>
      </nav>

      <div class="types-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{pageTitle}</h1>
        </div>

        {pageSubhead && <p class="page-subhead">{pageSubhead}</p>}
      </div>
    </section>

    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeNeighbourhoods" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeNeighbourhoods)"
        />
      </svg>
    </div>

    {headerSummary && (
      <section class="summary-wrap">
        {SUMMARY_IS_HTML ? <div class="lead" set:html={summaryHtml}></div> : <p class="lead">{headerSummary}</p>}
      </section>
    )}

    {error && <p class="err">{error}</p>}

    {!error && (
      <section class="posts-grid" id="neighbourhoodsGrid">
        {items.map((it) => {
          const raw = pick(it.card_img || "", it.hero_img || "");
          const img = raw ? (isAbs(raw) ? raw : heroPath(raw)) : "";

          // neighbourhood page slug
          const hoodSlug = (it.slug || "").replace(/^\/+|\/+$/g, "");

          // ✅ buildings decision uses parent_area_slug (from neighbourhood row) against buildingsByParent set
          const parentArea = slugify(it.parent_area_slug || it.parentAreaSlug || "");
          const hasBuildings = parentArea ? buildingsByParent.has(parentArea) : false;

          const cta = `Explore ${titleCase(it.title || "Neighbourhoods")}`;
          const cardBullets = bulletsFromCards(it);
          const bullets = cardBullets.length ? cardBullets : (it.best_for ? bestForList(it.best_for) : []);

          return (
            <div
              class="post-card"
              style={`--accent:${headerAccent}; --badge:${headerAccent}; --badge2: color-mix(in srgb, ${headerAccent} 70%, #111 30%);`}
            >
              {/* overlay link makes whole card clickable */}
              <a
                class="pc-overlay"
                href={`${PATH_BASE}/${hoodSlug}`}
                data-astro-prefetch="hover"
                aria-label={it.title || `Explore ${hoodSlug}`}
              />

              {img && (
                <div class="pc-media">
                  <img
                    src={img}
                    alt={it.title}
                    loading="lazy"
                    decoding="async"
                    crossorigin="anonymous"
                  />

                  <div class="pc-badge" aria-hidden="true">
                    <span class="pc-badge-text">{String(it.title || "").toUpperCase()}</span>
                  </div>
                </div>
              )}

              <div class="pc-body">
                <h3 class="pc-title sr-only">{it.title}</h3>

                {bullets.length ? <div class="pc-strip">Best for</div> : null}

                {bullets.length ? (
                  <ul class="pc-rows" aria-label="Best for">
                    {bullets.map((b) => (
                      <li class="pc-row">
                        <span class="pc-ico" aria-hidden="true">{iconForBestFor(b)}</span>
                        <span class="pc-row-text">{b}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  it.summary && <p class="pc-excerpt">{excerpt(it.summary, 240)}</p>
                )}

                <span class="pc-footer" aria-hidden="true">
                  <span class="pc-footer-text">
                    {cta} <span aria-hidden="true">→</span>
                  </span>
                </span>

                {hasBuildings && (
                  <a
                    class="pc-buildings"
                    href={`/neighbourhoods/${parentArea}/buildings/`}
                    onClick={(e) => e.stopPropagation()}
                  >
                    🏢 Buildings →
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </section>
    )}
  </div>

  <style>
    .page-shell { max-width: 1280px; margin-inline: auto; margin-top: 14px; margin-bottom: 40px; }
    .pad-x { padding-inline: var(--edge-pad) !important; }
    @media (min-width: 900px){ .pad-x { padding-inline: var(--edge-pad-lg) !important; } }

    .page-intro { max-width: var(--container-max); margin: 0 auto 10px; padding-top: 28px; }

    .types-breadcrumb{
      font-size: 0.8rem;
      opacity: 0.8;
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .types-breadcrumb a{ text-decoration: none; border-bottom: 1px solid transparent; }
    .types-breadcrumb a:hover{ border-bottom-color: var(--accent); }
    .types-breadcrumb-current{ opacity: 0.7; }

    .types-title-block{ max-width: 48rem; }

    .accent-bars{ display: flex; gap: 0.25rem; margin-bottom: 0.75rem; }
    .accent-bar{ height: 4px; border-radius: 999px; background: var(--accent); }
    .accent-bar.primary{ width: 80px; opacity: 0.9; }
    .accent-bar.secondary{ width: 40px; opacity: 0.45; }

    .title-row{ display: flex; align-items: flex-start; gap: 0.75rem; }

    .page-title{
      margin: 0 0 6px;
      font-size: clamp(2.4rem, 3.8vw, 3.05rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.015em;
      color: #111827;
    }

    .page-subhead{
      margin: 6px 0 8px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
    }

    .mountain-strip{
      margin: 8px auto 24px;
      height: 48px;
      max-height: 60px;
      border-radius: 6px;
      overflow: hidden;
      background: linear-gradient(to top, rgba(0,0,0,0.02), transparent);
    }
    .mountain-strip svg{ width: 100%; height: 100%; opacity: 0.9; mix-blend-mode: multiply; }

    .summary-wrap{
      padding-top: 12px;
      padding-bottom: 25px;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 50px;
    }
    .lead{ margin: 0; font-size: 1.075rem; line-height: 1.6; color: #111827; }
    .lead :where(p, ul, ol){ margin: 0 0 .8rem; }
    .lead :where(a){ text-decoration: underline; }

    .err{
      color: #b91c1c;
      background: #fee2e2;
      padding: .75rem 1rem;
      border-radius: .5rem;
      margin-top: 12px;
    }

    .posts-grid{
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 12px;
      margin-bottom: 52px;
    }
    @media(max-width:900px){ .posts-grid{ grid-template-columns: repeat(2,minmax(0,1fr)); } }
    @media(max-width:560px){ .posts-grid{ grid-template-columns: 1fr; } }

    .post-card{
      --accent: #4b5563;
      --badge: var(--accent);
      --badge2: color-mix(in srgb, var(--accent) 70%, #111 30%);
      position: relative;
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid #e2e4e8;
      border-radius: 14px;
      overflow: hidden;
      color: inherit;
      box-shadow: 0 14px 34px rgba(0,0,0,.10);
      transition:
        transform .12s ease,
        box-shadow .15s ease,
        border-color .15s ease,
        background-color .15s ease;
    }

    /* overlay link = whole-card click */
    .pc-overlay{
      position:absolute;
      inset:0;
      z-index: 2;
      text-decoration:none;
    }

    /* card content sits above overlay visually, but doesn't steal clicks */
    .pc-media,
    .pc-body,
    .pc-badge{
      position: relative;
      z-index: 3;
      pointer-events: none;
    }

    /* allow Buildings link to be clickable */
    .pc-buildings{
      position: relative;
      z-index: 4;
      pointer-events: auto;
    }

    .post-card:hover{
      transform: translateY(-2px);
      box-shadow: 0 18px 44px rgba(0,0,0,.14);
      border-color: var(--badge);
      background: color-mix(in srgb, #ffffff 94%, var(--badge) 6%);
    }

    .pc-overlay:focus-visible{
      outline: 2px solid var(--badge);
      outline-offset: 3px;
      border-radius: 14px;
    }

    .pc-media{
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 12px 12px 0 0;
      overflow: hidden;
    }

    .pc-media > img{
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .pc-media::after{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(to top, rgba(0,0,0,.45), rgba(0,0,0,0) 55%);
      z-index: 1;
      pointer-events:none;
    }

    .pc-badge{
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 12px;
      background: rgba(0,0,0,.42);
      backdrop-filter: blur(6px) saturate(1.1);
      border-radius: 10px;
      padding: 10px 12px;
    }

    .pc-badge-text{
      display:block;
      font-weight: 550;
      letter-spacing: .12em;
      line-height: 1.05;
      color: #fff;
      font-size: clamp(14px, 1.25vw, 18px);
      text-transform: uppercase;
      white-space: nowrap;
      overflow:hidden;
      text-overflow: ellipsis;
    }

    .pc-body{ padding: 14px 16px 16px; }

    .sr-only{
      position:absolute !important;
      width:1px;height:1px;
      padding:0;margin:-1px;
      overflow:hidden;clip:rect(0,0,0,0);
      white-space:nowrap;border:0;
    }

    .pc-title{ display:none; }

    .pc-strip{
      margin: 10px 0 6px;
      padding: 6px 12px;
      background: #eef2f7;
      color: #4b5563;
      border-radius: 8px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .pc-rows{
      list-style: none;
      padding: 0;
      margin: 0 0 14px;
      border-radius: 10px;
      background: #fff;
    }

    .pc-row{
      display: grid;
      grid-template-columns: 34px 1fr;
      align-items: center;
      gap: 10px;
      padding: 12px 8px;
      border-bottom: 1px solid #eef0f3;
    }
    .pc-row:last-child{ border-bottom: 0; }

    .pc-ico{
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: #f1f5f9;
      font-size: 18px;
    }

    .pc-row-text{
      color: #111827;
      font-weight: 500;
    }

    .pc-excerpt{
      margin: 0 0 10px;
      color: #4b5563;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      min-height: calc(2 * 1.45em);
    }

    .pc-footer{
      display: block;
      margin-top: 2px;
      padding: 12px 14px;
      border-radius: 10px;
      background: linear-gradient(90deg, var(--badge2), var(--badge));
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.18);
    }

    .pc-footer-text{
      display:flex;
      align-items:center;
      justify-content:center;
      gap: 10px;
      color: #fff;
      font-weight: 600;
      letter-spacing: .04em;
    }

    .post-card:hover .pc-footer{
      filter: saturate(1.05);
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.22),
        0 12px 22px rgba(0,0,0,.12);
    }

    .pc-buildings{
      display:block;
      margin-top:8px;
      padding:8px 10px;
      border-radius:8px;
      font-size:.72rem;
      font-weight:900;
      letter-spacing:.08em;
      text-transform:uppercase;
      text-align:center;
      background:#f1f5f9;
      color:#0f172a;
      border:1px solid #e2e8f0;
      text-decoration:none;
    }

    .pc-buildings:hover{
      background:#e8eef5;
    }

    @media (max-width: 900px){
      .post-card{
        background: color-mix(in srgb, #ffffff 96%, var(--badge) 4%);
        border-color: color-mix(in srgb, #e2e4e8 70%, var(--badge) 30%);
      }

      .post-card::after{
        content:"";
        position:absolute;
        inset:0;
        background: color-mix(in srgb, #ffffff 88%, var(--badge) 12%);
        opacity: 0;
        transition: opacity .18s ease;
        pointer-events:none;
        z-index: 2;
      }

