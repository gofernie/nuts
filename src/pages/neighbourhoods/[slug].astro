                      </svg>
                      <div class="trend-foot">
                        {(() => {
                          if (medianDir === "na") return "Trend";
                          if (medianDir === "up") return "Median sold is rising over the window";
                          if (medianDir === "down") return "Median sold is easing over the window";
                          return "Median sold has been fairly steady";
                        })()}
                      </div>
                    </div>
                  )}

                  {spRatio && (
                    <div class="trend-card">
                      <div class="trend-h">
                        <span class="trend-ico" aria-hidden="true">🤝</span>
                        <span>Sale to list trend</span>
                      </div>
                      <svg class="spark" viewBox="0 0 260 42" role="img" aria-label="Sale-to-list sparkline">
                        <path d={spRatio} fill="none" stroke="currentColor" stroke-width="2" />
                      </svg>
                      <div class="trend-foot">
                        {(() => {
                          if (ratioDir === "na") return "Negotiating leverage often shifts faster than price";
                          if (ratioDir === "down") return "Sale-to-list is easing - buyers may see more negotiating room";
                          if (ratioDir === "up") return "Sale-to-list is firming - stronger seller leverage";
                          return "Sale-to-list has been relatively steady";
                        })()}
                      </div>
                    </div>
                  )}

                  {spDom && (
                    <div class="trend-card">
                      <div class="trend-h">
                        <span class="trend-ico" aria-hidden="true">⏳</span>
                        <span>Days on market trend</span>
                      </div>
                      <svg class="spark" viewBox="0 0 260 42" role="img" aria-label="DOM sparkline">
                        <path d={spDom} fill="none" stroke="currentColor" stroke-width="2" />
                      </svg>
                      <div class="trend-foot">
                        {(() => {
                          if (domDir === "na") return "Days on market trend";
                          if (domDir === "up") return "Homes are taking longer to sell - more time to negotiate";
                          if (domDir === "down") return "Homes are selling faster - less time to negotiate";
                          return "Days on market has been fairly steady";
                        })()}
                      </div>
                    </div>
                  )}
                </div>
              ) : (
                <div class="context-missing">
                  Trend strip is not showing yet because your Fernie context feed does not include the series fields:
                  <code>median_sold_series</code>, <code>sale_to_list_series</code>, <code>dom_series</code>, <code>series_labels</code>.
                </div>
              )}

              <div class="context-note">
                This context is town-wide. It helps you read the broader cycle behind what you’re seeing in {title}.
                Neighbourhood samples can be thin - Fernie-wide trend data adds a steadier signal.
              </div>

              {fernieAutoNarrative && <div class="context-notes">{fernieAutoNarrative}</div>}

              {fernieRecentShift && (
                <div class="context-notes" style="margin-top:10px;opacity:.96;">
                  <strong>Recent shift:</strong> {fernieRecentShift}
                </div>
              )}

              {(() => {
                const extra = (fernieNote || "").trim();
                if (!extra) return null;

                if (fernieRecentShift && normText(extra) === normText(fernieRecentShift)) return null;

                return (
                  <div class="context-insight">
                    <strong>Local insight:</strong> {extra}
                  </div>
                );
              })()}
            </div>
          </section>
        )}

       {/* Listings (BLOCKS ONLY) */}
<section class="sec" id="listings">
