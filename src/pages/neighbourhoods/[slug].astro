---
// File: src/pages/neighbourhoods/[slug].astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";
import { CATEGORY_COLOURS, DEFAULT_ACCENT } from "../../lib/categoryColours";
import RVEmbed from "../../components/RVEmbed.astro";
import NeighbourhoodTypeCards from "../../components/NeighbourhoodTypeCards.astro";


const PATH_BASE = "/neighbourhoods";

/* helpers */
const RESERVED = new Set(["index", "page", "pages", "all", "view", "list"]);
const get = (r: any, k: string) =>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "")
    .toString()
    .trim();

const slugify = (v: string) =>
  (v ?? "")
    .toLowerCase()
    .trim()
    .replace(/&/g, "-and-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const visible = (r: any) => {
  const s = get(r, "status").toLowerCase();
  const rawSlug = get(r, "slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
};

/* =======================
   REQUIRED FOR PRERENDER
   (SELF-CONTAINED - BUILD SAFE)
======================= */
export const getStaticPaths = async () => {
  const RESERVED = new Set(["index", "page", "pages", "all", "view", "list"]);

  const get = (r: any, k: string) =>
    (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "")
      .toString()
      .trim();

  const slugify = (v: string) =>
    (v ?? "")
      .toLowerCase()
      .trim()
      .replace(/&/g, "-and-")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const visible = (r: any) => {
    const s = get(r, "status").toLowerCase();
    const rawSlug = get(r, "slug").toLowerCase();
    return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
  };

  const url = import.meta.env.PUBLIC_SHEET_JSON;
  if (!url) throw new Error("Missing PUBLIC_SHEET_JSON in .env (restart dev).");

  const raw = await getJson<any>(url);
  const rs: any[] = Array.isArray(raw)
    ? raw
    : Array.isArray(raw?.data)
      ? raw.data
      : Array.isArray(raw?.rows)
        ? raw.rows
        : [];

  return rs
    .filter((r) => visible(r))
    .map((r) => {
      const slug =
        (get(r, "slug") ||
          slugify(get(r, "title") || get(r, "Title") || get(r, "TITLE"))).toLowerCase();
      return { params: { slug } };
    })
    .filter((p) => p.params.slug && p.params.slug !== "index" && !RESERVED.has(p.params.slug));
};

/* HTML sanitizers (minimal) */
const stripScripts = (html: string = "") =>
  html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "");

const stripTags = (s: string = "") =>
  s
    .replace(/<[^>]*>/g, " ")
    .replace(/&[^;\s]+;/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const stripMeta = (s: string = "") => stripTags(s);

/* pipe helpers */
const listFromPipe = (s: string = "", max = 3) =>
  s
    .split("|")
    .map((x) => x.trim())
    .filter(Boolean)
    .slice(0, max);

/* url helpers */
const isAbs = (s: string = "") => /^https?:\/\//i.test(s);
const pick = (...vals: string[]) => vals.find((v) => v && v.length > 0) || "";

/* Best-for icons */
function iconForBestFor(text: string) {
  const t = (text || "").toLowerCase();
  if (t.includes("afford") || t.includes("value") || t.includes("budget") || t.includes("entry")) return "💲";
  if (t.includes("ski") || t.includes("hill") || t.includes("lifts") || t.includes("snow")) return "⛷️";
  if (t.includes("short-term") || t.includes("short term") || t.includes("str") || t.includes("airbnb") || t.includes("rental")) return "🗝️";
  if (t.includes("lock-and-leave") || t.includes("lock and leave") || t.includes("low-maintenance") || t.includes("low maintenance")) return "🧳";
  if (t.includes("trail") || t.includes("hike") || t.includes("hiking") || t.includes("bike") || t.includes("biking")) return "🥾";
  if (t.includes("walk") || t.includes("walkable") || t.includes("cafes") || t.includes("downtown")) return "🚶";
  if (t.includes("family") || t.includes("kids") || t.includes("school") || t.includes("parks")) return "👪";
  if (t.includes("quiet") || t.includes("privacy")) return "🤫";
  if (t.includes("new") || t.includes("newer") || t.includes("modern")) return "🏡";
  if (t.includes("river") || t.includes("water")) return "🌊";
  if (t.includes("view") || t.includes("views") || t.includes("scenic") || t.includes("mountain")) return "🏔️";
  if (t.includes("access") || t.includes("commute") || t.includes("highway")) return "🚗";
  return "⭐";
}

/* --- access / times parsing --- */
type AccessEntry = { label: string; walk?: string; drive?: string };

const norm = (s: string) =>
  (s || "")
    .toLowerCase()
    .replace(/[\u2013\u2014]/g, "-")
    .replace(/\s+/g, " ")
    .trim();

function parseAccessTimes(raw: string): Record<string, AccessEntry> {
  const out: Record<string, AccessEntry> = {};
  const parts = (raw || "")
    .split("|")
    .map((p) => p.trim())
    .filter(Boolean);

  const re = /^(.+?)\s*\((.+?)\)\s*$/;

  for (const p of parts) {
    const m = p.match(re);
    if (!m) continue;

    const label = m[1].trim();
    const inside = m[2].trim();
    const insideN = norm(inside);

    const mode = insideN.includes("walk") ? "walk" : insideN.includes("drive") ? "drive" : null;
    if (!mode) continue;

    const time = inside.replace(/\bwalk\b/i, "").replace(/\bdrive\b/i, "").trim();

    const key = norm(label);
    out[key] = out[key] || { label };
    (out[key] as any)[mode] = time;
  }

  return out;
}

function pickAccess(map: Record<string, AccessEntry>, keys: string[]): AccessEntry | null {
  for (const k of keys) {
    const hit = map[norm(k)];
    if (hit && (hit.walk || hit.drive)) return hit;
  }
  return null;
}

/** Row shape (loose) */
type Row = {
  slug?: string;
  title?: string;
  Title?: string;
  TITLE?: string;

  subhead?: string;
  Subhead?: string;
  SUBHEAD?: string;

  summary?: string;
  Summary?: string;
  SUMMARY?: string;

  long_copy?: string;
  longcopy?: string;
  LongCopy?: string;

  best_for?: string;
  BestFor?: string;
  BEST_FOR?: string;

  hero_img?: string;
  heroImg?: string;
  HeroImg?: string;

  seo_title?: string;
  seoTitle?: string;

  seo_description?: string;
  seoDescription?: string;

  map?: string;
  map_embed?: string;
  mapEmbed?: string;

  // listing search url (RealtyVis)
  url?: string;

  // access times
  access?: string;
  access_times?: string;
  drive_walk?: string;
  drive_walk_times?: string;
  proximity?: string;
  times?: string;

  status?: string;

  // optional extras
  day_in_life?: string;
  tradeoffs?: string;

  // optional RV columns
  cta1?: string;
  rv_block?: string;

  // ✅ buildings key lives on neighbourhood rows
  parent_area_slug?: string;
  parentAreaSlug?: string;
};

/* =========================
   Buildings lookup
   Key = parent_area_slug (from Buildings JSON)
========================= */
const BUILDINGS_URL = import.meta.env.PUBLIC_BUILDINGS_JSON || "";
const buildingsByParent = new Set<string>();

if (BUILDINGS_URL) {
  try {
    const rawB = await getJson<any>(BUILDINGS_URL);
    const rowsB: any[] = Array.isArray(rawB)
      ? rawB
      : Array.isArray(rawB?.data)
        ? rawB.data
        : Array.isArray(rawB?.rows)
          ? rawB.rows
          : [];

    rowsB.forEach((r) => {
      const parent = slugify(get(r, "parent_area_slug"));
      const status = get(r, "status").toLowerCase();

      if (parent && status !== "hidden" && status !== "inactive") {
        buildingsByParent.add(parent);
      }
    });
  } catch (e) {
    console.warn("Buildings JSON failed", e);
  }
}

/* =========================
   Market + Fernie context types/helpers
========================= */
type MarketRow = Record<string, any>;
type FernieRow = Record<string, any>;

const MARKET_URL = import.meta.env.PUBLIC_NEIGHBOURHOOD_MARKET_JSON;

/**
 * IMPORTANT:
 * Your .env currently has PUBLIC_FERNIE_MARKET_CONTEXT_JSON.
 * Older code used PUBLIC_FERNIE_MARKET_JSON.
 * We accept either so it never silently fails again.
 */
const FERNIE_URL =
  import.meta.env.PUBLIC_FERNIE_MARKET_CONTEXT_JSON ||
  import.meta.env.PUBLIC_FERNIE_MARKET_JSON ||
  "";

const mget = (r: any, k: string) =>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "")
    .toString()
    .trim();

const num = (v: any) => {
  if (v == null) return null;
  const n = Number(String(v).replace(/[$,%\s,]/g, ""));
  return Number.isFinite(n) ? n : null;
};

const fmtMoney0 = (n: number | null) =>
  n == null
    ? "n/a"
    : n.toLocaleString("en-CA", {
        style: "currency",
        currency: "CAD",
        maximumFractionDigits: 0,
      });

const fmtInt = (n: number | null) => (n == null ? "n/a" : `${Math.round(n)}`);
const fmtPct1 = (n: number | null) => (n == null ? "n/a" : `${n.toFixed(1)}%`);

const fmtDate = (s: string) => {
  if (!s) return "";
  const d = new Date(s);
  if (Number.isNaN(d.getTime())) return s;
  return d.toLocaleString("en-CA", { year: "numeric", month: "short", day: "2-digit" });
};

const splitPipe = (s: string) =>
  (s || "")
    .split("|")
    .map((x) => x.trim())
    .filter(Boolean);

const numsFromPipe = (s: string) =>
  splitPipe(s)
    .map((x) => Number(String(x).replace(/[$,%\s,]/g, "")))
    .filter((n) => Number.isFinite(n));

function sparkPath(values: number[], w = 260, h = 42, pad = 6) {
  if (!values || values.length < 2) return "";
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;

  const innerW = w - pad * 2;
  const innerH = h - pad * 2;
  const step = innerW / (values.length - 1);

  const pts = values.map((v, i) => {
    const x = pad + i * step;
    const t = (v - min) / span;
    const y = pad + (1 - t) * innerH;
    return [x, y] as const;
  });

  const d = pts.map((p, i) => `${i === 0 ? "M" : "L"}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");
  return d;
}

/* =========================
   Trend logic (ONE rule everywhere)
========================= */
type Dir = "up" | "down" | "flat" | "na";

function dirWithThreshold(values: number[], epsPct = 0.01): Dir {
  if (!values || values.length < 2) return "na";
  const a = values[0];
  const b = values[values.length - 1];
  if (!Number.isFinite(a) || !Number.isFinite(b)) return "na";

  if (a === 0) {
    if (b === 0) return "flat";
    return b > 0 ? "up" : "down";
  }

  const pct = (b - a) / Math.abs(a);
  if (Math.abs(pct) <= epsPct) return "flat";
  return pct > 0 ? "up" : "down";
}

function recentDirWithThreshold(values: number[], epsPct = 0.01): Dir {
  if (!values || values.length < 2) return "na";
  const a = values[values.length - 2];
  const b = values[values.length - 1];
  if (!Number.isFinite(a) || !Number.isFinite(b)) return "na";

  if (a === 0) {
    if (b === 0) return "flat";
    return b > 0 ? "up" : "down";
  }

  const pct = (b - a) / Math.abs(a);
  if (Math.abs(pct) <= epsPct) return "flat";
  return pct > 0 ? "up" : "down";
}

function safeJoin(sentences: string[]) {
  return sentences
    .map((s) => (s || "").trim())
    .filter(Boolean)
    .join(" ");
}

/* long-horizon narrative (window view) */
function buildFernieNarrative(args: {
  dom: number[];
  stl: number[];
  med: number[];
}) {
  // thresholds - keep these consistent everywhere
  const DOM_EPS = 0.03; // 3%
  const MED_EPS = 0.03; // 3%
  const STL_EPS = 0.01; // 1%

  const domDir = dirWithThreshold(args.dom, DOM_EPS);
  const stlDir = dirWithThreshold(args.stl, STL_EPS);
  const medDir = dirWithThreshold(args.med, MED_EPS);

  const domCore =
    domDir === "down"
      ? "Over the past few years, homes have generally been selling faster (lower median days on market)."
      : domDir === "up"
        ? "Over the past few years, homes have generally been taking longer to sell (higher median days on market)."
        : domDir === "flat"
          ? "Over the past few years, days on market has been fairly steady."
          : "";

  const stlCore =
    stlDir === "down"
      ? "Sale-to-list has softened, which can create more negotiating room."
      : stlDir === "up"
        ? "Sale-to-list has strengthened, which usually means less negotiating room."
        : stlDir === "flat"
          ? "Sale-to-list has been relatively steady."
          : "";

  const priceCore =
    medDir === "up"
      ? "Median sold prices have trended upward over the same period."
      : medDir === "down"
        ? "Median sold prices have eased over the same period."
        : medDir === "flat"
          ? "Median sold prices have been relatively flat over the same period."
          : "";

  let practical = "";
  if (domDir === "down" && stlDir === "down") {
    practical =
      "In practice, good listings can still move quickly, but buyers often have room to negotiate terms or price when the data supports it.";
  } else if (domDir === "down" && (stlDir === "up" || stlDir === "flat")) {
    practical =
      "In practice, speed matters and pricing is holding, so buyers typically need clean offers on the right homes.";
  } else if (domDir === "up" && stlDir === "down") {
    practical =
      "In practice, buyers usually have more time and more leverage - especially on homes that are overpriced or need work.";
  } else if (domDir === "up" && (stlDir === "up" || stlDir === "flat")) {
    practical =
      "In practice, the market is taking longer to clear even though pricing is holding, so strategy matters: pick the right property and negotiate based on comps and condition.";
  } else {
    practical =
      "In practice, conditions are mixed, so the best approach is to benchmark each home against recent comparable sales and current competition.";
  }

  return safeJoin([domCore, stlCore, priceCore, practical]);
}

/* short-horizon generator (last step only) */
function buildRecentShift(args: {
  dom: number[];
  stl: number[];
  med: number[];
  labels?: string[];
}) {
  const DOM_EPS = 0.03; // 3%
  const MED_EPS = 0.03; // 3%
  const STL_EPS = 0.01; // 1%

  const domDir = dirWithThreshold(args.dom, DOM_EPS);
  const stlDir = dirWithThreshold(args.stl, STL_EPS);
  const medDir = dirWithThreshold(args.med, MED_EPS);

  const domRecent = recentDirWithThreshold(args.dom, DOM_EPS);
  const stlRecent = recentDirWithThreshold(args.stl, STL_EPS);
  const medRecent = recentDirWithThreshold(args.med, MED_EPS);

  const bits: string[] = [];

  const shouldMention = (recent: Dir, overall: Dir) =>
    (recent !== "na" && overall !== "na" && recent !== overall) ||
    (recent === "flat" && overall !== "flat" && overall !== "na");

  if (shouldMention(stlRecent, stlDir)) {
    if (stlRecent === "down") bits.push("Sale-to-list has been drifting lower.");
    else if (stlRecent === "up") bits.push("Sale-to-list has been firming up.");
    else if (stlRecent === "flat") bits.push("Sale-to-list has been relatively steady lately.");
  }

  if (shouldMention(domRecent, domDir)) {
    if (domRecent === "up") bits.push("Days on market has ticked up lately.");
    else if (domRecent === "down") bits.push("Days on market has tightened lately.");
    else if (domRecent === "flat") bits.push("Days on market has been fairly steady lately.");
  }

  if (shouldMention(medRecent, medDir)) {
    if (medRecent === "down") bits.push("Recent median sold pricing has softened.");
    else if (medRecent === "up") bits.push("Recent median sold pricing has firmed up.");
    else if (medRecent === "flat") bits.push("Median sold pricing has been relatively flat lately.");
  }

  if (!bits.length) return "";

  const labels = args.labels || [];
  const recentLabel =
    labels.length >= 2 ? `${labels.at(-2)} - ${labels.at(-1)}` : "";

  const label = recentLabel ? ` (${recentLabel})` : "";
  return safeJoin([bits[0] + label]);
}

/* text normalizer for dedupe */
function normText(s: string) {
  return (s || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const paramsSlug = (Astro.params.slug || "").toString().replace(/^\/+|\/+$/g, "").toLowerCase();

let rows: Row[] = [];
let header: Row | null = null;
let row: Row | null = null;
let error: string | null = null;

try {
  const url = import.meta.env.PUBLIC_SHEET_JSON;
  if (!url) throw new Error("Missing PUBLIC_SHEET_JSON in .env (restart dev).");

  const raw = await getJson<any>(url);
  const rs: any[] = Array.isArray(raw)
    ? raw
    : Array.isArray(raw?.data)
      ? raw.data
      : Array.isArray(raw?.rows)
        ? raw.rows
        : [];

  rows = rs;

  header =
    rs.find((r) => get(r, "slug").toLowerCase() === "index") ||
    rs.find((r) => get(r, "status").toLowerCase() === "header") ||
    null;

  row =
    rs
      .filter((r) => visible(r))
      .map((r) => ({
        ...r,
        slug: get(r, "slug") || slugify(get(r, "title") || get(r, "Title") || get(r, "TITLE")),
      }))
      .find((r) => (get(r, "slug") || "").toLowerCase() === paramsSlug) || null;

  if (!row) throw new Error(`Neighbourhood not found: ${paramsSlug}`);
} catch (e: any) {
  error = e?.message || "Failed to load neighbourhood.";
}

/* =========================
   Buildings flag for THIS neighbourhood
   (prefer this page slug, fallback to row parent_area_slug)
========================= */
const parentArea = row
  ? slugify(get(row, "parent_area_slug") || get(row, "parentAreaSlug"))
  : "";

const hasBuildings =
  buildingsByParent.has(paramsSlug) || (parentArea ? buildingsByParent.has(parentArea) : false);


/* =========================
   page title (needed early)
========================= */
const pageTitle = row ? get(row, "title") || get(row, "Title") || get(row, "TITLE") : "Neighbourhood";

/* ---------- RealtyVis listings (BLOCKS ONLY) ---------- */
const rawCta =
  (row ? (get(row, "rv_block") || get(row, "cta1") || "") : "") ||
  String(import.meta.env.PUBLIC_DEFAULT_RV_BLOCK ?? "").trim();

const BLOCK_RE = /^[A-Z0-9]{8}-[A-Z0-9]{8}$/i;

function extractAttr(html: string, attr: "data-rv-block") {
  const clean = stripScripts(html);
  const re = new RegExp(`${attr}=["']?([A-Z0-9-]{6,30})["']?`, "i");
  const m = clean.match(re);
  return (m?.[1] || "").trim();
}

let rvBlockId = "";

if (BLOCK_RE.test(rawCta)) rvBlockId = rawCta;
else rvBlockId = extractAttr(rawCta, "data-rv-block");

const hasValidBlock = BLOCK_RE.test(rvBlockId);

const listingsUrl = row ? pick(get(row, "url")) : "";
const listingsUrlIsHttp = /^https?:\/\//i.test(listingsUrl);

/* =========================
   Neighbourhood market fetch + join
========================= */
let market: MarketRow | null = null;

try {
  if (MARKET_URL) {
    const rawM = await getJson<any>(MARKET_URL);
    const rsM: any[] = Array.isArray(rawM)
      ? rawM
      : Array.isArray(rawM?.data)
        ? rawM.data
        : Array.isArray(rawM?.rows)
          ? rawM.rows
          : [];

    market = rsM.find((r) => mget(r, "slug").toLowerCase() === paramsSlug) || null;
  }
} catch (e) {
  market = null;
}

const hasMarket = !!market;

const dataThrough = market ? mget(market, "data_through") : "";
const windowYears = market ? (num(mget(market, "window_years")) ?? 5) : 5;

// Homes (window)
const homesCount5y = market ? num(mget(market, "homes_sales_count_5y")) : null;
const homesMedian5y = market ? num(mget(market, "homes_median_sold_5y")) : null;
const homesDom5y = market ? num(mget(market, "homes_median_dom_5y")) : null;
const homesRatio5y = market ? num(mget(market, "homes_sale_to_list_5y")) : null;

// Homes PSF (window)
const homesPsf5y =
  market
    ? (num(mget(market, "homes_median_psf_5y")) ??
       num(mget(market, "homes_psf_median_5y")) ??
       num(mget(market, "homes_median_price_psf_5y")) ??
       num(mget(market, "homes_psf_5y")) ??
       num(mget(market, "homes_median_psf")) ??
       num(mget(market, "homes_psf_median")))
    : null;

const fmtPsf0 = (n: number | null) => (n == null ? "n/a" : `$${Math.round(n).toLocaleString("en-CA")}`);

// Homes YoY
const homesMedianYoY = market ? num(mget(market, "homes_median_sold_yoy")) : null;
const homesCountYoY = market ? num(mget(market, "homes_sales_count_yoy")) : null;
const homesYoYOk = market ? mget(market, "homes_yoy_ok").toLowerCase() === "true" : false;

// Land (window)
const landCount5y = market ? num(mget(market, "land_sales_count_5y")) : null;
const landMedian5y = market ? num(mget(market, "land_median_sold_5y")) : null;

// Land YoY
const landMedianYoY = market ? num(mget(market, "land_median_sold_yoy")) : null;
const landCountYoY = market ? num(mget(market, "land_sales_count_yoy")) : null;
const landYoYOk = market ? mget(market, "land_yoy_ok").toLowerCase() === "true" : false;

const marketNotes = market ? mget(market, "notes") : "";

/* --- land presence + "rare sales" guard --- */
const landFieldsPresent = !!(
  market &&
  (
    mget(market, "land_sales_count_5y") ||
    mget(market, "land_median_sold_5y") ||
    mget(market, "land_median_sold_yoy") ||
    mget(market, "land_sales_count_yoy") ||
    mget(market, "land_yoy_ok")
  )
);

const hasLandData =
  (landCount5y ?? 0) > 0 &&
  (landMedian5y ?? 0) > 0;

/* =========================
   Fernie context fetch (town-wide)
========================= */
let fernie: FernieRow | null = null;

try {
  if (FERNIE_URL) {
    const rawF = await getJson<any>(FERNIE_URL);
    const rsF: any[] = Array.isArray(rawF)
      ? rawF
      : Array.isArray(rawF?.data)
        ? rawF.data
        : Array.isArray(rawF?.rows)
          ? rawF.rows
          : [];

    fernie =
      rsF.find((r) => (mget(r, "name") || mget(r, "title") || mget(r, "data_through"))) ||
      rsF[0] ||
      null;
  }
} catch (e) {
  fernie = null;
}

const hasFernie = !!fernie;

const fernieDataThrough = fernie ? mget(fernie, "data_through") : "";
const fernieWindowYears = fernie ? (num(mget(fernie, "window_years")) ?? 5) : 5;

const fernieNote = fernie ? (mget(fernie, "note") || mget(fernie, "notes")) : "";

// Scalar summary
const fernieMedianSold = fernie ? num(mget(fernie, "median_sold")) : null;
const fernieSaleToList = fernie ? num(mget(fernie, "sale_to_list")) : null;
const fernieMedianDom = fernie ? num(mget(fernie, "median_dom")) : null;
const fernieSalesCount = fernie ? num(mget(fernie, "sales_count")) : null;

/* =========================
   Neighbourhood vs Fernie comparison (auto insight)
========================= */
function pctDiff(a: number | null, b: number | null) {
  if (a == null || b == null || b === 0) return null;
  return (a - b) / b;
}

const saleToListDelta = pctDiff(homesRatio5y, fernieSaleToList);
const priceDelta      = pctDiff(homesMedian5y, fernieMedianSold);
const domAdv          = pctDiff(fernieMedianDom, homesDom5y);

function fmtPct2(n: number | null) {
  return n == null ? "n/a" : `${n.toFixed(1)}%`;
}

function fmtNum(n: number | null) {
  return n == null ? "n/a" : `${Math.round(n)}`;
}

const microBits: string[] = [];

if (homesRatio5y != null && fernieSaleToList != null) {
  microBits.push(
    `sale-to-list is ${fmtPct2(homesRatio5y)} vs ${fmtPct2(fernieSaleToList)} Fernie-wide`
  );
}

if (homesDom5y != null && fernieMedianDom != null) {
  microBits.push(
    `median DOM is ${fmtNum(homesDom5y)} vs ${fmtNum(fernieMedianDom)}`
  );
}

if (homesMedian5y != null && fernieMedianSold != null && Math.abs(priceDelta ?? 0) > 0.05) {
  microBits.push(
    `median price is ${fmtMoney0(homesMedian5y)} vs ${fmtMoney0(fernieMedianSold)}`
  );
}

let microConclusion = "";

if (saleToListDelta != null && domAdv != null) {
  if (saleToListDelta > 0 && domAdv > 0) {
    microConclusion =
      "Homes here are trading closer to ask and moving faster than the Fernie average - a more competitive micro-market.";
  } else if (saleToListDelta < 0 && domAdv < 0) {
    microConclusion =
      "Homes here are taking longer and selling further below ask than Fernie overall - a more negotiable pocket.";
  } else if (domAdv > 0) {
    microConclusion =
      "Homes move faster here, but pricing is still negotiable compared to Fernie overall.";
  } else if (saleToListDelta > 0) {
    microConclusion =
      "Sellers are holding firmer here, even though homes take longer to sell.";
  }
}

const microSummary =
  hasMarket && hasFernie && microBits.length && microConclusion
    ? `${microBits.join(", ")}. ${microConclusion}`
    : "";

// Series (pipe lists)
const fernieMedianSeries = fernie ? numsFromPipe(mget(fernie, "median_sold_series")) : [];
const fernieRatioSeries = fernie ? numsFromPipe(mget(fernie, "sale_to_list_series")) : [];
const fernieDomSeries = fernie ? numsFromPipe(mget(fernie, "dom_series")) : [];
const fernieLabels = fernie ? splitPipe(mget(fernie, "series_labels")) : [];

// Spark paths
const spMedian = sparkPath(fernieMedianSeries);
const spRatio = sparkPath(fernieRatioSeries);
const spDom = sparkPath(fernieDomSeries);

const hasTrendSeries = !!(spMedian || spRatio || spDom);

// Direction (thresholded)
const domDir = dirWithThreshold(fernieDomSeries, 0.03);
const ratioDir = dirWithThreshold(fernieRatioSeries, 0.01);
const medianDir = dirWithThreshold(fernieMedianSeries, 0.03);

const fernieAutoNarrative = buildFernieNarrative({
  dom: fernieDomSeries,
  stl: fernieRatioSeries,
  med: fernieMedianSeries,
});

const fernieRecentShift = buildRecentShift({
  dom: fernieDomSeries,
  stl: fernieRatioSeries,
  med: fernieMedianSeries,
  labels: fernieLabels,
});

/* page fields */
const title = pageTitle;

const subhead =
  (row && (get(row, "subhead") || get(row, "Subhead") || get(row, "SUBHEAD"))) ||
  "Fernie neighbourhood details, lifestyle, and access.";

const summaryRaw = row ? get(row, "summary") || get(row, "Summary") || get(row, "SUMMARY") || "" : "";
const longCopyRaw = row ? get(row, "long_copy") || get(row, "longcopy") || get(row, "LongCopy") || "" : "";

const bestForRaw = row ? get(row, "best_for") || get(row, "BestFor") || get(row, "BEST_FOR") || "" : "";
const bestFor = listFromPipe(bestForRaw, 3);

const heroRaw = row ? pick(get(row, "hero_img"), get(row, "heroImg"), get(row, "HeroImg")) : "";
const heroImg = heroRaw ? (isAbs(heroRaw) ? heroRaw : heroPath(heroRaw)) : "";

// SEO
const seoTitle =
  (row ? get(row, "seo_title") || get(row, "seoTitle") : "") || `${title} - Fernie Neighbourhood`;

const seoDescRaw =
  (row ? get(row, "seo_description") || get(row, "seoDescription") : "") ||
  summaryRaw ||
  (header ? get(header, "seo_description") || get(header, "seoDescription") : "") ||
  "";

const seoDesc = stripMeta(seoDescRaw);

// accent
const headerAccent = CATEGORY_COLOURS.neighbourhoods ?? DEFAULT_ACCENT;

// Summary / long copy HTML
const SUMMARY_IS_HTML = true;
const summaryHtml = SUMMARY_IS_HTML ? stripScripts(summaryRaw) : "";
const longCopyHtml = stripScripts(longCopyRaw);

// Map embed
const mapHtml =
  row ? stripScripts(get(row, "map_embed") || get(row, "mapEmbed") || get(row, "map") || "") : "";

// Drive/Walk access times
const accessRaw =
  row
    ? get(row, "access") ||
      get(row, "access_times") ||
      get(row, "drive_walk") ||
      get(row, "drive_walk_times") ||
      get(row, "proximity") ||
      get(row, "times") ||
      ""
    : "";

const accessMap = parseAccessTimes(accessRaw);

const accessSchools = pickAccess(accessMap, ["Schools", "School", "Isabella Dicken", "Fernie Secondary"]);
const accessShops = pickAccess(accessMap, ["Shops", "Groceries", "Downtown", "Cafes", "Coffee", "Restaurants"]);
const accessSki = pickAccess(accessMap, ["Ski hill", "Ski Hill", "Fernie Alpine Resort", "FAR"]);

// Optional extras
const dayInLife = row ? stripScripts(get(row, "day_in_life") || "") : "";
const tradeoffs = row ? stripScripts(get(row, "tradeoffs") || "") : "";
---

<Site title={seoTitle} seo_title={seoTitle} seo_description={seoDesc} wrapContent={false}>
  <div class="page-shell pad-x" style={`--accent:${headerAccent};`}>
    <section class="page-intro">
      <nav class="types-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href={PATH_BASE}>Neighbourhoods</a>
        <span>/</span>
        <span class="types-breadcrumb-current">{title}</span>
      </nav>

      <div class="types-title-block">
        <div class="accent-bars">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{title}</h1>
        </div>

        {subhead && <p class="page-subhead">{subhead}</p>}
      </div>
    </section>

    {/* FADED MOUNTAIN STRIP */}
    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
