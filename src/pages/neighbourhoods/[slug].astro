          <linearGradient id="mountainFadeHood" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeHood)"
        />
      </svg>
    </div>

    {heroImg && (
      <section class="hero" style={`--accent:${headerAccent};`}>
        <div class="hero-media">
          <img src={heroImg} alt={title} loading="eager" decoding="async" crossorigin="anonymous" />
          <div class="hero-fade" aria-hidden="true"></div>
        </div>
      </section>
    )}

    {/* QUICK LINKS - moved under hero so they don't crowd the title area */}
    {!error && row && (
      <div class="quick-cards-wrap" aria-label="Quick links">
        <div class="quick-cards">
          <a class="qc" href="#listings">
            <div class="qc-ico" aria-hidden="true">🏷️</div>
            <div class="qc-body">
              <div class="qc-title">Listings</div>
              <div class="qc-sub">See what’s available right now</div>
            </div>
          </a>

          {hasBuildings && (
            <a class="qc" href={`${PATH_BASE}/${paramsSlug}/buildings/`}>
              <div class="qc-ico" aria-hidden="true">🏢</div>
              <div class="qc-body">
                <div class="qc-title">Buildings</div>
                <div class="qc-sub">Condos - strata - complexes</div>
              </div>
            </a>
          )}

          <a class="qc" href="#market-snapshot">
            <div class="qc-ico" aria-hidden="true">📊</div>
            <div class="qc-body">
              <div class="qc-title">Market</div>
              <div class="qc-sub">5-year snapshot + context</div>
            </div>
          </a>
        </div>
      </div>
    )}

    {error && <p class="err">{error}</p>}

    {!error && row && (
      <section class="content">
        {summaryRaw && (
          <div class="lead">
            {SUMMARY_IS_HTML ? <div set:html={summaryHtml}></div> : <p>{summaryRaw}</p>}
          </div>
        )}

        {bestFor.length > 0 && (
          <section class="sec">
            <h2 class="sec-h">Best for</h2>
            <div class="best-grid">
              {bestFor.map((b) => (
                <div class="best-card">
                  <span class="best-ico" aria-hidden="true">{iconForBestFor(b)}</span>
                  <span class="best-txt">{b}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {(accessSchools || accessShops || accessSki) && (
          <section class="sec access">
            <h2 class="sec-h">Access times</h2>

            <div class="access-grid">
              {accessSchools && (
                <div class="access-card">
                  <div class="ac-head">
                    <span class="ac-ico" aria-hidden="true">🏫</span>
                    <span class="ac-title">Schools</span>
                  </div>
                  <div class="ac-rows">
                    {accessSchools.walk && (
                      <div class="ac-row">
                        <span class="ac-k">Walk</span>
