                  </div>
                  <div class="ac-rows">
                    {accessShops.walk && (
                      <div class="ac-row">
                        <span class="ac-k">Walk</span>
                        <span class="ac-v">{accessShops.walk}</span>
                      </div>
                    )}
                    {accessShops.drive && (
                      <div class="ac-row">
                        <span class="ac-k">Drive</span>
                        <span class="ac-v">{accessShops.drive}</span>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {accessSki && (
                <div class="access-card">
                  <div class="ac-head">
                    <span class="ac-ico" aria-hidden="true">⛷️</span>
