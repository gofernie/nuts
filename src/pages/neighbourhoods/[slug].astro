                      </div>
                    )}
                    {accessSki.drive && (
                      <div class="ac-row">
                        <span class="ac-k">Drive</span>
                        <span class="ac-v">{accessSki.drive}</span>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          </section>
        )}

        {longCopyRaw && (
          <section class="sec">
            <h2 class="sec-h">Living here</h2>
            <div class="copy" set:html={longCopyHtml}></div>
          </section>
        )}

        {/* Market snapshot */}
        {hasMarket && (
          <section class="sec" id="market-snapshot">
            <h2 class="sec-h">Market snapshot</h2>

            <div class="market-card">
              <div class="market-top">
                <div class="market-title">
                  {title}
                  <span class="market-pill">{windowYears}-year snapshot</span>
                </div>

                {dataThrough && <div class="market-meta">Data through {fmtDate(dataThrough)}</div>}
              </div>

              <div class="market-grid">
                <div class="market-panel">
                  <div class="mp-h">Homes</div>

                  <div class="mp-row"><span>Sold</span><strong>{fmtInt(homesCount5y)}</strong></div>
                  <div class="mp-row"><span>Median sold</span><strong>{fmtMoney0(homesMedian5y)}</strong></div>

                  {homesPsf5y != null && (
                    <div class="mp-row"><span>Median $/sq ft</span><strong>{fmtPsf0(homesPsf5y)}</strong></div>
                  )}

                  <div class="mp-row"><span>Median DOM</span><strong>{fmtInt(homesDom5y)}</strong></div>
                  <div class="mp-row"><span>Sale to list</span><strong>{fmtPct1(homesRatio5y)}</strong></div>

                  {homesYoYOk && (
                    <div class="mp-yoy">
                      <div class="mp-yh">YoY</div>
                      <div class="mp-row"><span>Median price</span><strong>{fmtPct1(homesMedianYoY)}</strong></div>
                      <div class="mp-row">
                        <span>Sales volume</span>
                        <strong>
                          {homesCountYoY == null ? "n/a" : homesCountYoY > 0 ? `+${homesCountYoY}` : `${homesCountYoY}`}
                        </strong>
                      </div>
                    </div>
                  )}
                </div>

                {/* Land panel shows if land fields exist; "rare sales" message when empty */}
                {landFieldsPresent && (
                  <div class="market-panel">
                    <div class="mp-h">Land</div>

                    {hasLandData ? (
                      <>
                        <div class="mp-row"><span>Sold</span><strong>{fmtInt(landCount5y)}</strong></div>
                        <div class="mp-row"><span>Median sold</span><strong>{fmtMoney0(landMedian5y)}</strong></div>

                        {landYoYOk && (
                          <div class="mp-yoy">
                            <div class="mp-yh">YoY</div>
                            <div class="mp-row"><span>Median price</span><strong>{fmtPct1(landMedianYoY)}</strong></div>
                            <div class="mp-row">
                              <span>Sales volume</span>
                              <strong>
                                {landCountYoY == null ? "n/a" : landCountYoY > 0 ? `+${landCountYoY}` : `${landCountYoY}`}
                              </strong>
                            </div>
                          </div>
                        )}
                      </>
                    ) : (
                      <>
                        <div class="mp-row">
                          <span>Land</span>
                          <strong>Rare or no recent sales</strong>
