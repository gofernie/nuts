                <div class="cs-card">
                  <div class="cs-k">Median sold</div>
                  <div class="cs-v">{fmtMoney0(fernieMedianSold)}</div>
                </div>
                <div class="cs-card">
                  <div class="cs-k">Sale to list</div>
                  <div class="cs-v">{fmtPct1(fernieSaleToList)}</div>
                </div>
                <div class="cs-card">
                  <div class="cs-k">Median DOM</div>
                  <div class="cs-v">{fmtInt(fernieMedianDom)}</div>
                </div>
                <div class="cs-card">
                  <div class="cs-k">Sales (window)</div>
                  <div class="cs-v">{fmtInt(fernieSalesCount)}</div>
                </div>
              </div>

              {/* Trend strip */}
