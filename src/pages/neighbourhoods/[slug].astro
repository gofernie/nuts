              method="POST"
              action="https://formspree.io/f/mgooeejl"
            >
              <input type="hidden" name="neighbourhood" value={title} />
              <input type="hidden" name="page" value={Astro.url.pathname} />

              <label class="cta-lbl">
                <span>Name</span>
                <input
                  class="cta-in"
                  type="text"
                  name="name"
                  autocomplete="name"
                  placeholder="Your name"
                  required
                />
              </label>

              <label class="cta-lbl">
                <span>Email</span>
                <input
                  class="cta-in"
                  type="email"
