---
// File: src/pages/to_do/index.astro
export const prerender = true;

import Site from "../../layouts/Site.astro";
import HeroBleed from "../../components/HeroBleed.astro";
import { getJson } from "../../lib/fetchJson";
import { heroPath } from "../../lib/paths";
import sanitizeHtml from "sanitize-html";
import ListingsAccordion from "../../components/ListingsAccordion.astro"; // ✅ NEW

const PATH_BASE = "/to_do";

/* ---------- helpers ---------- */
const RESERVED = new Set(["index","page","pages","all","view","list"]);
const get = (r:any,k:string)=>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "").toString().trim();

const slugify = (v:string) =>
  (v ?? "").toLowerCase().trim()
    .replace(/&/g,"-and-")
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"");

const visible = (r:any) => {
  const s = get(r,"status").toLowerCase();
  const rawSlug = get(r,"slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && rawSlug !== "index" && !RESERVED.has(rawSlug);
};

/* Pull first http(s) URL out of a possibly-wrapped cell */
const firstHttp = (s:string="") => {
  const t = (s || "").replace(/\u00A0/g, " ").trim(); // strip NBSPs
  const m = t.match(/https?:\/\/[^\s"'<>\u00A0]+/i);
  return m ? m[0] : t;
};

const pick = (...vals:string[]) => vals.find(v => v && v.length > 0) || "";
const isAbs = (s:string="") => /^https?:\/\//i.test(s);

/* summaries */
const toText = (v:string) =>
  sanitizeHtml(v ?? "", { allowedTags: [], allowedAttributes: {} })
    .replace(/\s+/g, " ")
    .trim();

const toHtml = (v:string) => sanitizeHtml(v ?? "", {
  allowedTags: ["p","strong","em","a","ul","ol","li","br","span"],
  allowedAttributes: { a:["href","target","rel"] },
  transformTags: {
    a: (_:any,attr:any)=>({ tagName:"a", attribs:{...attr, rel:"noopener nofollow ugc"} })
  }
});

/* ---------- seasons parsing ---------- */
const readColumnC = (r:any): string => {
  try {
    const vals = Object.values(r);
    const v = vals.length >= 3 ? (vals[2] ?? "") : "";
    return (typeof v === "string" ? v : "").toString();
  } catch { return ""; }
};

const parseSeasons = (r:any) => {
  let raw = get(r,"seasons") || get(r,"season") || get(r,"tags");
  if (!raw) raw = readColumnC(r);

  raw = (raw || "").toString().toLowerCase().replace(/\u00a0/g," ").trim();

  if (!raw) return ["all"];
  if (raw === "both" || raw === "both (all)" || raw === "all" || raw === "any" || raw === "year-round" || raw === "year round") {
    return ["all"];
  }

  const parts = raw.split(/[\/,|;]+|\s{2,}/)
    .map(s => s.trim())
    .filter(Boolean);

  const map: Record<string,string> = {
    "summer":"summer","winter":"winter","spring":"spring",
    "fall":"fall","autumn":"fall","yr":"year-round",
    "year-round":"year-round","year round":"year-round",
    "both":"all","both (all)":"all","any":"all","all":"all"
  };

  const canon = Array.from(new Set(parts.map(p => map[p] ?? p)));
  return canon.length ? canon : ["all"];
};

type Row = {
  slug?: string;
  title?: string;
  summary?: string;
  long_copy?: string;
  hero_img?: string;
  card_img?: string;
  status?: string;
  seo_title?: string;
  seo_description?: string;
  sort?: number|string;
  seasons?: string[];
};

let items: (Row & { summary_text?: string })[] = [];
let header: Row | null = null;
let error: string | null = null;

try {
  const url = import.meta.env.PUBLIC_TODO_JSON;
  if (!url) throw new Error("Missing PUBLIC_TODO_JSON in .env (restart dev).");

  const raw = await getJson<any>(url);
  const rows:any[] =
    Array.isArray(raw) ? raw :
    Array.isArray(raw?.data) ? raw.data :
    Array.isArray(raw?.rows) ? raw.rows : [];

  const headerCandidates = rows.filter((r:any) => {
    const slug = get(r,"slug").toLowerCase();
    const status = get(r,"status").toLowerCase();
    const hasSummary =
      !!get(r,"summary") ||
      !!get(r,"long_copy") ||
      !!get(r,"seo_description") ||
      !!get(r,"description");
    return slug === "index" || status === "header" || hasSummary;
  });

  header =
    headerCandidates.find(r => get(r,"slug").toLowerCase() === "index") ??
    headerCandidates.find(r => get(r,"status").toLowerCase() === "header") ??
    headerCandidates[0] ?? null;

  items = rows
    .filter(r => visible(r))
    .map(r => {
      const title = get(r,"title");
      const summaryRaw =
        get(r,"summary") || get(r,"description") || get(r,"seo_description") || "";

      const hero_raw = firstHttp(get(r,"hero_img"));
      const card_raw = firstHttp(get(r,"card_img"));
      const seasons = parseSeasons(r);

      return {
        slug: get(r,"slug") || slugify(title),
        title,
        summary: summaryRaw,
        summary_text: toText(summaryRaw),
        hero_img: hero_raw,
        card_img: card_raw,
        sort: +get(r,"sort") || Number.MAX_SAFE_INTEGER,
        seasons,
      };
    })
    .filter(r => r.slug && r.title)
    .sort((a,b) => (Number(a.sort) - Number(b.sort)) || a.title!.localeCompare(b.title!));

} catch (e:any) {
  error = e?.message || "Failed to load data.";
}

const pageTitle = get(header,"title") || "Things To Do in Fernie";
const pageSummary =
  get(header,"summary") ||
  get(header,"long_copy") ||
  get(header,"seo_description") ||
  get(header,"description") ||
  "";

const heroImgRaw = firstHttp(get(header,"hero_img"));
const heroImg = isAbs(heroImgRaw) ? heroImgRaw : (heroImgRaw ? heroPath(heroImgRaw) : "");

const seoTitle = get(header,"seo_title") || pageTitle;
const seoDesc  = toText(get(header,"seo_description") || pageSummary);

const SUMMARY_IS_HTML = true;
const pageSummaryHtml = SUMMARY_IS_HTML ? toHtml(pageSummary) : "";

/* ---------- filter pills ---------- */
const core = ["all","summer","winter"];
const present = new Set(items.flatMap(i => i.seasons ?? []));
const extra = Array.from(present).filter(s => !core.includes(s)).sort();
const filterTokens = core.concat(extra);
const label = (t:string) => (t==="all"?"All":t==="year-round"?"Year-Round":t.replace(/\b\w/g,c=>c.toUpperCase()));

/* ---------- NEW: listings accordion inputs from header ---------- */
const listingsLabel = "Explore Fernie real estate listings";
const listingsSub   = "See the newest listings currently active on the MLS.";
const headerCTA1    = get(header,"cta1") || get(header,"CTA1");
const headerBlock   = get(header,"rv_block_id") || get(header,"rv_block");
---

<Site title={seoTitle} seo_title={seoTitle} seo_description={seoDesc}>
  <HeroBleed
    src={heroImg}
    title={pageTitle}
    containerMax={1200}
    containerPad={12}
    flush={false}
    kicker="Things To Do highlights Fernie experiences across seasons, styles, budgets, lifestyles."
    preload
  />

  {pageSummary && (
    <div class="container summary-wrap">
      {SUMMARY_IS_HTML
        ? <div class="lead" set:html={pageSummaryHtml}></div>
        : <p class="lead">{pageSummary}</p>}
    </div>
  )}

  <div class="container">
    {/* Filter Pills */}
    <div class="filters" role="tablist" aria-label="Filter by season">
      {filterTokens.map((tok) => (
        <button
          role="tab"
          class={`pill ${tok === "all" ? "is-active" : ""}`}
          data-filter={tok}
          aria-selected={tok === "all" ? "true" : "false"}
          aria-controls="todo-grid"
        >
          {label(tok)}
        </button>
      ))}
    </div>

    {error && <p class="err">{error}</p>}

    {!error && (
      <div id="todo-grid" class="grid" role="tabpanel">
        {items.map((it) => {
          const raw = pick(it.card_img || "", it.hero_img || "");
          const img = raw ? (isAbs(raw) ? raw : heroPath(raw)) : "";
          const seasonsAttr = (it.seasons ?? []).join(",");

          return (
            <a
              class="card"
              href={`${PATH_BASE}/${it.slug}`}
              data-astro-prefetch="hover"
              aria-label={it.title}
              data-seasons={seasonsAttr}
            >
              {img && (
                <img
                  src={img}
                  alt={it.title}
                  loading="lazy"
                  decoding="async"
                  sizes="(min-width: 1200px) 25vw, (min-width: 900px) 33vw, 50vw"
                  onerror="this.remove()"
                />
              )}
              <div class="body">
                <h2>{it.title}</h2>
                {it.summary_text && <p>{it.summary_text}</p>}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>

  {/* ✅ NEW: shared listings accordion after grid */}
  <ListingsAccordion
    label={listingsLabel}
    subline={listingsSub}
    cta1={headerCTA1}
    block={headerBlock}
  />

  <script is:inline>
    // Client-side filter for season pills (supports ?season=summer)
    (function() {
      var pills = Array.from(document.querySelectorAll('.filters .pill'));
      var grid = document.getElementById('todo-grid');
      var cards = Array.from(grid ? grid.querySelectorAll('.card') : []);
      if (!pills.length || !grid) return;

      var params = new URLSearchParams(location.search);
      var initial = (params.get('season') || 'all').toLowerCase();

      function applyFilter(token) {
        pills.forEach(b => {
          var on = b.getAttribute('data-filter') === token;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });

        cards.forEach(card => {
          var seasons = (card.getAttribute('data-seasons') || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
          var show = token === 'all' || seasons.includes('all') || seasons.includes('year-round') || seasons.includes(token);
          card.style.display = show ? '' : 'none';
        });

        var url = new URL(location.href);
        if (token === 'all') { url.searchParams.delete('season'); }
        else { url.searchParams.set('season', token); }
        history.replaceState(null, '', url.toString());
      }

      pills.forEach(b => b.addEventListener('click', function() {
        applyFilter(b.getAttribute('data-filter'));
      }));

      var hasInitial = pills.some(b => b.getAttribute('data-filter') === initial);
      applyFilter(hasInitial ? initial : 'all');
    })();
  </script>

  <style>
    .container{ max-width:1200px; margin-inline:auto; padding-inline:12px; }

    .summary-wrap{
      padding-top:10px;
      padding-bottom:10px;
      border-bottom:1px solid #e5e7eb;
      margin-bottom:35px;
    }
    .lead{ margin:0; font-size:1.075rem; line-height:1.6; color:#111827; }
    .lead :is(p,ul,ol,a,strong,em){ color:inherit; line-height:1.6; }

    .err{ color:#b91c1c; background:#fee2e2; padding:.75rem 1rem; border-radius:.5rem; margin-top:12px; }

    /* Pills */
    .filters{ display:flex; flex-wrap:wrap; gap:8px; margin-top:6px; margin-bottom:10px; }
    .pill{
      appearance:none; border:1px solid #e5e7eb; background:#fff; color:#111827;
      padding:.4rem .7rem; border-radius:999px; font-size:.92rem; line-height:1; cursor:pointer;
      transition: background .12s ease, border-color .12s ease, color .12s ease, box-shadow .12s ease;
    }
    .pill:hover{ border-color:#d1d5db; box-shadow:0 1px 6px rgba(0,0,0,.05); }
    .pill.is-active{ background:#0ea5e9; border-color:#0ea5e9; color:white; }

    .grid{
      display:grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap:16px;
      margin-top:12px;
      margin-bottom:52px; /* space before accordion */
    }
    @media (max-width:1200px){ .grid{ grid-template-columns: repeat(3, minmax(0,1fr)); } }
    @media (max-width:900px){  .grid{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
    @media (max-width:560px){  .grid{ grid-template-columns: 1fr; } }

    .card{
      display:flex; flex-direction:column; background:#fff; border:1px solid #e5e7eb; border-radius:14px; overflow:hidden;
      text-decoration:none; color:inherit;
      transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease;
    }
    .card:hover{ transform: translateY(-2px); box-shadow:0 6px 14px rgba(0,0,0,.08); border-color:#d1d5db; }

    .card img{ width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
    .card .body{ padding:12px; }
    .card .body h2{ margin:0 0 6px; font-size:1.05rem; line-height:1.3; }

    /* 2-line clamp */
    .card .body p{
      margin:0; color:#374151; line-height:1.35;
      display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
      overflow:hidden; text-overflow:ellipsis;
    }
  </style>
</Site>
