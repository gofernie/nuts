---
const currentPath = (value => {
  const v = String(value || "/");
  return v.length > 1 ? v.replace(/\/+$/, "") : v;
})(Astro.url.pathname);

const nav = [
  { href: "/", label: "Latest" },
  { href: "/market-trends", label: "Market Trends" },
  { href: "/listingsNext", label: "Listings" },
  { href: "/price-cuts", label: "Price Cuts" },
  { href: "/sales", label: "Sales" },
  { href: "/archive", label: "Archive" },
  { href: "/tester", label: "Tester" },
];

const cleanPath = (value) => {
  const v = String(value || "/");
  return v.length > 1 ? v.replace(/\/+$/, "") : v;
};

const isActive = (href) => currentPath === cleanPath(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Content Test</title>

    <style is:global>
      :root{
        --ink: rgba(26,24,22,.92);
        --muted: rgba(26,24,22,.68);
        --bg: #f3f1ec;
        --line: rgba(0,0,0,.12);
        --card: rgba(255,255,255,.72);
      }

      *{ box-sizing:border-box; }

      html, body{
        margin:0;
        width:100%;
        height:100%;
        scrollbar-gutter: stable;
      }

      body{
        background: var(--bg);
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a{
        color: inherit;
        text-decoration: none;
      }

      .site-header{
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(243,241,236,.88);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0,0,0,.05);
      }

      .topbar{
        min-height: 72px;
        width: min(1180px, calc(100% - 36px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 180px 1fr;
        align-items: center;
        column-gap: 24px;
      }

      .site-brand{
        display: flex;
        align-items: center;
        justify-self: start;
        height: 16px;
        margin: 0;
        padding: 0;
      }

      .site-brand img{
        display: block;
        width: 108px;
        height: 16px;
      }

      .nav{
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 18px;
        white-space: nowrap;
        min-width: 0;
      }

      .link{
        position: relative;
        font-size: 14px;
        color: var(--muted);
        padding: 8px 0;
        font-weight: 600;
      }

      .link:hover{
        color: var(--ink);
      }

      .link.is-active{
        color: var(--ink);
      }

      .link.is-active::after{
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 2px;
        background: currentColor;
        border-radius: 2px;
      }

      .page{
        width: min(1180px, calc(100% - 36px));
        margin: 0 auto;
        padding: 34px 0 80px;
      }

      .intro{
        display:grid;
        grid-template-columns: 1.15fr .85fr;
        gap: 24px;
        align-items: end;
        margin-bottom: 26px;
      }

      .eyebrow{
        margin: 0 0 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      h1{
        margin: 0 0 14px;
        font-size: clamp(2.3rem, 4.7vw, 4.4rem);
        line-height: .98;
        letter-spacing: -0.04em;
        max-width: 10ch;
      }

      .lead{
        max-width: 760px;
        margin: 0;
        font-size: 1.06rem;
        line-height: 1.7;
        color: var(--muted);
      }

      .summary-card{
        background: var(--card);
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 20px;
        padding: 22px;
      }

      .summary-card h2{
        margin: 0 0 10px;
        font-size: 1.15rem;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      .summary-card p{
        margin: 0;
        line-height: 1.65;
        color: var(--muted);
      }

      .stats{
        display:grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin: 0 0 26px;
      }

      .stat{
        background: rgba(255,255,255,.62);
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 18px;
        padding: 18px;
      }

      .stat-label{
        display:block;
        margin-bottom: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .stat-value{
        display:block;
        margin-bottom: 8px;
        font-size: 2rem;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .stat-note{
        font-size: .95rem;
        line-height: 1.45;
        color: var(--muted);
      }

      .content-grid{
        display:grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
        gap: 22px;
        align-items: start;
      }

      .card{
        background: var(--card);
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 20px;
        padding: 24px;
      }

      .card h2{
        margin: 0 0 14px;
        font-size: 1.4rem;
        line-height: 1.08;
        letter-spacing: -0.03em;
      }

      .card p{
        margin: 0 0 14px;
        color: var(--muted);
        line-height: 1.72;
      }

      .card p:last-child{
        margin-bottom: 0;
      }

      .side-list{
        display:grid;
        gap: 14px;
      }

      .side-item{
        padding-top: 14px;
        border-top: 1px solid rgba(0,0,0,.08);
      }

      .side-item:first-child{
        padding-top: 0;
        border-top: 0;
      }

      .side-kicker{
        display:block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      footer{
        width: min(1180px, calc(100% - 36px));
        margin: 0 auto;
        padding: 28px 0 40px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: .92rem;
      }

      .footer-inner{
        display:flex;
        justify-content:space-between;
        gap:14px;
        flex-wrap:wrap;
      }

      @media (max-width: 1000px){
        .stats{
          grid-template-columns: repeat(2, 1fr);
        }

        .intro,
        .content-grid{
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 900px){
        .topbar{
          min-height: 64px;
          width: calc(100% - 20px);
          display: flex;
          align-items: center;
          justify-content: flex-start;
        }

        .nav{
          display: none;
        }

        .page{
          width: calc(100% - 20px);
          padding: 24px 0 56px;
        }

        .stats{
          grid-template-columns: 1fr;
        }

        footer{
          width: calc(100% - 20px);
          padding: 22px 0 30px;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="topbar">
        <a class="site-brand" href="/" aria-label="Fernie Insider">
          <img src="/cclogo.svg" alt="Fernie Insider" />
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a class:list={["link", isActive(item.href) && "is-active"]} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="page">
      <section class="intro">
        <div>
          <p class="eyebrow">Market insight test</p>
          <h1>What the market feels like right now.</h1>
          <p class="lead">
            This page is meant to feel like a real editorial market page without introducing any of the
            bigger layout risks yet. It uses a normal headline, summary copy, stat cards, and a two-column
            content section so you can test deployed behaviour with something much closer to the real site.
          </p>
        </div>

        <aside class="summary-card">
          <h2>The week, in plain English</h2>
          <p>
            Inventory is still there, but it is not all equal. The cleaner listings appear to be getting the
            early attention, while the rest of the market feels more patient. That usually points to a market
            that is active underneath, but selective.
          </p>
        </aside>
      </section>

      <section class="stats">
        <article class="stat">
          <span class="stat-label">Inventory</span>
          <span class="stat-value">126</span>
          <span class="stat-note">Enough choice to slow urgency, but not enough to feel flooded.</span>
        </article>

        <article class="stat">
          <span class="stat-label">Sales pace</span>
          <span class="stat-value">5.2</span>
          <span class="stat-note">Steady weekly demand, though not broad enough to lift everything.</span>
        </article>

        <article class="stat">
          <span class="stat-label">Absorption</span>
          <span class="stat-value">6.1</span>
          <span class="stat-note">Closer to balanced than hot, with buyers still able to compare.</span>
        </article>

        <article class="stat">
          <span class="stat-label">Price cuts</span>
          <span class="stat-value">3.4</span>
          <span class="stat-note">Some sellers are adjusting, but not in a way that feels disorderly.</span>
        </article>
      </section>

      <section class="content-grid">
        <article class="card">
          <h2>What stands out</h2>
          <p>
            The main thing this kind of page should help test is whether normal editorial structure can sit
            below the working header without causing any alignment drift after deploy. The layout here is
            intentionally more realistic than the shell test, but still avoids a hero image or full-bleed band.
          </p>
          <p>
            From a content point of view, this is the kind of section that starts to feel useful. It has a
            stronger headline, a summary card, quick numbers, and a longer interpretation area that can carry
            actual market perspective instead of just acting as a placeholder.
          </p>
          <p>
            If this deploys cleanly on both domains, you are ready to move to a first real page template. Only
            after that would I add the hero system back in and test whether the larger visual treatment changes
            the alignment.
          </p>
        </article>

        <aside class="card">
          <h2>What I’d watch next</h2>
          <div class="side-list">
            <div class="side-item">
              <span class="side-kicker">Buyers</span>
              Whether activity stays concentrated around the sharp listings first.
            </div>
            <div class="side-item">
              <span class="side-kicker">Sellers</span>
              Whether more reductions appear, or whether pricing mostly holds.
            </div>
            <div class="side-item">
              <span class="side-kicker">Next build step</span>
              Add one real page with this same shell before introducing a hero.
            </div>
          </div>
        </aside>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div>Fernie Insider</div>
        <div>Content test baseline</div>
      </div>
    </footer>
  </body>
</html>