---
// File: src/pages/index.astro
export const prerender = true;

import Site from "../layouts/Site.astro";
import { getJson } from "../lib/fetchJson";
import { heroPath } from "../lib/paths";
import { Fragment } from "astro/jsx-runtime";
import { CATEGORY_COLOURS, DEFAULT_ACCENT } from "../lib/categoryColours";

const PATH_BASE_NEIGH = "/neighbourhoods";

/* ---------- helpers ---------- */
const RESERVED = new Set(["index","page","pages","all","view","list"]);
const get = (r:any, k:string) =>
  (r?.[k] ?? r?.[k?.toLowerCase?.()] ?? r?.[k?.toUpperCase?.()] ?? "").toString().trim();

const slugify = (v:string) =>
  (v ?? "").toLowerCase().trim()
    .replace(/&/g,"-and-")
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"");

const visible = (r:any) => {
  const s = get(r,"status").toLowerCase();
  const rawSlug = get(r,"slug").toLowerCase();
  return s !== "hidden" && s !== "inactive" && !RESERVED.has(rawSlug);
};

const stripMeta = (s:string="") =>
  s.replace(/<[^>]*>/g, " ")
   .replace(/&[^;\s]+;/g, " ")
   .replace(/\s+/g, " ")
   .trim();

const stripScripts = (html:string="") =>
  html.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,"");

const stripTags = (s:string="") =>
  s.replace(/<[^>]*>/g, " ")
   .replace(/&[^;\s]+;/g," ")
   .replace(/\s+/g," ")
   .trim();

const excerpt = (s:string, n=240) => {
  const t = stripTags(s || "");
  if (!t) return "";
  return t.length > n ? t.slice(0, n - 1).trimEnd() + "..." : t;
};

/* url helpers */
const isAbs = (s:string="") => /^https?:\/\//i.test(s);
const pick  = (...vals:string[]) => vals.find(v => v && v.length > 0) || "";

/* ---------- types ---------- */
type HomeRow = {
  title?: string;
  subhead?: string;
  summary?: string;
  hero_img?: string;
  seo_title?: string;
  seo_description?: string;

  cta1?: string;
  cta2?: string;
  cta3?: string;
  cta4?: string;
  cta5?: string;

  tab1_label?: string;
  tab2_label?: string;
  tab3_label?: string;
  tab4_label?: string;
  tab5_label?: string;

  tab1_block?: string;
  tab2_block?: string;
  tab3_block?: string;
  tab4_block?: string;
  tab5_block?: string;
};

type NeighRow = {
  slug?: string;
  title?: string;
  summary?: string;
  hero_img?: string;
  card_img?: string;
  sort?: number | string;
};

type ListingTab = {
  id: string;
  label: string;
  payload: string;
};

/* ---------- fetch ---------- */
let homeHeader: HomeRow | null = null;
let homeRows: any[] = [];
let neighItems: NeighRow[] = [];
let error: string | null = null;

try {
  const homeUrl  = import.meta.env.PUBLIC_HOME_JSON;
  const listUrl  = import.meta.env.PUBLIC_SHEET_JSON;

  if (!homeUrl) throw new Error("Missing PUBLIC_HOME_JSON in .env (restart dev).");
  if (!listUrl) throw new Error("Missing PUBLIC_SHEET_JSON in .env (restart dev).");

  // HOME HEADER
  const rawHome = await getJson<any>(homeUrl);
  homeRows =
    Array.isArray(rawHome) ? rawHome :
    Array.isArray(rawHome?.data) ? rawHome.data :
    Array.isArray(rawHome?.rows) ? rawHome.rows : [];
  homeHeader = homeRows.length ? {
    title:           get(homeRows[0],"title"),
    subhead:         get(homeRows[0],"subhead"),
    summary:         get(homeRows[0],"summary"),
    hero_img:        get(homeRows[0],"hero_img"),
    seo_title:       get(homeRows[0],"seo_title"),
    seo_description: get(homeRows[0],"seo_description"),

    cta1:            get(homeRows[0],"cta1"),
    cta2:            get(homeRows[0],"cta2"),
    cta3:            get(homeRows[0],"cta3"),
    cta4:            get(homeRows[0],"cta4"),
    cta5:            get(homeRows[0],"cta5"),

    tab1_label:      get(homeRows[0],"tab1_label"),
    tab2_label:      get(homeRows[0],"tab2_label"),
    tab3_label:      get(homeRows[0],"tab3_label"),
    tab4_label:      get(homeRows[0],"tab4_label"),
    tab5_label:      get(homeRows[0],"tab5_label"),

    tab1_block:      get(homeRows[0],"tab1_block"),
    tab2_block:      get(homeRows[0],"tab2_block"),
    tab3_block:      get(homeRows[0],"tab3_block"),
    tab4_block:      get(homeRows[0],"tab4_block"),
    tab5_block:      get(homeRows[0],"tab5_block"),
  } : null;

  // NEIGHBOURHOOD CARDS
  const rawList = await getJson<any>(listUrl);
  const rows:any[] =
    Array.isArray(rawList) ? rawList :
    Array.isArray(rawList?.data) ? rawList.data :
    Array.isArray(rawList?.rows) ? rawList.rows : [];

  neighItems = rows
    .filter((r:any) => {
      if (!visible(r)) return false;
      const slug = get(r,"slug").toLowerCase();
      if (slug === "index") return false;
      return true;
    })
    .map((r:any) => ({
      slug:     get(r,"slug") || slugify(get(r,"title") || get(r,"Title") || get(r,"TITLE")),
      title:    get(r,"title") || get(r,"Title") || get(r,"TITLE"),
      summary:  get(r,"summary") || get(r,"Summary") || get(r,"SUMMARY"),
      hero_img: get(r,"hero_img") || get(r,"heroImg") || get(r,"HeroImg"),
      card_img: get(r,"card_img"),
      sort:     +get(r,"sort") || Number.MAX_SAFE_INTEGER,
    }))
    .filter((r:NeighRow) => r.slug && r.title)
    .sort((a:NeighRow,b:NeighRow) =>
      (Number(a.sort) - Number(b.sort)) || a.title!.localeCompare(b.title!)
    );

} catch (e:any) {
  error = e?.message || "Failed to load data.";
}

/* ---------- header/meta ---------- */
const headerTitle = homeHeader?.title || "Fernie Real Estate";
const headerSummary = homeHeader?.summary || "";
const pageTitle = headerTitle;

/* SEO */
const seoTitle   = homeHeader?.seo_title || pageTitle;
const rawSeoDesc = homeHeader?.seo_description || headerSummary || "";
const seoDesc    = stripMeta(rawSeoDesc);

/* summary html */
const SUMMARY_IS_HTML = true;
const summaryHtml     = SUMMARY_IS_HTML ? stripScripts(headerSummary) : "";

/* HERO IMAGE (now placed UNDER summary) */
const heroImgRaw  = homeHeader?.hero_img || "";
const heroSrc     = heroImgRaw
  ? (isAbs(heroImgRaw) ? heroImgRaw : heroPath(heroImgRaw))
  : heroPath("fallback-hero.jpg");

const heroPreload = { href: heroSrc, imagesizes: "100vw" };

/* header accent (like Browse) */
const headerAccent = CATEGORY_COLOURS.home ?? DEFAULT_ACCENT;

/* ---------- Listings tabs from HOME header (up to 5 CTAs) ---------- */
const tabs: ListingTab[] = [];

if (homeHeader) {
  const candidates = [
    { label: homeHeader.tab1_label || "Tab 1", payload: homeHeader.tab1_block || homeHeader.cta1 || "" },
    { label: homeHeader.tab2_label || "Tab 2", payload: homeHeader.tab2_block || homeHeader.cta2 || "" },
    { label: homeHeader.tab3_label || "Tab 3", payload: homeHeader.tab3_block || homeHeader.cta3 || "" },
    { label: homeHeader.tab4_label || "Tab 4", payload: homeHeader.tab4_block || homeHeader.cta4 || "" },
    { label: homeHeader.tab5_label || "Tab 5", payload: homeHeader.tab5_block || homeHeader.cta5 || "" },
  ];

  candidates.forEach((c, idx) => {
    if (!c.payload) return;
    tabs.push({ id: `tab-${idx + 1}`, label: c.label, payload: c.payload });
  });
}

/* limit neighbourhoods on home; full grid still lives at /neighbourhoods */
const MAX_NEIGH_HOME = 3;
const homeNeighItems = neighItems.slice(0, MAX_NEIGH_HOME);
---

<Site
  title={seoTitle}
  seo_title={seoTitle}
  seo_description={seoDesc}
  wrapContent={false}
  heroPreload={heroPreload}
  class="home"
>
  {/* HERO = Browse-style accent header (NO IMAGE HERE) */}
  <div class="page-shell pad-x home-page">
    <section class="page-intro" style={`--accent:${headerAccent};`}>
      <div class="neigh-title-block">
        <div class="accent-bars" aria-hidden="true">
          <span class="accent-bar primary"></span>
          <span class="accent-bar secondary"></span>
        </div>

        <div class="title-row">
          <h1 class="page-title">{pageTitle}</h1>
        </div>

        {homeHeader?.subhead && <p class="page-subhead">{homeHeader.subhead}</p>}
      </div>
    </section>

    <div class="mountain-strip" aria-hidden="true">
      <svg viewBox="0 0 100 20" preserveAspectRatio="none">
        <defs>
          <linearGradient id="mountainFadeHome" x1="0" x2="0" y1="1" y2="0">
            <stop offset="0" stop-color="rgba(0,0,0,0.06)" />
            <stop offset="1" stop-color="rgba(0,0,0,0)" />
          </linearGradient>
        </defs>
        <path
          d="
            M0 18
            L5 8
            L11 14
            L18 5
            L25 13
            L32 4
            L40 12
            L48 3
            L56 11
            L64 4
            L72 13
            L80 6
            L90 15
            L100 7
            L100 20
            L0 20
            Z
          "
          fill="url(#mountainFadeHome)"
        />
      </svg>
    </div>

    {/* SUMMARY (first) */}
    {headerSummary && (
      <section class="summary-wrap">
        {SUMMARY_IS_HTML
          ? <div class="lead" set:html={summaryHtml}></div>
          : <p class="lead">{headerSummary}</p>}
      </section>
    )}

  {/* RANDOM-ON-LOAD HERO CARD (smart de-dupe) */}
<section class="home-hero-card" aria-label="Start here">
  <div class="hero-card" data-hero-root>

    <div class="hero-card-bars" aria-hidden="true">
      <span class="bar primary"></span>
      <span class="bar secondary"></span>
    </div>

    <div class="hero-variants">

      {/* Neighbourhoods */}
      <article class="hero-variant" data-variant data-spotlight="neigh" style={`--v-accent:${CATEGORY_COLOURS.neighbourhoods ?? DEFAULT_ACCENT};`}>
        <p class="hero-kicker">Start with neighbourhoods</p>
        <h2 class="hero-title">Find your place in Fernie</h2>
        <p class="hero-copy">
          Compare ski hill, valley, and in-town neighbourhoods to understand access,
          day-to-day living, and long-term fit.
        </p>

        <div class="hero-actions">
          <a href="/neighbourhoods" class="hero-btn primary" data-astro-prefetch="hover">Compare neighbourhoods</a>
          <a href="/browse" class="hero-btn ghost" data-astro-prefetch="hover">Search listings</a>
        </div>

        <div class="hero-feature">
          <span class="feature-label">Featured</span>
          <a href="/neighbourhoods/skihill" class="feature-link">Ski Hill Area - layout & access</a>
        </div>
      </article>

      {/* Types */}
      <article class="hero-variant" data-variant data-spotlight="types" style={`--v-accent:${CATEGORY_COLOURS.types ?? DEFAULT_ACCENT};`}>
        <p class="hero-kicker">Start with property type</p>
        <h2 class="hero-title">Homes, condos, townhomes, and lots</h2>
        <p class="hero-copy">
          Narrow the market fast by property type, then refine by neighbourhood once
          you know what you’re optimizing for.
        </p>

        <div class="hero-actions">
          <a href="/types" class="hero-btn primary" data-astro-prefetch="hover">Browse property types</a>
          <a href="/neighbourhoods" class="hero-btn ghost" data-astro-prefetch="hover">Compare areas</a>
        </div>

        <div class="hero-feature">
          <span class="feature-label">Featured</span>
          <a href="/blog" class="feature-link">Which Fernie homes perform best</a>
        </div>
      </article>

      {/* New Listings */}
      <article class="hero-variant" data-variant data-spotlight="new" style={`--v-accent:${CATEGORY_COLOURS.home ?? DEFAULT_ACCENT};`}>
        <p class="hero-kicker">What’s new</p>
        <h2 class="hero-title">Latest Fernie listings</h2>
        <p class="hero-copy">
          See the newest homes and condos as they hit the market,
          updated automatically across all neighbourhoods.
        </p>

        <div class="hero-actions">
          <a href="/types/new-listings-fernie/" class="hero-btn primary">View new listings</a>
          <a href="/browse" class="hero-btn ghost">Open full search</a>
        </div>

        <div class="hero-feature">
          <span class="feature-label">Featured</span>
          <a href="/living" class="feature-link">Seasonality & buying timing</a>
        </div>
      </article>

      {/* Home Match */}
      <article class="hero-variant" data-variant data-spotlight="match" style={`--v-accent:${CATEGORY_COLOURS.blog ?? DEFAULT_ACCENT};`}>
        <p class="hero-kicker">Not sure where to start?</p>
        <h2 class="hero-title">Get matched to the right homes</h2>
        <p class="hero-copy">
          Share your budget, timing, and must-haves and get a curated shortlist —
          including smart alternatives you may not have found.
        </p>

        <div class="hero-actions">
          <a href="/home-match/" class="hero-btn primary">Get matched</a>
          <a href="/browse" class="hero-btn ghost">Browse listings</a>
        </div>

        <div class="hero-feature">
          <span class="feature-label">Featured</span>
          <a href="/living" class="feature-link">Living in Fernie - daily essentials</a>
        </div>
      </article>

    </div>
  </div>

  <script is:inline>
(() => {
  function initHero() {
    const root = document.querySelector("[data-hero-root]");
    if (!root) return;

    const variants = Array.from(root.querySelectorAll("[data-variant]"));
    if (!variants.length) return;

    const pick = Math.floor(Math.random() * variants.length);
    const active = variants[pick];

    variants.forEach(v => v.classList.remove("is-active"));
    active.classList.add("is-active");

    const accent = getComputedStyle(active).getPropertyValue("--v-accent").trim();
    if (accent) root.style.setProperty("--active-accent", accent);

    const spotlight = active.getAttribute("data-spotlight");
    if (spotlight) {
      document.documentElement.setAttribute("data-hero-spotlight", spotlight);
    }
  }

  // Initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHero, { once: true });
  } else {
    initHero();
  }

  // Astro soft navigation
  document.addEventListener("astro:page-load", initHero);

  // ✅ Back / forward cache restore
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) initHero();
  });
})();
</script>

</section>



    {/* intro block: 4 feature cards */}
    <section class="home-intro">
      <section class="hub home-hub">
        <div class="hub-grid">
          <a href="/neighbourhoods" class="hub-card" data-hub="neigh" data-astro-prefetch="hover">
            <div class="hub-card-inner">
              <div class="hub-icon">🗺️</div>
              <h2 class="hub-title">Neighbourhoods in Fernie</h2>
            
              <span class="hub-cta">Browse neighbourhoods</span>
            </div>
          </a>

          <a href="/types" class="hub-card" data-hub="types" data-astro-prefetch="hover">
            <div class="hub-card-inner">
              <div class="hub-icon">🏘️</div>
              <h2 class="hub-title">Homes &amp; Property Types</h2>
            
              <span class="hub-cta">Browse homes &amp; types</span>
            </div>
          </a>

          <a href="/types/new-listings-fernie/" class="hub-card" data-hub="new">
            <div class="hub-card-inner">
              <div class="hub-icon">🆕</div>
              <h2 class="hub-title">Latest Fernie Listings</h2>
             
              <span class="hub-cta">View latest listings</span>
            </div>
          </a>

          <a href="/home-match/" class="hub-card" data-hub="match" data-astro-prefetch="hover">
            <div class="hub-card-inner">
              <div class="hub-icon">🎯</div>
              <h2 class="hub-title">Home Match</h2>
             
              <span class="hub-cta">Get matched</span>
            </div>
          </a>

          <a href="/browse" class="hub-card hub-card--fallback" data-hub="fallback" data-astro-prefetch="hover">
  <div class="hub-card-inner">
    <div class="hub-icon">🔎</div>
    <h2 class="hub-title">Search Fernie Listings</h2>
   
    <span class="hub-cta">Open full search</span>
  </div>
</a>

        </div>
      </section>
    </section>

    {/* LISTINGS with tabs */}
    <section class="listings-section" id="home-listings">
      <div class="listings-head">
        <h2>Fernie Listings</h2>
        <a class="listings-link" href="/browse" data-astro-prefetch="hover">
          Open full search →
        </a>
      </div>

      {error ? (
        <p class="err">{error}</p>
      ) : tabs.length > 0 ? (
        <div class="listing-wrap listing-wrap--tabs">
          <div class="listing-tabs" role="tablist" aria-label="Listing sets">
            {tabs.map((tab, idx) => (
              <button
                type="button"
                class={`listing-tab ${idx === 0 ? "is-active" : ""}`}
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
                data-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>

          <div class="listing-panels">
            {tabs.map((tab, idx) => (
              <div
                class={`listing-panel ${idx === 0 ? "is-active" : ""}`}
                role="tabpanel"
                data-panel={tab.id}
                aria-hidden={idx === 0 ? "false" : "true"}
              >
                <div class="rv-host">
                  {
                    /[<>]/.test(tab.payload)
                      ? <Fragment set:html={tab.payload}></Fragment>
                      : <div data-rv-block={tab.payload}></div>
                  }
                </div>
              </div>
            ))}
          </div>

          {/* RealtyVis re-init on Astro soft nav + tab changes */}
          <script is:inline>
            (() => {
              const SRC = "https://cdn.realtyvis.com/js/embed.js";

              function ensureEmbedScript() {
                return new Promise((resolve) => {
                  let s = document.querySelector(`script[src="${SRC}"]`);
                  if (s && s.dataset.loaded === "1") return resolve(true);

                  if (!s) {
                    s = document.createElement("script");
                    s.src = SRC;
                    s.defer = true;
                    s.async = true;
                    document.head.appendChild(s);
                  }

                  s.addEventListener("load", () => { s.dataset.loaded = "1"; resolve(true); }, { once: true });
                  s.addEventListener("error", () => resolve(false), { once: true });
                });
              }

              async function kickRealtyVis() {
                const blocks = document.querySelectorAll("[data-rv-block]");
                if (!blocks.length) return;

                await ensureEmbedScript();

                blocks.forEach((el) => {
                  if (el.querySelector("iframe")) return;
                  const clone = el.cloneNode(false);
                  el.parentNode && el.parentNode.replaceChild(clone, el);
                });
              }

              // initial
              if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", kickRealtyVis, { once: true });
              } else {
                kickRealtyVis();
              }

              // Astro transitions
              document.addEventListener("astro:page-load", kickRealtyVis);

              // Your tabs - after switching panels, re-kick
              document.addEventListener("click", (e) => {
                const btn = e.target && e.target.closest && e.target.closest(".listing-tab");
                if (!btn) return;
                setTimeout(kickRealtyVis, 80);
              });

              // bfcache restore
              window.addEventListener("pageshow", () => setTimeout(kickRealtyVis, 80));
            })();
          </script>

          {/* optional warm-up (kept) */}
          <script is:inline>
            (function () {
              var warmed = false;
              function warm() {
                if (warmed) return; warmed = true;
                new Image().src = "https://app.realtyvis.com/favicon.ico";
                new Image().src = "https://cdn.realtyvis.com/favicon.ico";
                try {
                  fetch("https://app.realtyvis.com/css/site.min.css", { mode: "no-cors" }).catch(function(){});
                  fetch("https://app.realtyvis.com/js/site.min.js", { mode: "no-cors" }).catch(function(){});
                } catch (e) {}
              }
              var hosts = document.querySelectorAll(".listing-wrap--tabs, .rv-host");
              ["pointerover","touchstart","focusin"].forEach(function (ev) {
                hosts.forEach(function (host) {
                  host.addEventListener(ev, warm, { once: true, passive: true });
                });
              });
            })();
          </script>
        </div>
      ) : homeHeader?.cta1 ? (
        <div class="listing-wrap">
          <div class="rv-host">
            {
              /[<>]/.test(homeHeader.cta1)
                ? <Fragment set:html={homeHeader.cta1}></Fragment>
                : <div data-rv-block={homeHeader.cta1}></div>
            }
          </div>

          {/* also kick for the single-block case */}
          <script is:inline>
            (() => {
              const SRC = "https://cdn.realtyvis.com/js/embed.js";

              function ensureEmbedScript() {
                return new Promise((resolve) => {
                  let s = document.querySelector(`script[src="${SRC}"]`);
                  if (s && s.dataset.loaded === "1") return resolve(true);

                  if (!s) {
                    s = document.createElement("script");
                    s.src = SRC;
                    s.defer = true;
                    s.async = true;
                    document.head.appendChild(s);
                  }

                  s.addEventListener("load", () => { s.dataset.loaded = "1"; resolve(true); }, { once: true });
                  s.addEventListener("error", () => resolve(false), { once: true });
                });
              }

              async function kickRealtyVis() {
                const blocks = document.querySelectorAll("[data-rv-block]");
                if (!blocks.length) return;

                await ensureEmbedScript();

                blocks.forEach((el) => {
                  if (el.querySelector("iframe")) return;
                  const clone = el.cloneNode(false);
                  el.parentNode && el.parentNode.replaceChild(clone, el);
                });
              }

              if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", kickRealtyVis, { once: true });
              } else {
                kickRealtyVis();
              }

              document.addEventListener("astro:page-load", kickRealtyVis);
              window.addEventListener("pageshow", () => setTimeout(kickRealtyVis, 80));
            })();
          </script>
        </div>
      ) : (
        <p class="muted">
          Add RealtyVis block IDs (in the <code>category</code> column) to extra HOME rows to power the listings tabs.
        </p>
      )}
    </section>

    {/* NEIGHBOURHOOD CARDS */}
    {homeNeighItems.length > 0 && (
      <section class="neigh-section" id="neighbourhoodsGrid">
        <div class="neigh-head">
          <h2>Fernie Neighbourhoods</h2>
          <a href="/neighbourhoods" data-astro-prefetch="hover" class="neigh-link">
            View all neighbourhoods →
          </a>
        </div>

        <div class="posts-grid">
          {homeNeighItems.map((it) => {
            const raw = pick(it.card_img || "", it.hero_img || "");
            const img = raw ? (isAbs(raw) ? raw : heroPath(raw)) : "";

            return (
              <a class="post-card" href={`${PATH_BASE_NEIGH}/${it.slug}`} data-astro-prefetch="hover" aria-label={it.title}>
                {img && (
                  <div class="pc-media">
                    <img src={img} alt={it.title} loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="pc-body">
                  <div class="pc-meta">
                    <span class="pc-pill">neighbourhood</span>
                  </div>
                  <h3 class="pc-title">{it.title}</h3>
                  {it.summary && <p class="pc-excerpt">{excerpt(it.summary,240)}</p>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>

  <script>
    function enhanceScrollAndTabs() {
      const tabs   = Array.from(document.querySelectorAll(".listing-tab"));
      const panels = Array.from(document.querySelectorAll(".listing-panel"));

      function setActiveTabById(id) {
        if (!id || !tabs.length || !panels.length) return;

        tabs.forEach((t) => {
          const active = t.getAttribute("data-tab") === id;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });

        panels.forEach((p) => {
          const match = p.getAttribute("data-panel") === id;
          p.classList.toggle("is-active", match);
          p.setAttribute("aria-hidden", match ? "false" : "true");
          if (match) p.removeAttribute("hidden");
          else p.setAttribute("hidden", "true");
        });
      }

      if (!tabs.length || !panels.length) return;

      tabs.forEach((tab) => {
        tab.addEventListener(
          "click",
          () => {
            const id = tab.getAttribute("data-tab");
            setActiveTabById(id);
          },
          { passive: true }
        );
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", enhanceScrollAndTabs, { once: true });
    } else {
      enhanceScrollAndTabs();
    }

    window.addEventListener("pageshow", (e) => {
      if (e.persisted) enhanceScrollAndTabs();
    });
  </script>

